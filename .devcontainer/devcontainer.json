{
  "name": "HoBo agent tooling",
  "init": true,
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1.0.14": {},
    "ghcr.io/devcontainers/features/docker-in-docker:2.12.0": {},
    "ghcr.io/devcontainers/features/python:1.7.0": {
      "version": "3.12",
      "installTools": true
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.vscode-typescript-next",
        "GitHub.copilot",
        "ast-grep.ast-grep-vscode"
      ]
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/.tools/ci:${containerEnv:PATH}",
    "HOBO_CI_LOCAL_RUNNER": "${localEnv:HOBO_CI_LOCAL_RUNNER}",
    "HOBO_CI_LOCAL_REPOSITORY": "${localEnv:HOBO_CI_LOCAL_REPOSITORY}",
    "HOBO_CI_LOCAL_TRUSTED": "${localEnv:HOBO_CI_LOCAL_TRUSTED}"
  },
  "remoteUser": "node"
}
