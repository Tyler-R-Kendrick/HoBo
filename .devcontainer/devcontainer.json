{
  "name": "HoBo agent tooling",
  "init": true,
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.vscode-typescript-next",
        "GitHub.copilot",
        "ast-grep.ast-grep-vscode"
      ]
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "remoteEnv": {
    "PATH": "${containerEnv:HOME}/.local/bin:${containerWorkspaceFolder}/.tools/ci:${containerEnv:PATH}",
    "MISE_TRUSTED_CONFIG_PATHS": "${containerWorkspaceFolder}:${containerEnv:HOME}/.hobo-dotfiles",
    "HOBO_CI_LOCAL_RUNNER": "${localEnv:HOBO_CI_LOCAL_RUNNER}",
    "HOBO_CI_LOCAL_REPOSITORY": "${localEnv:HOBO_CI_LOCAL_REPOSITORY}",
    "HOBO_CI_LOCAL_TRUSTED": "${localEnv:HOBO_CI_LOCAL_TRUSTED}"
  },
  "remoteUser": "node"
}
