# Agent-tooling environment. Copy to `.env` and fill in only for tools/backends
# that you explicitly enable. `.env` is gitignored.
# Standing key/egress table: AUTH.md. Setup flags: bash scripts/setup-agent-tools.sh --help
# None of these are needed for Serena, headroom, improve, ponytail, or caveman.

# gbrain embedding/query provider — pick ONE. gbrain sends the text it embeds
# and your queries to whichever provider you set (recurring API cost + data egress).
OPENAI_API_KEY=
# ZEROENTROPY_API_KEY=
# VOYAGE_API_KEY=

# SkillOpt / SkillOpt-Sleep live backends. The default mock backend needs no key.
# Set only the providers you intentionally use for offline training/replay.
# ANTHROPIC_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=
# QWEN_CHAT_BASE_URL=
# QWEN_CHAT_API_KEY=
# MINIMAX_API_KEY=

# caveman: set to 0 to silence the "tokens saved" statusline badge.
# CAVEMAN_STATUSLINE_SAVINGS=0

# superpowers: set to 1 to disable its telemetry.
# SUPERPOWERS_DISABLE_TELEMETRY=1

# Examples Temporary — zero project API keys (no E2B_API_KEY / permanent CF token).
# OpenSaaS Temporary: Neon Claimable db + OpenPouch one-shot → CF Neon shim + CF Temporary client.
# HOBO_OPENSAAS_DB_MOCK=1
# HOBO_OPENSAAS_SERVER_MOCK=1
# OpenSaaS anon server host: auto (OpenPouch one-shot → CF Neon shim) | cloudflare | openpouch
# HOBO_OPENSAAS_SERVER_HOST=auto
# Optional path for OpenPouch 429 cooldown JSON (default $TMPDIR/hobo-openpouch-cooldown.json)
# HOBO_OPENPOUCH_COOLDOWN_FILE=
# Convex swaghaus OCI/binary self-host is fail-closed under zero keys; mock for CI.
# HOBO_CONVEX_SWAGHAUS_MOCK=1
# HOBO_CONVEX_OCI_HOST=cloudflare
# HOBO_CONVEX_ANON_LIVE=1
# HOBO_CONVEX_ALLOW_CLOUD=1
