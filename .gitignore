# Secrets / local env
.env
.env.local

# Agent-tool local state (machine-specific; do NOT commit)
.gbrain/
*.pglite
.headroom/
.caveman/

# Node / tooling
node_modules/

# Logs / OS cruft
*.log
.tmp/
.DS_Store

# NOTE: committed on purpose so clones get the tooling wired up —
#   .mcp.json, .cursor/, .codex/, .claude/skills/, .agents/skills/,
#   AGENTS.md, CLAUDE.md, skills-lock.json
.agents/vendor/

# Turborepo local cache
.turbo/

# Package build output
dist/

# Isolated-wasm intermediates (esbuild bundles / componentize outputs).
# Cached under $HOBO_HOME/sandboxes by default — never commit guest.wasm.
**/*.guest.mjs
**/*-wasm-entry.mjs
sandboxes/

# Pinned toolchain binaries downloaded on demand (e.g. CUE v0.14.0)
.tools/
# Local yard/broker tooling installs (prefer $HOBO_HOME; belt-and-suspenders)
.hobo/

# CI fixture runner append-only event logs (local + CI artifacts)
test-results/
