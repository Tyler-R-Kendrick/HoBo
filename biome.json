{
	"$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",
	"files": {
		"includes": [
			"packages/**",
			"scripts/**",
			"test/**",
			"!test/output/**",
			"!**/dist/**",
			"!**/node_modules/**",
			"!**/generated/**",
			"!**/_generated/**",
			"!**/.hobo/**",
			"!**/*.snap",
			"!**/*.json"
		]
	},
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": false
	},
	"overrides": [
		{
			"includes": ["packages/**", "!packages/**/dist/**"],
			"linter": {
				"enabled": true,
				"rules": {
					"suspicious": {
						"noTemplateCurlyInString": "off"
					}
				}
			}
		},
		{
			"includes": ["packages/pixel-village/public/index.html"],
			"linter": {
				"rules": {
					"a11y": {
						"noNoninteractiveTabindex": "off"
					}
				}
			}
		},
		{
			"includes": ["packages/code/src/tui-components.tsx"],
			"linter": {
				"rules": {
					"a11y": "off",
					"correctness": {
						"noUnusedImports": "off"
					}
				}
			}
		}
	]
}
