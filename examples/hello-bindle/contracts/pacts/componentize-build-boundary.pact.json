{
  "consumer": { "name": "HelloBindleExample" },
  "provider": { "name": "ComponentizeBuildBoundary" },
  "interactions": [
    {
      "description": "build hello-bindle as a deterministic wasm component and OCI descriptor",
      "request": { "method": "POST", "path": "/componentize/hello-bindle" },
      "response": {
        "status": 200,
        "body": {
          "validation": { "passed": true },
          "smoke": { "exitCode": 0 },
          "oci": { "mediaType": "application/vnd.oci.image.manifest.v1+json" }
        }
      }
    },
    {
      "description": "sign hello-bindle component artifact",
      "request": { "method": "POST", "path": "/componentize/hello-bindle/sign" },
      "response": {
        "status": 200,
        "body": {
          "signature": { "alg": "Ed25519" },
          "provenanceTier": "slsa-build-l3"
        }
      }
    },
    {
      "description": "reject tampered component digest",
      "request": { "method": "POST", "path": "/componentize/hello-bindle/sign" },
      "response": {
        "status": 400,
        "body": {
          "error": { "code": "componentize.digest_mismatch" }
        }
      }
    }
  ],
  "metadata": { "pactSpecification": { "version": "3.0.0" } }
}
