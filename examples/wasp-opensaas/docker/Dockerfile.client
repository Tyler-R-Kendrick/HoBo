# Static client from `wasp build` web-app output.
FROM node:22-bookworm-slim AS wasp-build
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && curl -sSL https://get.wasp-lang.dev/installer.sh | sh
ENV PATH="/root/.local/bin:${PATH}"
COPY package.json package-lock.json ./
COPY . .
RUN wasp build
ARG REACT_APP_API_URL=http://127.0.0.1:3001
WORKDIR /app/.wasp/build/web-app
RUN npm install && REACT_APP_API_URL=${REACT_APP_API_URL} npm run build

FROM nginx:1.27-alpine
COPY --from=wasp-build /app/.wasp/build/web-app/build /usr/share/nginx/html
EXPOSE 80
