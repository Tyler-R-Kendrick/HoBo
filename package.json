{
	"name": "hobo-design",
	"license": "MIT",
	"private": true,
	"type": "module",
	"scripts": {
		"actions:lint": "node --import tsx scripts/lint-actions.ts",
		"agent:check": "node --experimental-strip-types scripts/dx-preflight.mts agent:check",
		"architecture:guard": "node scripts/check-architecture-guardrails.mjs",
		"architecture:guard:all": "node scripts/check-architecture-guardrails.mjs --all",
		"architecture:guard:staged": "node scripts/check-architecture-guardrails.mjs --staged",
		"build": "turbo run build --filter \"./packages/**\" --concurrency=100%",
		"build:packages": "pnpm run lint:boundaries && turbo run build --filter \"./packages/*\" --concurrency=100%",
		"case:check": "node --import tsx scripts/check-case-collisions.ts",
		"check:all": "pnpm run lint:boundaries && pnpm run architecture:guard:all && pnpm run konsistent && pnpm run lint:docs && pnpm run design:lint && pnpm run draft:artifacts && pnpm run draft:cascade && pnpm run skills:mirror-check && pnpm run promotions:check && pnpm run case:check && pnpm run test:schema && pnpm run test:unit && pnpm run test:behavior && pnpm run standards:check && pnpm run licenses:check && pnpm run docs:coverage && pnpm run docs:freshness",
		"check:changed": "node --experimental-strip-types scripts/dx-preflight.mts agent:check",
		"check:changed:build": "node --experimental-strip-types scripts/dx-preflight.mts agent:check --build",
		"check:relevant": "node --experimental-strip-types scripts/dx-preflight.mts agent:check",
		"check:relevant:staged": "node --experimental-strip-types scripts/dx-preflight.mts agent:check --staged",
		"ci:preflight": "node --import tsx scripts/ci-preflight.ts",
		"codegen": "node --import tsx packages/schema-tools/src/cli.ts",
		"codegen:check": "node --import tsx packages/schema-tools/src/cli.ts --check",
		"design:lint": "node --import tsx scripts/check-design-md.mts",
		"docs:cli-lint": "node --import tsx scripts/check-cli-docs.ts",
		"docs:competitors": "node --import tsx scripts/check-competitor-docs.ts",
		"docs:competitors:fix": "node --import tsx scripts/check-competitor-docs.ts --fix",
		"docs:coverage": "node --import tsx scripts/check-docs-coverage.ts",
		"docs:design-lint": "node --import tsx scripts/check-design-docs.ts",
		"docs:freshness": "node --import tsx scripts/check-docs-freshness.ts",
		"docs:freshness:staged": "node --import tsx scripts/check-docs-freshness.ts --staged",
		"docs:okf": "node --import tsx scripts/check-okf-docs.mts",
		"docs:register-check": "node --import tsx scripts/check-gaps-register-lag.ts",
		"docs:site-nav": "node --import tsx scripts/check-site-nav.mts",
		"doctor": "node --experimental-strip-types scripts/dx-preflight.mts doctor",
		"draft:artifacts": "node --import tsx scripts/check-draft-artifacts.ts",
		"draft:artifacts:staged": "node --import tsx scripts/check-draft-artifacts.ts --staged",
		"draft:cascade": "node --import tsx scripts/check-proof-cascade.ts",
		"draft:cascade:staged": "node --import tsx scripts/check-proof-cascade.ts --staged",
		"eval:agent": "pnpm run eval:agent:mock",
		"eval:agent:live": "node --import tsx scripts/run-tests.ts --category=agent-live",
		"eval:agent:mock": "node --import tsx scripts/run-tests.ts --category=agent-mock",
		"fetch:pr-base": "node --import tsx scripts/fetch-pr-base.ts",
		"gate:s1": "pnpm --prefix src/draft/technical-proofs/s1-stage-gate run gate:s1",
		"generated:guard": "node --import tsx scripts/no-hand-edited-generated-files.mts",
		"hobo": "node --import tsx scripts/hobo-cli.ts",
		"install:check": "pnpm install --frozen-lockfile --config.confirmModulesPurge=false",
		"konsistent": "konsistent",
		"licenses:check": "node --import tsx scripts/check-licenses.ts",
		"lint": "pnpm run lint:docs",
		"lint:boundaries": "node --import tsx scripts/check-package-boundaries.mts",
		"lint:code": "biome format scripts/ test/",
		"lint:code:fix": "biome format --write scripts/ test/",
		"lint:docs": "node --import tsx scripts/run-linters.ts --all",
		"lint:docs:changed": "node --import tsx scripts/run-linters.ts",
		"lint:docs:staged": "node --import tsx scripts/run-linters.ts --staged",
		"optimizexp:check": "node --import tsx scripts/check-optimizexp.mts",
		"optimizexp:lint-runs": "node --import tsx .agents/skills/optimizexp/harness/lint-runs.mts --all",
		"prepare": "node --import tsx scripts/install-hooks.mts",
		"prepare-hooks": "git config core.hooksPath .githooks",
		"promotions:check": "node --import tsx scripts/check-promoted-proof-drift.mts",
		"search": "node --import tsx scripts/search.mts",
		"search:structure": "ast-grep scan",
		"setup": "corepack enable pnpm && pnpm run install:check",
		"ship:gap-closure": "node --import tsx scripts/check-ship-gap-closure.mts",
		"site:deploy": "node --import tsx scripts/deploy-site.mts",
		"skills:mirror-check": "node --import tsx scripts/check-skill-mirrors.ts",
		"staging:cutover": "node --import tsx scripts/staging-cutover-demo.mts",
		"standards:check": "node --import tsx scripts/check-technical-standards.ts",
		"test": "pnpm run test:unit",
		"test:affected": "turbo run test --affected --continue=never --concurrency=100%",
		"test:all": "pnpm exec turbo run test --concurrency=100%",
		"test:behavior": "node --import tsx node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.yaml",
		"test:changed": "node --import tsx scripts/run-changed-tests.mts",
		"test:component": "node --import tsx scripts/run-tests.ts --category=component",
		"test:contract": "pnpm run test:contract:consumer && pnpm run test:contract:provider",
		"test:contract:consumer": "node --import tsx scripts/run-tests.ts --category=contract-consumer && pnpm exec turbo run test:contract:consumer --filter \"./packages/*\" --concurrency=100%",
		"test:contract:provider": "node --import tsx scripts/run-tests.ts --category=contract-provider && pnpm exec turbo run test:contract:provider --filter \"./packages/*\" --concurrency=100%",
		"test:coverage": "vitest run --config vitest.coverage.config.ts",
		"test:dom": "node --import tsx scripts/run-tests.ts --category=dom",
		"test:fast": "node --import tsx scripts/run-tests.ts --root-only --quiet --no-artifacts",
		"test:file": "vitest run --no-isolate --passWithNoTests",
		"test:fuzz": "pnpm --filter @hobo/fuzz run test:fuzz",
		"test:fuzz:nightly": "pnpm --filter @hobo/fuzz run test:fuzz:nightly",
		"test:mutation": "pnpm --filter @hobo/core exec stryker run",
		"test:name": "vitest run --no-isolate --passWithNoTests -t",
		"test:property": "pnpm --filter @hobo/fuzz run test:property",
		"test:root": "node --import tsx scripts/run-tests.ts --root-only",
		"test:schema": "node --import tsx scripts/validate-sdk-contracts.ts && node --import tsx scripts/validate-deployment-set-delta.ts && node --import tsx scripts/check-cue-schemas.ts && node --import tsx packages/schema-tools/src/cli.ts --check && pnpm --filter @hobo/bindles run test:schema",
		"test:scripts": "node --import tsx --test \"scripts/test/*.test.ts\"",
		"test:ship-gap-closure": "node --import tsx --test scripts/test/check-ship-gap-closure.test.ts",
		"test:smoke": "vitest run --no-isolate --passWithNoTests",
		"test:types": "node --import tsx scripts/run-tests.ts --category=types",
		"pretest:unit": "turbo run build --filter \"./packages/**\" --filter \"./src/draft/**\" --concurrency=100%",
		"test:unit": "node --import tsx scripts/run-tests.ts --category=unit",
		"test:unit:quiet": "node --import tsx scripts/run-tests.ts --category=unit --quiet --no-artifacts",
		"test:visual": "node --import tsx scripts/run-tests.ts --category=visual",
		"typecheck": "turbo run typecheck --filter \"./packages/*\" --concurrency=100%",
		"typecheck:root": "tsc -p tsconfig.json",
		"validate:final": "pnpm run standards:check -- --base=origin/main && node --import tsx scripts/run-tests.ts --final",
		"validate:local": "node --import tsx scripts/validate-local.mts",
		"lint:budget": "node --experimental-strip-types scripts/check-biome-budget.mts"
	},
	"devDependencies": {
		"@ast-grep/cli": "^0.44.0",
		"@biomejs/biome": "^2.5.2",
		"@bufbuild/buf": "1.71.0",
		"@bufbuild/protoc-gen-es": "2.12.1",
		"@changesets/cli": "^2.31.0",
		"@cucumber/cucumber": "^13.0.0",
		"@google/design.md": "^0.4.0",
		"@stryker-mutator/core": "^10.0.0",
		"@stryker-mutator/vitest-runner": "^10.0.0",
		"@types/node": "^24.13.2",
		"@types/pngjs": "^6.0.5",
		"@typescript/native-preview": "^7.0.0-dev.20260629.1",
		"@vitest/coverage-v8": "^4.1.10",
		"konsistent": "1.0.0-beta.1",
		"pixelmatch": "^7.2.0",
		"playwright": "^1.62.1",
		"pngjs": "^7.0.0",
		"protobufjs": "^7.6.4",
		"tsx": "^4.22.4",
		"turbo": "2.8.6",
		"typescript": "^6.0.3",
		"vitest": "^4.1.9",
		"zod": "^4.1.13"
	},
	"engines": {
		"node": ">=22"
	},
	"pnpm": {
		"overrides": {
			"ts-autocode-grounding": "workspace:*",
			"ts-autocode-harness": "workspace:*",
			"ts-autocode-rewrite": "workspace:*",
			"ts-autocode-training": "workspace:*"
		},
		"supportedArchitectures": {
			"os": [
				"current"
			],
			"cpu": [
				"arm64",
				"x64",
				"current"
			]
		}
	},
	"packageManager": "pnpm@10.33.4"
}
