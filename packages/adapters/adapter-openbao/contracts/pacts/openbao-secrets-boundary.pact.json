{
	"consumer": {
		"name": "@hobo/identity"
	},
	"provider": {
		"name": "@hobo/adapter-openbao"
	},
	"interactions": [
		{
			"description": "offline residual SecretsPort access returns openbao:// valueRef without embedding material",
			"request": {
				"method": "POST",
				"path": "/secrets/access",
				"headers": {
					"content-type": "application/json"
				},
				"body": {
					"name": "app/db",
					"mode": "offline",
					"kind": "openbao"
				}
			},
			"response": {
				"status": 200,
				"headers": {
					"content-type": "application/json"
				},
				"body": {
					"status": "ok",
					"source": "provider-federation",
					"valueRef": "openbao://http://127.0.0.1:8200/secret/app/db@ob-dynamic",
					"versionId": "ob-dynamic",
					"kind": "openbao"
				}
			}
		},
		{
			"description": "live residual path uses JWT login then KV v2 get (no long-lived root token)",
			"request": {
				"method": "POST",
				"path": "/v1/auth/jwt/login",
				"headers": {
					"content-type": "application/json"
				},
				"body": {
					"role": "hobo-workload",
					"jwt": "eyJhbGciOiJFUzI1NiJ9.svid.fixture"
				}
			},
			"response": {
				"status": 200,
				"headers": {
					"content-type": "application/json"
				},
				"body": {
					"auth": {
						"client_token": "s.short-lived",
						"lease_duration": 600
					}
				}
			}
		}
	],
	"metadata": {
		"pactSpecification": {
			"version": "3.0.0"
		}
	}
}
