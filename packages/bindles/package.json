{
	"name": "@hobo/bindles",
	"version": "0.0.1",
	"type": "module",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./wiring": {
			"types": "./dist/wiring/index.d.ts",
			"default": "./dist/wiring/index.js"
		},
		"./topology": {
			"types": "./dist/topology/index.d.ts",
			"default": "./dist/topology/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@hobo/core": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^22.15.29"
	},
	"scripts": {
		"prebuild": "pnpm --filter @hobo/core build",
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"typecheck:types": "tsc --noEmit -p tsconfig.types.json",
		"lint": "biome check .",
		"test": "pnpm run build && vitest run --exclude test/manifest/cue-gate.test.ts",
		"test:schema": "vitest run test/manifest"
	}
}
