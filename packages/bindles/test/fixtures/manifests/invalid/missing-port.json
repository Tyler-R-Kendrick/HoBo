{
  "schema": "hobo.manifest/v1",
  "componentHost": {
    "kind": "wasmtime",
    "version": "1.0.0"
  },
  "resources": {
    "db": {
      "type": "data.v1",
      "paradigm": "relational",
      "allow": ["query"]
    },
    "api": {
      "type": "component.v1",
      "image": "oci://registry.example.com/api@sha256:abc123",
      "runtime": "wasm",
      "exports": ["wasi:http/incoming-handler"],
      "links": [{ "import": "hobo:data", "to": "db" }],
      "env": {
        "LOG_LEVEL": "info"
      }
    },
    "site": {
      "type": "website.v1",
      "bind": ["api"]
    }
  }
}
