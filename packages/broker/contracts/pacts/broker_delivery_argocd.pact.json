{
	"consumer": {
		"name": "HoboBrokerDeliveryPlaneConsumer"
	},
	"provider": {
		"name": "ArgoCdApplicationsBoundary"
	},
	"interactions": [
		{
			"description": "An accepted receipt is submitted as an Argo CD Application",
			"request": {
				"method": "POST",
				"path": "/api/v1/applications",
				"headers": {
					"content-type": "application/json"
				},
				"body": {
					"apiVersion": "argoproj.io/v1alpha1",
					"kind": "Application",
					"metadata": {
						"name": "hobo-req-checkout-1"
					},
					"spec": {
						"project": "hobo",
						"source": {
							"repoURL": "https://git.example/hobo-receipts",
							"path": "receipts/req-checkout-1"
						},
						"destination": {
							"namespace": "hobo-prod"
						}
					}
				}
			},
			"response": {
				"status": 200,
				"body": {
					"metadata": { "name": "hobo-req-checkout-1" },
					"status": { "sync": { "status": "OutOfSync" } }
				}
			}
		},
		{
			"description": "A rejected submission fails closed with delivery-rejected",
			"request": {
				"method": "POST",
				"path": "/api/v1/applications",
				"headers": {
					"content-type": "application/json"
				},
				"body": {
					"apiVersion": "argoproj.io/v1alpha1",
					"kind": "Application",
					"metadata": {
						"name": "hobo-req-checkout-2"
					}
				}
			},
			"response": {
				"status": 403,
				"body": {
					"expectedErrorCode": "delivery-rejected"
				}
			}
		}
	],
	"metadata": {
		"pactSpecification": {
			"version": "3.0.0"
		}
	}
}
