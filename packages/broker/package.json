{
	"name": "@hobo/broker",
	"version": "0.0.1",
	"license": "MIT",
	"type": "module",
	"private": true,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"pretest": "node --experimental-strip-types ../../scripts/ensure-built.mts",
		"test": "vitest run",
		"test:contract:consumer": "vitest run contracts/consumer",
		"test:contract:provider": "vitest run contracts/provider"
	},
	"dependencies": {
		"@bufbuild/protobuf": "2.12.1",
		"@hobo/contracts": "workspace:*",
		"@hobo/core": "workspace:*",
		"@hobo/provider-cedar": "workspace:*",
		"@hobo/provider-opa": "workspace:*",
		"pg": "8.22.0"
	},
	"devDependencies": {
		"@types/node": "^22.15.29",
		"@types/pg": "8.15.5",
		"vitest": "^4.1.9",
		"@hobo/storage-sqlite": "workspace:*"
	},
	"description": "The HoBo Broker: policy-governed brokering of Bindle/Camp/Yard/Junction placements across providers, wrapping the policy (OPA-shaped), contract (Gatekeeper/PACT), billing, delivery (Argo-shaped), and connector-registry planes."
}
