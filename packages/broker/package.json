{
	"name": "@hobo/broker",
	"version": "0.0.1",
	"type": "module",
	"private": true,
	"files": ["dist"],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "pnpm --filter @hobo/contracts build && tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"pretest": "pnpm run build",
		"test": "vitest run",
		"test:contract:consumer": "vitest run contracts/consumer"
	},
	"dependencies": {
		"@hobo/contracts": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^22.15.29",
		"vitest": "^4.1.9"
	},
	"description": "The HoBo Broker: policy-governed brokering of Bindle/Camp/Yard/Junction placements across providers, wrapping the policy (OPA-shaped), contract (Gatekeeper/PACT), billing, delivery (Argo-shaped), and connector-registry planes."
}
