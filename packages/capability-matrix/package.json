{
	"name": "@hobo/capability-matrix",
	"version": "0.0.1",
	"license": "MIT",
	"description": "HoBo capability matrix: the derived Bindle primitive x runtime coverage view, generated from registered Resource Definitions, packs, bridges, substrates, sponsor fallbacks and trust evidence — never a hand-curated table.",
	"type": "module",
	"files": [
		"LICENSE",
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@hobo/capability-profiles": "workspace:*",
		"@hobo/trust": "workspace:*"
	},
	"devDependencies": {
		"@hobo/cloud": "workspace:*",
		"@types/node": "^22.15.29",
		"vitest": "^4.1.9"
	},
	"scripts": {
		"prebuild": "pnpm --filter @hobo/capability-profiles build && pnpm --filter @hobo/trust build",
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"pretest": "pnpm run build",
		"test": "vitest run test/",
		"test:unit": "vitest run test/"
	}
}
