# Hard gates — each line is one rule, and the whole rejection list is asserted.
{"method":"select","name":"selects a conformant candidate","input":[{"candidates":[{"definitionId":"neon.claimable-postgres/v1"}]}],"subset":{"winner":"neon.claimable-postgres/v1","rejections":[]}}
{"method":"select","name":"never lets a relational-only product satisfy a postgres requirement","input":[{"candidates":[{"definitionId":"cloudflare.temporary-d1/v1","profiles":["data.sqlite/v1"]}]}],"subset":{"winner":null,"rejections":["PROFILE_INCOMPATIBLE"]}}
{"method":"select","name":"accepts D1 for a relational requirement","input":[{"candidates":[{"definitionId":"cloudflare.temporary-d1/v1","profiles":["data.sqlite/v1"]}],"requirement":{"requiredProfiles":[{"profileId":"data.relational/v1"}]}}],"subset":{"winner":"cloudflare.temporary-d1/v1"}}
{"method":"select","name":"fails closed on unknown conformance","input":[{"candidates":[{"profiles":[{"id":"data.postgres/v1","conformance":"unknown"}]}]}],"subset":{"rejections":["CONFORMANCE_FAILED"]}}
{"method":"select","name":"fails closed on absent, unsigned, and expired evidence","input":[{"candidates":[{"definitionId":"a","absent":["evidenceExpiresAtMs"]},{"definitionId":"b","evidenceSignatureValid":false},{"definitionId":"c","evidenceExpiresAtMs":1786147199999}]}],"subset":{"winner":null,"rejections":["EVIDENCE_STALE","EVIDENCE_STALE","EVIDENCE_STALE"]}}
{"method":"select","name":"rejects a candidate with no registered driver","input":[{"candidates":[{"hasRegisteredDriver":false}]}],"subset":{"rejections":["NO_REGISTERED_DRIVER"]}}
{"method":"select","name":"rejects when secret custody is unavailable","input":[{"candidates":[{"secretCustodyAvailable":false}]}],"subset":{"rejections":["SECRET_CUSTODY_UNAVAILABLE"]}}
{"method":"select","name":"allows pack realization by default","input":[{"candidates":[{"definitionId":"postgres.oci-pack/v1","profiles":[{"id":"data.postgres/v1","realization":"pack"}]}]}],"subset":{"winner":"postgres.oci-pack/v1"}}
{"method":"select","name":"requires an explicit policy opt-in for pack realization","input":[{"candidates":[{"definitionId":"postgres.oci-pack/v1","profiles":[{"id":"data.postgres/v1","realization":"pack"}]}],"policy":{"allowPack":false}}],"subset":{"rejections":["REALIZATION_DENIED"]}}
{"method":"select","name":"enforces the strong-claim gate on retained creator authority","input":[{"candidates":[{"creatorAuthorityAfterClaim":"retained"}]}],"subset":{"rejections":["STRONG_CLAIM_REQUIRED"]}}
{"method":"select","name":"admits retained authority when the policy allows it","input":[{"candidates":[{"creatorAuthorityAfterClaim":"retained"}],"policy":{"creatorAuthorityAfterClaim":"may-be-retained"}}],"subset":{"winner":"test.definition/v1"}}
{"method":"select","name":"caps human claim actions","input":[{"candidates":[{"claimActionCount":3}]}],"subset":{"rejections":["TOO_MANY_CLAIM_ACTIONS"]}}
{"method":"select","name":"gates sponsor exposure against the budget","input":[{"candidates":[{"sponsorExposureMinorUnits":500}]}],"subset":{"rejections":["SPONSOR_BUDGET_EXCEEDED"]}}
{"method":"select","name":"denies sponsorship outright when the policy forbids it","input":[{"candidates":[{"sponsorExposureMinorUnits":500}],"policy":{"allowSponsor":false}}],"subset":{"rejections":["BOOTSTRAP_POLICY_DENIED"]}}
{"method":"select","name":"admits sponsor exposure inside a raised budget","input":[{"candidates":[{"sponsorExposureMinorUnits":500}],"policy":{"sponsorBudgetMinorUnits":1000}}],"subset":{"winner":"test.definition/v1"}}
{"method":"select","name":"rejects a candidate whose binding the workload cannot consume","input":[{"candidates":[{"producesBindingProfiles":["binding.neon-serverless/v1"]}],"consumableBindingProfiles":["binding.postgresql/v1"]}],"subset":{"rejections":["BINDING_UNAVAILABLE"]}}
{"method":"select","name":"rejects a missing required migration profile","input":[{"candidates":[{}],"requirement":{"requiredProfiles":[{"profileId":"data.postgres/v1"}],"portability":{"requiredMigrationProfiles":["migration.postgres.logical-copy/v1"]}}}],"subset":{"rejections":["MIGRATION_REQUIRED_BUT_UNAVAILABLE"]}}
{"method":"select","name":"rejects a prohibited profile","input":[{"candidates":[{"profiles":["data.sqlite/v1"]}],"requirement":{"requiredProfiles":[{"profileId":"data.relational/v1"}],"prohibitedProfiles":[{"profileId":"data.sqlite/v1"}]}}],"subset":{"rejections":["PROFILE_PROHIBITED"]}}
{"method":"select","name":"enforces required structured features","input":[{"candidates":[{"structuredCapabilities":{"maxStorageBytes":100000000}}],"requirement":{"requiredProfiles":[{"profileId":"data.postgres/v1"}],"features":[{"key":"maxStorageBytes","operator":"at-least","value":1000000000,"necessity":"required"}]}}],"subset":{"rejections":["FEATURE_UNSATISFIED"]}}
{"method":"select","name":"admits a candidate that satisfies the feature","input":[{"candidates":[{"structuredCapabilities":{"maxStorageBytes":10000000000}}],"requirement":{"requiredProfiles":[{"profileId":"data.postgres/v1"}],"features":[{"key":"maxStorageBytes","operator":"at-least","value":1000000000,"necessity":"required"}]}}],"subset":{"winner":"test.definition/v1"}}
{"method":"select","name":"enforces a required runtime model","input":[{"candidates":[{}],"requirement":{"requiredProfiles":[{"profileId":"data.postgres/v1"}],"runtime":{"required":"oci"}}}],"subset":{"rejections":["RUNTIME_UNSUPPORTED"]}}
# Lexicographic ranking — trust beats cost, and the id is never the tiebreak that decides.
{"method":"select","name":"prefers absent creator authority over a cheaper retained one","input":[{"candidates":[{"definitionId":"aa.weak/v1","creatorAuthorityAfterClaim":"rotatable"},{"definitionId":"zz.strong/v1","creatorAuthorityAfterClaim":"absent","sponsorExposureMinorUnits":0}]}],"subset":{"ranked":["zz.strong/v1","aa.weak/v1"]}}
{"method":"select","name":"prefers fewer claim actions over provider maturity","input":[{"candidates":[{"definitionId":"established.two/v1","claimActionCount":2,"providerClass":"established"},{"definitionId":"emerging.one/v1","claimActionCount":1,"providerClass":"verified-emerging"}]}],"subset":{"winner":"emerging.one/v1"}}
{"method":"select","name":"prefers single-resource claims over a best-effort saga","input":[{"candidates":[{"definitionId":"aaa.saga/v1","claimAtomicity":"best-effort-saga"},{"definitionId":"zzz.single/v1"}]}],"subset":{"winner":"zzz.single/v1"}}
{"method":"select","name":"an incompatible candidate does not change the winner","input":[{"candidates":[{"definitionId":"neon/v1"},{"definitionId":"aaa.cheap-but-wrong/v1","profiles":["data.sqlite/v1"]}]}],"subset":{"winner":"neon/v1"}}
{"method":"isOrderIndependent","name":"ranking is stable under candidate reordering","input":[{"candidates":[{"definitionId":"a/v1"},{"definitionId":"b/v1"},{"definitionId":"c/v1"}]}],"expect":true}
{"method":"isOrderIndependent","name":"rejection evidence is deterministic","input":[{"candidates":[{"definitionId":"b/v1","claimActionCount":9},{"definitionId":"a/v1","hasRegisteredDriver":false}]}],"expect":true}
# Requirement parsing is its own gate: a bad requirement must never reach selection.
{"method":"parseRequirement","name":"rejects a provider-shaped key on a Bindle requirement","input":[{"requiredProfiles":[{"profileId":"data.postgres/v1"}],"providerId":"neon"}],"throws":"provider-neutral"}
{"method":"parseRequirement","name":"rejects an empty requirement","input":[{"requiredProfiles":[]}],"throws":"at least one required profile"}
{"method":"parseRequirement","name":"rejects a profile that is both required and prohibited","input":[{"requiredProfiles":[{"profileId":"data.postgres/v1"}],"prohibitedProfiles":[{"profileId":"data.postgres/v1"}]}],"throws":"both required and prohibited"}
{"method":"parseRequirement","name":"rejects an unknown required profile id at parse time","input":[{"requiredProfiles":[{"profileId":"not-a-profile"}]}],"throws":"."}
{"method":"parseRequirement","name":"requires at least one realization kind","input":[{"requiredProfiles":[{"profileId":"data.postgres/v1"}],"realization":{"allowNative":false,"allowPack":false,"allowBridge":false}}],"throws":"at least one realization kind"}
