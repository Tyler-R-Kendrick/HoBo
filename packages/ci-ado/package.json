{
  "name": "@hobo/ci-ado",
  "version": "0.0.1",
  "description": "HoBo CI Azure Pipelines self-hosted configuration and local command execution",
  "license": "MIT",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "examples"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "hobo-ci-ado": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "project": "node dist/cli.js",
    "pretest": "node --experimental-strip-types ../../scripts/ensure-built.mts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.12.1",
    "@hobo/ci": "workspace:*",
    "yaml": "2.9.0"
  }
}
