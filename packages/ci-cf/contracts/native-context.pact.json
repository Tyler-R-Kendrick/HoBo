{
  "consumer": {
    "name": "HoboCiCloudflareAdapter"
  },
  "provider": {
    "name": "CloudflareCiRunnerContext"
  },
  "metadata": {
    "pactSpecification": {
      "version": "4.0.0"
    },
    "evidence": "Hand-authored native SDK consumer expectation; the provider context is simulated and executes the wrapper locally."
  },
  "interactions": [
    {
      "type": "Synchronous/Messages",
      "description": "run the same pipeline through native snapshot-chained runners",
      "request": {
        "contents": {
          "pipeline": {
            "id": "cf-pact",
            "accountId": "account-a",
            "timeoutSeconds": 30,
            "steps": [
              {
                "id": "prepare",
                "argv": [
                  "sh",
                  "-c",
                  "printf '%s' \"$VALUE\" > result.txt"
                ],
                "cwd": ".",
                "env": {
                  "VALUE": "artifact"
                }
              },
              {
                "id": "inspect",
                "argv": [
                  "cat",
                  "result.txt"
                ],
                "cwd": ".",
                "env": {}
              }
            ],
            "artifactPaths": [
              "result.txt"
            ],
            "requiredCapabilities": [
              "commands",
              "artifacts",
              "cancellation"
            ]
          },
          "native": {
            "contextCalls": 1,
            "snapshotChainCalls": 2,
            "names": [
              "hobo-cf-pact-prepare",
              "hobo-cf-pact-inspect",
              "hobo-cf-pact-artifact-0"
            ],
            "cwd": ".",
            "retries": {
              "limit": 0,
              "delay": 0
            },
            "env": {},
            "workspace": ".hobo-ci-workspaces/cf-pact"
          }
        },
        "contentType": "application/json"
      },
      "response": [
        {
          "contents": {
            "backend": "cf",
            "status": "succeeded",
            "stepExitCodes": [
              0,
              0
            ],
            "stepStdout": [
              "",
              "artifact"
            ],
            "artifactPath": "result.txt",
            "artifactText": "artifact",
            "artifactSha256": "c7c5c1d70c5dec4416ab6158afd0b223ef40c29b1dc1f97ed9428b94d4cadb1c"
          },
          "contentType": "application/json"
        }
      ]
    }
  ]
}
