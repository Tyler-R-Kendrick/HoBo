{
  "name": "@hobo/ci-cf",
  "version": "0.0.1",
  "description": "HoBo CI Cloudflare native Workflow/Sandbox pipeline backend",
  "license": "MIT",
  "type": "module",
  "private": true,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.worker.json",
    "lint": "biome check .",
    "test": "vitest run",
    "typecheck:worker": "tsc -p tsconfig.worker.json"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.12.1",
    "@hobo/ci": "workspace:*",
    "@cloudflare/ci": "0.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260730.1",
    "typescript": "6.0.3"
  }
}
