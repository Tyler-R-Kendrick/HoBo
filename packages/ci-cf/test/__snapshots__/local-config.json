{
  "name": "hobo-ci-cf-local",
  "main": "<package>/examples/local/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "send_metrics": false,
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787,
    "enable_containers": true
  },
  "containers": [
    {
      "class_name": "LocalCiSandbox",
      "image": "./Dockerfile",
      "image_build_context": ".",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SANDBOX",
        "class_name": "LocalCiSandbox"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "LocalCiSandbox"
      ]
    }
  ],
  "workflows": [
    {
      "name": "hobo-ci-cf-local",
      "binding": "CI_WORKFLOW",
      "class_name": "HoBoLocalCI"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "hobo-ci-cf-local-snapshots",
      "remote": false
    }
  ],
  "vars": {
    "HOBO_SOURCE_SHA": "1111111111111111111111111111111111111111",
    "HOBO_PREPARATION_ID": "local-review",
    "HOBO_PIPELINE_JSON": "{\"id\":\"local-checks\",\"accountId\":\"local\",\"steps\":[{\"id\":\"check\",\"argv\":[\"node\",\"--version\"],\"cwd\":\".\"}],\"timeoutSeconds\":600}"
  }
}