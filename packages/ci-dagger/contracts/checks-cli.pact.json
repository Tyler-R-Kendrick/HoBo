{
  "consumer": { "name": "HoboDaggerChecks" },
  "provider": { "name": "DaggerNativeCli" },
  "metadata": {
    "pactSpecification": { "version": "4.0.0" },
    "evidence": "Hand-authored subprocess consumer contract; not live engine or vendor verification."
  },
  "interactions": [
    {
      "description": "pin the CLI before starting native checks",
      "type": "Synchronous/Messages",
      "request": { "contents": { "argv": ["version"] } },
      "response": [{ "contents": { "stdout": "version:     v1.0.0-beta.21\ncommit:      fixture\nplatform:    linux/amd64\n", "exitCode": 0 } }]
    },
    {
      "description": "run configured checks on a local engine without a Cloud login",
      "type": "Synchronous/Messages",
      "request": {
        "contents": {
          "argv": ["check", "--engine=image://registry.dagger.io/engine:v1.0.0-beta.21", "--workspace=WORKSPACE", "--progress=plain", "--parallel=4", "--fail-fast", "--skip=dag://go/lint", "--", "dag://go/packages/tests/test"],
          "removedEnvironment": ["DAGGER_ENGINE", "DAGGER_CLOUD_ENGINE", "DAGGER_CLOUD_TOKEN", "DAGGER_SESSION_PORT", "DAGGER_SESSION_TOKEN", "_EXPERIMENTAL_DAGGER_RUNNER_HOST"]
        }
      },
      "response": [{ "contents": { "exitCode": 17 } }]
    }
  ]
}
