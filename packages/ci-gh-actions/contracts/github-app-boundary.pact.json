{
  "consumer": { "name": "HoboCiGhActions" },
  "provider": { "name": "GithubActionsRestApi" },
  "metadata": {
    "pactSpecification": { "version": "3.0.0" },
    "evidence": "Hand-authored consumer expectations; mocked transport only; no provider verification or captured traffic.",
    "consumerFixtures": {
      "appId": "12345",
      "installationId": 42,
      "nowMilliseconds": 1793016000000,
      "appJwtClaims": { "iat": 1793015940, "exp": 1793016540, "iss": "12345" }
    }
  },
  "interactions": [
    {
      "description": "exchange signed App JWT for installation token",
      "request": {
        "method": "POST",
        "path": "/app/installations/42/access_tokens",
        "headers": {
          "Accept": "application/vnd.github+json",
          "X-GitHub-Api-Version": "2026-03-10",
          "Content-Type": "application/json",
          "Authorization": "Bearer signed.app.jwt"
        },
        "matchingRules": {
          "header": {
            "Authorization": {
              "matchers": [{ "match": "regex", "regex": "^Bearer [A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$" }]
            }
          }
        }
      },
      "response": { "status": 201, "body": { "token": "ghs_consumer_fixture_only" } }
    },
    {
      "description": "dispatch a provider host workflow using the configured bridge ref",
      "request": {
        "method": "POST",
        "path": "/repos/hobo-fixture/ci-example/actions/workflows/hobo-ci-host.yml/dispatches",
        "headers": {
          "Accept": "application/vnd.github+json",
          "X-GitHub-Api-Version": "2026-03-10",
          "Content-Type": "application/json",
          "Authorization": "Bearer ghs_consumer_fixture_only"
        },
        "body": {
          "ref": "hobo-ci-v1",
          "inputs": {
            "lease_id": "11111111-1111-4111-8111-111111111111",
            "runs_on": "blacksmith-2vcpu-ubuntu-2404",
            "timeout_minutes": "10"
          }
        }
      },
      "response": { "status": 204 }
    },
    {
      "description": "register one repository scoped JIT runner with the hobo label",
      "request": {
        "method": "POST",
        "path": "/repos/hobo-fixture/ci-example/actions/runners/generate-jitconfig",
        "headers": {
          "Accept": "application/vnd.github+json",
          "X-GitHub-Api-Version": "2026-03-10",
          "Content-Type": "application/json",
          "Authorization": "Bearer ghs_consumer_fixture_only"
        },
        "body": {
          "name": "hobo-11111111-1111-4111-8111-111111111111",
          "runner_group_id": 1,
          "labels": ["hobo"],
          "work_folder": "_hobo_work"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "encoded_jit_config": "Zml4dHVyZS1vbmx5",
          "runner": { "id": 7001, "name": "hobo-11111111-1111-4111-8111-111111111111" }
        }
      }
    },
    {
      "description": "refuse installation token exchange when App authentication fails",
      "request": {
        "method": "POST",
        "path": "/app/installations/42/access_tokens",
        "headers": {
          "Accept": "application/vnd.github+json",
          "X-GitHub-Api-Version": "2026-03-10",
          "Content-Type": "application/json",
          "Authorization": "Bearer signed.app.jwt"
        },
        "matchingRules": {
          "header": {
            "Authorization": {
              "matchers": [{ "match": "regex", "regex": "^Bearer [A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$" }]
            }
          }
        }
      },
      "response": { "status": 401, "body": { "message": "Bad credentials" } }
    },
    {
      "description": "reject a successful installation exchange without a usable token",
      "request": {
        "method": "POST",
        "path": "/app/installations/42/access_tokens",
        "headers": {
          "Accept": "application/vnd.github+json",
          "X-GitHub-Api-Version": "2026-03-10",
          "Content-Type": "application/json",
          "Authorization": "Bearer signed.app.jwt"
        },
        "matchingRules": {
          "header": {
            "Authorization": {
              "matchers": [{ "match": "regex", "regex": "^Bearer [A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$" }]
            }
          }
        }
      },
      "response": { "status": 201, "body": { "token": "" } }
    },
    {
      "description": "return provider host dispatch authorization failure to the caller",
      "request": {
        "method": "POST",
        "path": "/repos/hobo-fixture/ci-example/actions/workflows/hobo-ci-host.yml/dispatches",
        "headers": {
          "Accept": "application/vnd.github+json",
          "X-GitHub-Api-Version": "2026-03-10",
          "Content-Type": "application/json",
          "Authorization": "Bearer ghs_consumer_fixture_only"
        },
        "body": { "ref": "hobo-ci-v1", "inputs": { "lease_id": "11111111-1111-4111-8111-111111111111", "runs_on": "blacksmith-2vcpu-ubuntu-2404", "timeout_minutes": "10" } }
      },
      "response": { "status": 403, "body": { "message": "Resource not accessible by integration" } }
    },
    {
      "description": "return JIT registration validation failure to the caller",
      "request": {
        "method": "POST",
        "path": "/repos/hobo-fixture/ci-example/actions/runners/generate-jitconfig",
        "headers": {
          "Accept": "application/vnd.github+json",
          "X-GitHub-Api-Version": "2026-03-10",
          "Content-Type": "application/json",
          "Authorization": "Bearer ghs_consumer_fixture_only"
        },
        "body": { "name": "hobo-11111111-1111-4111-8111-111111111111", "runner_group_id": 1, "labels": ["hobo"], "work_folder": "_hobo_work" }
      },
      "response": { "status": 422, "body": { "message": "Validation failed" } }
    },
    {
      "description": "refuse a redirect during the App token exchange",
      "request": {
        "method": "POST",
        "path": "/app/installations/42/access_tokens",
        "headers": {
          "Accept": "application/vnd.github+json",
          "X-GitHub-Api-Version": "2026-03-10",
          "Content-Type": "application/json",
          "Authorization": "Bearer signed.app.jwt"
        },
        "matchingRules": {
          "header": {
            "Authorization": {
              "matchers": [{ "match": "regex", "regex": "^Bearer [A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$" }]
            }
          }
        }
      },
      "response": { "status": 302, "headers": { "Location": "https://redirect.invalid/credentials" } }
    },
    {
      "description": "refuse a redirect when dispatching the host workflow",
      "request": {
        "method": "POST",
        "path": "/repos/hobo-fixture/ci-example/actions/workflows/hobo-ci-host.yml/dispatches",
        "headers": {
          "Accept": "application/vnd.github+json",
          "X-GitHub-Api-Version": "2026-03-10",
          "Content-Type": "application/json",
          "Authorization": "Bearer ghs_consumer_fixture_only"
        },
        "body": { "ref": "hobo-ci-v1", "inputs": { "lease_id": "11111111-1111-4111-8111-111111111111", "runs_on": "blacksmith-2vcpu-ubuntu-2404", "timeout_minutes": "10" } }
      },
      "response": { "status": 302, "headers": { "Location": "https://redirect.invalid/credentials" } }
    }
  ]
}
