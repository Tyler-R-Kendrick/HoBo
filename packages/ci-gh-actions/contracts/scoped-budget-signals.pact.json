    },
    {
      "description": "legacy recovery cannot unpause scoped budget",
      "providerStates": [
        {
          "name": "matching scoped budget and desired CI policy are configured"
        }
      ],
      "request": {
        "method": "POST",
        "path": "/v2/accounts/self/signals",
        "headers": {
          "Authorization": "Bearer scoped-budget-observer-token-at-least-32-characters",
          "Content-Type": "application/json",
          "If-Match": "\"5\""
        },
        "body": {
          "type": "budget.Recovered",
          "data": {
            "tenantId": "tenant-a",
            "thresholdFraction": 1,
            "thresholdUsd": 1,
