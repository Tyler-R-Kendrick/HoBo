            "policyDigest": "5b61f9df76a0fe8ee839e18a22b0d5e1a05d6920459bc496191c7848efe819ec",
            "crossed": true
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "revision": 4,
          "account": {
            "id": "account-a",
            "routingSignalCycles": {
              "broker:v2:[\"tenant-a\",\"shared-budget\",\"period-a\",\"revision-a\"]:1": 2
            },
            "routingSignalCrossed": {
              "broker:v2:[\"tenant-a\",\"shared-budget\",\"period-a\",\"revision-a\"]:1": true
            }
          }
        }
      }
    },
