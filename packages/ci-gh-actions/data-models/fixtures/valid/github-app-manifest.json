{
  "name": "HoBo CI",
  "url": "https://ci.hobo.test",
  "hook_attributes": {
    "url": "https://ci.hobo.test/github/webhooks",
    "active": true
  },
  "redirect_url": "https://ci.hobo.test/github/app/manifest/callback",
  "setup_url": "https://ci.hobo.test/github/app/installed",
  "public": true,
  "default_events": [
    "workflow_job",
    "workflow_run"
  ],
  "default_permissions": {
    "actions": "write",
    "administration": "write",
    "contents": "write",
    "workflows": "write",
    "metadata": "read",
    "pull_requests": "write",
    "members": "read"
  },
  "callback_urls": [
    "https://ci.hobo.test/v1/app-registration/oauth/callback"
  ]
}
