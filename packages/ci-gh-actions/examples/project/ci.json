{
  "defaultEnvironment": "local",
  "environments": {
    "local": {
      "relayOrigin": "http://127.0.0.1:8787",
      "githubWebhookOrigin": "https://local-ci.example.com",
      "allowInsecureLoopback": true,
      "policy": {
        "accountId": "local-ci",
        "tenantId": "local-ci",
        "pool": { "label": "hobo", "os": "linux", "architecture": "x64" },
        "providers": [
          { "id": "local-github", "kind": "github", "connectionRef": "local-github", "runsOn": "ubuntu-24.04", "enabled": true }
        ],
        "budget": { "scope": "ci-account", "currency": "USD", "limitMicros": 1000000, "period": "manual", "timeZone": "UTC" },
        "routing": { "strategy": "lowest-total-incremental-cost", "noEligibleProvider": "queue", "unknownAllocation": "zero" },
        "thresholds": []
      }
    },
    "integration": {
      "relayOrigin": "https://ci.example.com",
      "githubWebhookOrigin": "https://ci.example.com",
      "policy": {
        "accountId": "integration-ci",
        "tenantId": "integration-ci",
        "pool": { "label": "hobo", "os": "linux", "architecture": "x64" },
        "providers": [
          { "id": "integration-sandbox", "kind": "vercel", "connectionRef": "integration-vercel", "runsOn": "sandbox", "enabled": true }
        ],
        "budget": { "scope": "ci-account", "currency": "USD", "limitMicros": 5000000, "period": "manual", "timeZone": "UTC" },
        "routing": { "strategy": "lowest-total-incremental-cost", "noEligibleProvider": "queue", "unknownAllocation": "zero" },
        "thresholds": []
      }
    }
  }
}
