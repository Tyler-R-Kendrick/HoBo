{
  "defaultEnvironment": "local",
  "templates": {
    "standard": {
      "secrets": {
        "HOBO_CI_ACCOUNT_TOKEN": {
          "requiredFor": [
            "deployment"
          ]
        },
        "HOBO_CI_WEBHOOK_SECRET": {
          "requiredFor": [
            "execution"
          ]
        }
      },
      "policy": {
        "pool": {
          "label": "hobo",
          "os": "linux",
          "architecture": "x64"
        },
        "routing": {
          "strategy": "lowest-total-incremental-cost",
          "noEligibleProvider": "queue",
          "unknownAllocation": "zero"
        },
        "thresholds": [],
        "budget": {
          "scope": "ci-account",
          "currency": "USD",
          "period": "manual",
          "timeZone": "UTC"
        }
      }
    }
  },
  "environments": {
    "local": {
      "relayOrigin": "http://127.0.0.1:8787",
      "githubWebhookOrigin": "https://local-ci.example.com",
      "allowInsecureLoopback": true,
      "policy": {
        "accountId": "local-ci",
        "tenantId": "local-ci",
        "providers": [
          {
            "id": "local-github",
            "kind": "github",
            "connectionRef": "local-github",
            "runsOn": "ubuntu-24.04",
            "enabled": true
          }
        ],
        "budget": {
          "limitMicros": 1000000
        }
      },
      "extends": "standard"
    },
    "integration": {
      "relayOrigin": "https://ci.example.com",
      "githubWebhookOrigin": "https://ci.example.com",
      "policy": {
        "accountId": "integration-ci",
        "tenantId": "integration-ci",
        "providers": [
          {
            "id": "integration-sandbox",
            "kind": "vercel",
            "connectionRef": "integration-vercel",
            "runsOn": "sandbox",
            "enabled": true
          }
        ],
        "budget": {
          "limitMicros": 5000000
        }
      },
      "extends": "standard"
    }
  }
}
