{
  "name": "@hobo/ci-gh-actions",
  "version": "0.0.1",
  "description": "HoBo CI GitHub Actions webhook relay and ephemeral runner providers",
  "license": "MIT",
  "type": "module",
  "private": true,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "test": "vitest run",
    "start": "node dist/main.js",
    "test:act": "node --import tsx scripts/act-harness.ts",
    "act:install": "node --import tsx scripts/act-install.ts"
  },
  "dependencies": {
    "@hobo/ci": "workspace:*",
    "@bufbuild/protobuf": "2.12.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@hobo/ci-dagger": "workspace:*",
    "@hobo/ci-cf": "workspace:*",
    "@dagger.io/dagger": "0.21.11",
    "@cloudflare/workers-types": "5.20260730.1"
  }
}
