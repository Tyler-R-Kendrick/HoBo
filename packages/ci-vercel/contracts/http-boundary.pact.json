{
  "consumer": {
    "name": "GitHubActionsAndHoboCiClient"
  },
  "provider": {
    "name": "HoboCiVercelHttp"
  },
  "metadata": {
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "interactions": [
    {
      "description": "persist an authenticated delivery",
      "request": {
        "method": "POST",
        "path": "/github/webhooks",
        "headers": {
          "x-github-event": "workflow_job",
          "x-github-delivery": "delivery-1",
          "x-hub-signature-256": "sha256=a2b2beb40af1495f96972d3596c6fe7b55fc9a779ece55630cdf6af6fb9d6e1c"
        },
        "body": "{\"workflow_job\":{}}\n"
      },
      "response": {
        "status": 202,
        "body": {
          "status": "accepted"
        }
      }
    },
    {
      "description": "acknowledge the committed duplicate",
      "request": {
        "method": "POST",
        "path": "/github/webhooks",
        "headers": {
          "x-github-event": "workflow_job",
          "x-github-delivery": "delivery-1",
          "x-hub-signature-256": "sha256=a2b2beb40af1495f96972d3596c6fe7b55fc9a779ece55630cdf6af6fb9d6e1c"
        },
        "body": "{\"workflow_job\":{}}\n"
      },
      "response": {
        "status": 202,
        "body": {
          "status": "duplicate"
        }
      }
    },
    {
      "description": "reject an unsigned delivery",
      "request": {
        "method": "POST",
        "path": "/github/webhooks",
        "headers": {
          "x-github-event": "workflow_job",
          "x-github-delivery": "delivery-2"
        },
        "body": "{}\n"
      },
      "response": {
        "status": 401,
        "body": {
          "error": "signature required"
        }
      }
    },
    {
      "description": "report dependency readiness",
      "request": {
        "method": "GET",
        "path": "/readyz",
        "headers": {}
      },
      "response": {
        "status": 200,
        "body": {
          "ready": true
        }
      }
    },
    {
      "description": "require JIT authentication",
      "request": {
        "method": "POST",
        "path": "/v1/leases/01234567-89ab-4cde-8fab-0123456789ab/jit",
        "headers": {}
      },
      "response": {
        "status": 403,
        "body": {
          "error": "claim rejected"
        }
      }
    },
    {
      "description": "return a single-use JIT response",
      "request": {
        "method": "POST",
        "path": "/v1/leases/01234567-89ab-4cde-8fab-0123456789ab/jit",
        "headers": {
          "authorization": "Bearer contract-oidc"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "encodedJitConfig": "dGVzdA=="
        }
      }
    }
  ]
}
