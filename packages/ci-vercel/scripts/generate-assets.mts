import { readFile, writeFile } from "node:fs/promises";

const workflow = await readFile(
	new URL("../../ci-gh-actions/templates/hobo-ci-host.yml", import.meta.url),
	"utf8",
);
const bootstrap = await readFile(
	new URL("../../ci-gh-actions/src/bootstrap.ts", import.meta.url),
	"utf8",
);
const output = `// Generated by scripts/generate-assets.mts. Do not edit.\nexport const workflow = ${JSON.stringify(workflow)};\nexport const bootstrap = ${JSON.stringify(bootstrap)};\n`;
await writeFile(
	new URL("../src/_generated/relay-assets.ts", import.meta.url),
	output,
);
