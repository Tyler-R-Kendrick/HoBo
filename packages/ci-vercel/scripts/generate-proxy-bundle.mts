import { readFile, writeFile } from "node:fs/promises";
import { resolve } from "node:path";
import { build } from "esbuild";

const result = await build({
	entryPoints: [
		new URL("../src/sandbox-proxy-vm-entry.ts", import.meta.url).pathname,
	],
	bundle: true,
	platform: "node",
	format: "esm",
	target: "node24",
	write: false,
	legalComments: "inline",
	metafile: true,
	minify: true,
});
const output = result.outputFiles[0];
if (!output) throw new Error("sandbox proxy bundle missing");
const roots = new Set<string>();
for (const input of Object.keys(result.metafile.inputs)) {
	const marker = "/node_modules/";
	const index = input.lastIndexOf(marker);
	if (index < 0) continue;
	const base = input.slice(0, index + marker.length);
	const parts = input.slice(index + marker.length).split("/");
	const name = parts[0]?.startsWith("@")
		? parts.slice(0, 2).join("/")
		: parts[0];
	if (!name) throw new Error("invalid bundled package path");
	roots.add(resolve(base, name));
}
const licenses: string[] = [];
for (const root of [...roots].sort()) {
	const manifest: { name: string; version: string } = JSON.parse(
		await readFile(`${root}/package.json`, "utf8"),
	);
	let license: string | undefined;
	for (const filename of ["LICENSE", "LICENSE.md", "LICENSE.txt"]) {
		try {
			license = await readFile(`${root}/${filename}`, "utf8");
			break;
		} catch (error) {
			if (
				!(error instanceof Error && "code" in error && error.code === "ENOENT")
			)
				throw error;
		}
	}
	if (!license) throw new Error(`missing bundled license for ${manifest.name}`);
	licenses.push(`${manifest.name}@${manifest.version}\n${license.trim()}`);
}
const notice = `/* Third-party licenses:\n\n${licenses.join("\n\n").replaceAll("*/", "* /")}\n*/\n`;
const generated = `// Generated by scripts/generate-proxy-bundle.mts. Do not edit.\nexport const sandboxProxyBundle = ${JSON.stringify(notice + output.text)};\n`;
const destination = new URL(
	"../src/_generated/sandbox-proxy-bundle.ts",
	import.meta.url,
);
if (process.argv.includes("--check")) {
	if ((await readFile(destination, "utf8")) !== generated)
		throw new Error("sandbox proxy bundle is stale; regenerate it");
} else {
	await writeFile(destination, generated);
}
