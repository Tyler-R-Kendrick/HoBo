{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/queue.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "hobo-ci"
        }
      ]
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/relay",
      "transforms": [
        {
          "type": "request.path",
          "op": "set",
          "args": "/$1"
        }
      ]
    }
  ]
}
