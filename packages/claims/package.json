{
	"name": "@hobo/claims",
	"version": "0.0.1",
	"license": "MIT",
	"description": "HoBo durable guest-lease and claim plane: GuestLease, ClaimBundle/ClaimItem state machines, the claim coordinator reducer, and the one-time sensitive action store.",
	"type": "module",
	"files": [
		"LICENSE",
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@hobo/core": "workspace:*"
	},
	"devDependencies": {
		"@hobo/contract-harness": "workspace:*",
		"@types/node": "^22.15.29",
		"vitest": "^4.1.9"
	},
	"scripts": {
		"prebuild": "pnpm --filter @hobo/core build",
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"pretest": "pnpm run build",
		"test": "vitest run test/",
		"test:unit": "vitest run test/"
	}
}
