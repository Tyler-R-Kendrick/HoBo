{
  "consumer": { "name": "@hobo/cli" },
  "provider": { "name": "@hobo/local-dev-loop" },
  "interactions": [
    {
      "description": "hobo collect runs run-to-collect and emits the manifest IR",
      "request": { "verb": "collect", "bindle": "hello-bindle" },
      "response": {
        "status": "ok",
        "manifestHash": "sha256:36e76ae9121acab7d954bf7c243267bff14f2caf2fa2874aa42e2468e7a57157",
        "resources": ["api", "db"],
        "events": ["bindle.ResourcesCollected", "bindle.ManifestProduced"]
      }
    },
    {
      "description": "hobo dev boots a runtime-local Camp and serves the Bindle offline",
      "request": { "verb": "dev", "bindle": "hello-bindle" },
      "response": {
        "status": "serving",
        "runtime": "runtime-local",
        "offline": true,
        "served": { "status": 200, "headers": [], "body": "hello world" },
        "events": [
          "component.Loaded",
          "link.Established",
          "link.Called",
          "component.Invoked"
        ]
      }
    }
  ],
  "metadata": { "pactSpecification": { "version": "3.0.0" } }
}
