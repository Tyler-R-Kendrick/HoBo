{
  "schemaVersion": "hobo.budget-policy/v1",
  "tenantId": "tenant",
  "budgetId": "budget",
  "periodId": "period",
  "revision": "r1",
  "workloads": ["hosting", "ci"],
  "currency": "USD",
  "limitMicros": 1000,
  "objective": "min-cost",
  "enforcement": "strict",
  "periodKind": "fixed-window",
  "periodStartsAtMs": 0,
  "periodEndsAtMs": 10000,
  "constraints": [
    {"key": "work.cost", "workload": "*", "unit": "USD.micros", "maximum": 100},
    {"key": "provider.cost", "workload": "hosting", "unit": "USD.micros", "target": "source", "maximum": 30}
  ]
}
