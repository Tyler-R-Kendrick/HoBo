{
  "consumer": { "name": "stage-gate-ci-drill" },
  "provider": { "name": "hobo-credential-audit-projection" },
  "interactions": [
    {
      "description": "brokered deploy trace is replayable with no static secrets",
      "request": { "projection": "CredentialAudit", "runId": "run-hello-bindle-j2-1" },
      "response": {
        "status": "ok",
        "body": {
          "replayable": true,
          "staticSecretsFound": false,
          "tokenTrail": ["token.Granted", "token.Used"]
        }
      }
    }
  ]
}
