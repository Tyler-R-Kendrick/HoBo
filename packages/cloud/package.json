{
	"name": "@hobo/cloud",
	"version": "0.0.1",
	"license": "MIT",
	"type": "module",
	"private": true,
	"files": ["dist"],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@hobo/bindles": "workspace:*",
		"@hobo/core": "workspace:*",
		"@hobo/data": "workspace:*",
		"@hobo/events": "workspace:*"
	},
	"devDependencies": {
		"@hobo/provider-cloudflare": "workspace:*",
		"@hobo/runtime-local": "workspace:*"
	},
	"scripts": {
		"prebuild": "pnpm --filter @hobo/core build && pnpm --filter @hobo/bindles build && pnpm --filter @hobo/data build && pnpm --filter @hobo/events build",
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"pretest": "pnpm run build && pnpm --filter @hobo/runtime-local build && pnpm --filter @hobo/provider-cloudflare build",
		"test": "vitest run",
		"test:contract:consumer": "vitest run contracts/consumer"
	}
}
