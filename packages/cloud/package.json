{
	"name": "@hobo/cloud",
	"version": "0.0.1",
	"license": "MIT",
	"type": "module",
	"private": true,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@bufbuild/protobuf": "2.12.1",
		"@hobo/bindings": "workspace:*",
		"@hobo/bindles": "workspace:*",
		"@hobo/capability-profiles": "workspace:*",
		"@hobo/claims": "workspace:*",
		"@hobo/core": "workspace:*",
		"@hobo/contracts": "workspace:*",
		"@hobo/data": "workspace:*",
		"@hobo/events": "workspace:*",
		"@hobo/identity": "workspace:*",
		"@hobo/manifest-declaration": "workspace:*",
		"@hobo/manifest-plan": "workspace:*"
	},
	"devDependencies": {
		"@hobo/contract-harness": "workspace:*",
		"@hobo/provider-cloudflare": "workspace:*",
		"@hobo/runtime-local": "workspace:*"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"pretest": "node --experimental-strip-types ../../scripts/ensure-built.mts",
		"test": "vitest run",
		"test:contract:consumer": "vitest run contracts/consumer"
	}
}
