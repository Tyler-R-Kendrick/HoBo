{
	"schema": "hobo.manifest/v1",
	"componentHost": {
		"kind": "wasmtime",
		"version": "1.0.0"
	},
	"resources": {
		"service": {
			"type": "component.v1",
			"image": "oci://registry.example.com/hello-bindle@sha256:abc123",
			"runtime": "wasm",
			"exports": ["wasi:http/incoming-handler"],
			"bind": ["ledger"]
		},
		"ledger": {
			"type": "data.v1",
			"port": "hobo:database"
		}
	}
}
