{
	"consumer": {
		"name": "hobo-code-browser-overlay"
	},
	"provider": {
		"name": "@hobo/code-dev-browser"
	},
	"interactions": [
		{
			"description": "serve the in-development application without caching",
			"request": { "method": "GET", "path": "/?__hobo_debug=1" },
			"response": {
				"status": 200,
				"headers": { "cache-control": "no-store" }
			}
		},
		{
			"description": "serve the canonical Bo idle launcher sheet",
			"request": { "method": "GET", "path": "/__hobo/evidence/bo-idle.png" },
			"response": {
				"status": 200,
				"headers": { "content-type": "image/png" }
			}
		},
		{
			"description": "serve the separate-origin browser evidence controls",
			"request": { "method": "GET", "path": "/__hobo/evidence/controls/{capability}" },
			"response": {
				"status": 200,
				"headers": { "content-type": "text/html; charset=utf-8" }
			}
		},
		{
			"description": "persist an exact validated browser annotation through the evidence host",
			"request": {
				"method": "POST",
				"path": "/__hobo/evidence/api/actions/{capability}",
				"headers": { "content-type": "text/plain" },
				"body": {
					"type": "annotate",
					"selector": "[data-testid=primary]",
					"note": "Clarify the current state"
				}
			},
			"response": { "status": 202 }
		},
		{
			"description": "store browser screenshots and recordings in the evidence host",
			"request": { "method": "POST", "path": "/__hobo/evidence/api/captures/{capability}" },
			"response": { "status": 201 }
		}
	],
	"metadata": {
		"pactSpecification": { "version": "3.0.0" }
	}
}
