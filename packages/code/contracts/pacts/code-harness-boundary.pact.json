{
	"consumer": {
		"name": "@hobo/code"
	},
	"provider": {
		"name": "SessionControlPlane"
	},
	"interactions": [
		{
			"description": "create isolation context with worktree fallback when rift unavailable",
			"request": {
				"method": "POST",
				"path": "/code/isolation",
				"body": {
					"runId": "run-1",
					"branch": "code/run-1",
					"preferRift": true
				}
			},
			"response": {
				"status": 200,
				"body": {
					"schemaVersion": "hobo.code.isolation/v1",
					"status": "open",
					"backend": {
						"kind": "worktree"
					}
				}
			}
		},
		{
			"description": "cleanup leaves zero orphans and primary worktree clean",
			"request": {
				"method": "POST",
				"path": "/code/isolation/cleanup",
				"body": {
					"runId": "run-1"
				}
			},
			"response": {
				"status": 200,
				"body": {
					"status": "cleaned",
					"orphans": []
				}
			}
		},
		{
			"description": "promotion is gated and squash-only",
			"request": {
				"method": "POST",
				"path": "/code/promote",
				"body": {
					"runId": "run-1",
					"squashOnly": true
				}
			},
			"response": {
				"status": 200,
				"body": {
					"ok": true,
					"code": "HOBO_CODE_PROMOTED",
					"cleaned": true
				}
			}
		},
		{
			"description": "create a resident session with runtime-backed panes",
			"request": {
				"method": "POST",
				"path": "/code/sessions",
				"body": {
					"sessionId": "session-1",
					"name": "session-contract",
					"projectRoot": "/repo",
					"branch": "code/session-contract",
					"clientId": "client-1"
				}
			},
			"response": {
				"status": 200,
				"body": {
					"schemaVersion": "hobo.code.session-snapshot/v1",
					"session": {
						"id": "session-1",
						"lifecycleState": "SESSION_LIFECYCLE_STATE_RUNNING"
					},
					"panes": [
						{
							"id": "pane-coordinator",
							"runtimeId": "%1"
						},
						{
							"id": "pane-worker",
							"runtimeId": "%2"
						}
					],
					"attachedClientIds": ["client-1"],
					"focusedPaneId": "pane-coordinator"
				}
			}
		},
		{
			"description": "detach without stopping the resident session",
			"request": {
				"method": "POST",
				"path": "/code/sessions/session-1/detach",
				"body": {
					"clientId": "client-1"
				}
			},
			"response": {
				"status": 200,
				"body": {
					"session": {
						"id": "session-1",
						"lifecycleState": "SESSION_LIFECYCLE_STATE_RUNNING"
					},
					"attachedClientIds": []
				}
			}
		},
		{
			"description": "reattach to the durable session snapshot",
			"request": {
				"method": "POST",
				"path": "/code/sessions/session-1/reattach",
				"body": {
					"clientId": "client-2"
				}
			},
			"response": {
				"status": 200,
				"body": {
					"session": {
						"id": "session-1",
						"lifecycleState": "SESSION_LIFECYCLE_STATE_RUNNING"
					},
					"panes": [
						{
							"id": "pane-coordinator",
							"runtimeId": "%1"
						},
						{
							"id": "pane-worker",
							"runtimeId": "%2"
						}
					],
					"attachedClientIds": ["client-2"]
				}
			}
		},
		{
			"description": "switch focus to another runtime-backed pane",
			"request": {
				"method": "POST",
				"path": "/code/sessions/session-1/focus",
				"body": {
					"paneId": "pane-worker"
				}
			},
			"response": {
				"status": 200,
				"body": {
					"focusedPaneId": "pane-worker"
				}
			}
		}
	],
	"metadata": {
		"pactSpecification": {
			"version": "3.0.0"
		}
	}
}
