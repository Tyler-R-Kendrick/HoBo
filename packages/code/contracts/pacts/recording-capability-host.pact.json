{
	"consumer": { "name": "@hobo/code-evidence-overlay" },
	"provider": { "name": "@hobo/code-session-control-server" },
	"interactions": [
		{
			"description": "save a completed recording as a deterministic project capability",
			"request": {
				"method": "POST",
				"path": "/__hobo/evidence/api/actions/:controlsCapability",
				"headers": {
					"origin": "http://127.0.0.1:4173",
					"content-type": "text/plain"
				},
				"body": {
					"type": "save-capability",
					"recordingId": "recording-17",
					"name": "Checkout replay"
				}
			},
			"response": {
				"status": 201,
				"headers": {
					"access-control-allow-origin": "http://127.0.0.1:4173",
					"cache-control": "no-store",
					"content-type": "application/json; charset=utf-8",
					"x-content-type-options": "nosniff"
				},
				"body": {
					"capabilityId": "checkout-replay",
					"path": ".hobo/recordings/checkout-replay",
					"command": "pnpm exec playwright test .hobo/recordings/checkout-replay/scripts/run.spec.ts --workers=1 --retries=0",
					"replayability": "ready"
				}
			}
		},
		{
			"description": "reject capability writes from an unregistered overlay origin",
			"request": {
				"method": "POST",
				"path": "/__hobo/evidence/api/actions/:controlsCapability",
				"headers": {
					"origin": "https://attacker.example",
					"content-type": "text/plain"
				},
				"body": {
					"type": "save-capability",
					"recordingId": "recording-17",
					"name": "Checkout replay"
				}
			},
			"response": {
				"status": 403,
				"headers": {
					"cache-control": "no-store",
					"content-type": "application/json; charset=utf-8",
					"x-content-type-options": "nosniff"
				},
				"body": {
					"error": "evidence action origin is not registered"
				}
			}
		}
	],
	"metadata": { "pactSpecification": { "version": "3.0.0" } }
}
