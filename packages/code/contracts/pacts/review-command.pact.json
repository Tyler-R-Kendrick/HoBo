{
	"consumer": { "name": "hobo-code-cli" },
	"provider": { "name": "@hobo/code-review" },
	"interactions": [
		{
			"description": "start a working-tree review",
			"request": {
				"method": "POST",
				"path": "/review",
				"body": {
					"schemaVersion": "hobo.code.review-command/v1",
					"commandId": "c1",
					"actorId": "human",
					"reviewId": "r1",
					"startReview": {
						"target": {
							"kind": "REVIEW_TARGET_KIND_WORKING_TREE",
							"repositoryId": "repo"
						}
					}
				}
			},
			"response": {
				"status": 200,
				"body": {
					"accepted": true,
					"code": "HOBO_CODE_REVIEW"
				}
			}
		}
	]
}
