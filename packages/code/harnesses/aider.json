{
	"id": "aider",
	"label": "aider",
	"kind": "coding-agent",
	"binaries": ["aider"],
	"configPaths": [".aider.conf.yml"],
	"command": "aider",
	"seat": 60,
	"runtime": { "adapter": "cli", "prompt": { "placement": "trailing-arg", "prefixArgs": ["--yes", "--message"] } },
	"config": {
		"format": "note",
		"path": ".aider.conf.yml",
		"summary": "set aider OpenAI-compatible base URL to the Station surface",
		"after": "base_url={{openaiUrl}}\nenv_key={{envKey}}"
	}
}
