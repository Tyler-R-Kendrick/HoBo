{
	"id": "claude",
	"label": "Claude Code",
	"kind": "coding-agent",
	"binaries": ["claude"],
	"configPaths": [".claude"],
	"command": "claude",
	"seat": 20,
	"config": {
		"format": "json-env",
		"path": ".claude/settings.json",
		"env": {
			"ANTHROPIC_BASE_URL": "{{anthropicUrl}}",
			"ANTHROPIC_API_KEY": "",
			"ANTHROPIC_AUTH_TOKEN": "{{envRef}}",
			"CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "1"
		}
	}
}
