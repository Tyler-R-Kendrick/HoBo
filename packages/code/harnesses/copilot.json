{
	"id": "copilot",
	"label": "GitHub Copilot CLI",
	"kind": "coding-agent",
	"binaries": ["copilot"],
	"configPaths": [".config/gh-copilot"],
	"command": "copilot",
	"seat": 40,
	"runtime": { "adapter": "cli", "prompt": { "placement": "trailing-arg", "prefixArgs": ["-p"] } },
	"config": {
		"format": "note",
		"path": ".config/gh-copilot",
		"summary": "set Copilot CLI OpenAI-compatible base URL to the Station surface",
		"after": "base_url={{openaiUrl}}\nenv_key={{envKey}}"
	}
}
