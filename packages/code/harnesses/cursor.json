{
	"id": "cursor",
	"label": "Cursor Agent",
	"kind": "coding-agent",
	"binaries": ["cursor-agent"],
	"configPaths": [".cursor"],
	"command": "cursor-agent",
	"seat": 30,
	"config": {
		"format": "note",
		"path": ".cursor",
		"summary": "Cursor keeps keys in its account store — set Override OpenAI Base URL in Settings → Models",
		"after": "OPENAI_BASE_URL={{openaiUrl}}\n{{envKey}}=<session-ref>"
	}
}
