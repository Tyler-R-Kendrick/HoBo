{
	"id": "gemini",
	"label": "Gemini CLI",
	"kind": "coding-agent",
	"binaries": ["gemini"],
	"configPaths": [".gemini"],
	"command": "gemini",
	"seat": 50,
	"config": {
		"format": "note",
		"path": ".gemini",
		"summary": "set Gemini CLI OpenAI-compatible base URL to the Station surface",
		"after": "base_url={{openaiUrl}}\nenv_key={{envKey}}"
	}
}
