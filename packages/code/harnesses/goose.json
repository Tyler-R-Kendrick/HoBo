{
	"id": "goose",
	"label": "goose",
	"kind": "coding-agent",
	"binaries": ["goose"],
	"configPaths": [".config/goose"],
	"command": "goose",
	"seat": 70,
	"runtime": { "adapter": "cli", "prompt": { "placement": "trailing-arg", "prefixArgs": ["run", "-t"] } },
	"config": {
		"format": "note",
		"path": ".config/goose",
		"summary": "set goose OpenAI-compatible base URL to the Station surface",
		"after": "base_url={{openaiUrl}}\nenv_key={{envKey}}"
	}
}
