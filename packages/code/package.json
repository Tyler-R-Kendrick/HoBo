{
	"name": "@hobo/code",
	"version": "0.0.1",
	"license": "MIT",
	"description": "HoBo Code: opinionated coding harness and distributed compute. Binary hobo-code (dispatch default; flat verbs; Herdr-style status chrome with column headers; OpenUI step rail + lock seal).",
	"type": "module",
	"bin": {
		"hobo-code": "./bin/hobo-code.mjs"
	},
	"files": [
		"LICENSE",
		"dist",
		"bin",
		"templates",
		"examples",
		"assets",
		"harnesses"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@bufbuild/protobuf": "2.12.1",
		"@earendil-works/pi-coding-agent": "^0.83.0",
		"@earendil-works/pi-tui": "^0.83.0",
		"@flue/runtime": "1.0.0-beta.9",
		"@hobo/core": "workspace:*",
		"@hobo/evals": "workspace:*",
		"@hobo/fuzz": "workspace:*",
		"@hobo/identity": "workspace:*",
		"@hobo/patterns": "workspace:*",
		"@hobo/rift": "workspace:*",
		"@hobo/replay": "workspace:*",
		"@hobo/runtime-local": "workspace:*",
		"@hobo/stations": "workspace:*",
		"@hobo/status-page": "workspace:*",
		"@xterm/headless": "^6.0.0",
		"just-bash": "^3.2.0",
		"valibot": "^1.4.2"
	},
	"optionalDependencies": {
		"@ai-sdk/harness": "^1.0.74",
		"@ai-sdk/harness-claude-code": "^1.0.77",
		"@ai-sdk/harness-codex": "^1.0.76",
		"@ai-sdk/harness-grok-build": "^1.0.11",
		"@ai-sdk/harness-opencode": "^1.0.75",
		"@ai-sdk/harness-pi": "^1.0.76",
		"@ai-sdk/sandbox-just-bash": "^1.0.74"
	},
	"devDependencies": {
		"@flue/cli": "1.0.0-beta.9",
		"@types/node": "^22.15.29",
		"typescript": "^6.0.3",
		"vitest": "^4.1.9"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"postbuild": "node -e \"require('node:fs').chmodSync('dist/bin/hobo-code.js', 0o755); require('node:fs').chmodSync('bin/hobo-code.mjs', 0o755)\"",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"pretest": "pnpm run build",
		"test": "vitest run",
		"gen:bo-idle-tui": "node --import tsx scripts/gen-bo-idle-tui.mts",
		"hobo-code": "node ./bin/hobo-code.mjs"
	}
}
