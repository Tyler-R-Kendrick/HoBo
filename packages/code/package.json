{
	"name": "@hobo/code",
	"version": "0.0.1",
	"license": "MIT",
	"description": "HoBo Code: opinionated coding harness and distributed compute. Binary hobo-code (dispatch default; flat verbs; Herdr-style status chrome with column headers; OpenUI step rail + lock seal).",
	"type": "module",
	"bin": {
		"hobo-code": "./bin/hobo-code.mjs"
	},
	"files": [
		"LICENSE",
		"dist",
		"bin",
		"templates",
		"assets"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@earendil-works/pi-coding-agent": "^0.83.0",
		"@earendil-works/pi-tui": "^0.83.0",
		"@flue/runtime": "1.0.0-beta.9",
		"@hobo/core": "workspace:*",
		"@hobo/rift": "workspace:*",
		"@hobo/stations": "workspace:*",
		"valibot": "^1.4.2"
	},
	"devDependencies": {
		"@flue/cli": "1.0.0-beta.9",
		"@types/node": "^22.15.29",
		"typescript": "^6.0.3",
		"vitest": "^4.1.9"
	},
	"scripts": {
		"prebuild": "pnpm --filter @hobo/core build && pnpm --filter @hobo/stations build",
		"build": "tsc -p tsconfig.json",
		"postbuild": "node -e \"require('node:fs').chmodSync('dist/bin/hobo-code.js', 0o755); require('node:fs').chmodSync('bin/hobo-code.mjs', 0o755)\"",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"pretest": "pnpm run build",
		"test": "vitest run",
		"gen:bo-idle-tui": "node --import tsx scripts/gen-bo-idle-tui.mts",
		"hobo-code": "node ./bin/hobo-code.mjs"
	}
}
