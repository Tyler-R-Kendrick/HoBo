/**
 * Generate packages/code/src/_generated/bo-idle-tui-frames.ts from the
 * bo-idle sprite strip via the shipped sprite→TUI converter.
 *
 *   node --import tsx packages/code/scripts/gen-bo-idle-tui.mts
 */
import { mkdirSync, readFileSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import {
	decodeGrayAlphaPng,
	measureTuiSprite,
	spriteStripToTuiFrames,
} from "../src/sprite-tui.js";

const here = dirname(fileURLToPath(import.meta.url));
const pkgRoot = join(here, "..");
const pngPath = join(pkgRoot, "assets", "bo-idle.png");
const outPath = join(pkgRoot, "src", "_generated", "bo-idle-tui-frames.ts");

const COLS = 24;
const ROWS = 14;
const FRAME_COUNT = 12;
const MODE = "half-block" as const;

const img = decodeGrayAlphaPng(readFileSync(pngPath));
const frames = spriteStripToTuiFrames(img, FRAME_COUNT, {
	cols: COLS,
	rows: ROWS,
	mode: MODE,
	alphaMin: 40,
});

for (const [i, f] of frames.entries()) {
	const m = measureTuiSprite(f);
	if (!m.fixed || m.lines !== ROWS || m.width !== COLS) {
		throw new Error(`frame ${i} geometry ${JSON.stringify(m)}`);
	}
}

const body = frames
	.map((f, i) => `\t// frame ${i}\n\t${JSON.stringify(f)}`)
	.join(",\n");

const out = `/**
 * AUTO-GENERATED by packages/code/scripts/gen-bo-idle-tui.mts
 * Source: packages/code/assets/bo-idle.png (site/public/parallax/bo-idle.png)
 * Converter: sprite-tui.ts (half-block · ${COLS}×${ROWS} · ${FRAME_COUNT} frames)
 * Do not hand-edit — re-run generator after sprite changes.
 */
export const BO_IDLE_TUI_COLS = ${COLS} as const;
export const BO_IDLE_TUI_ROWS = ${ROWS} as const;
export const BO_IDLE_TUI_MODE = "${MODE}" as const;
export const BO_IDLE_TUI_SOURCE = "assets/bo-idle.png" as const;
export const BO_IDLE_TUI_FRAMES: readonly string[] = Object.freeze([
${body}
]);
`;

mkdirSync(dirname(outPath), { recursive: true });
writeFileSync(outPath, out);
console.log(`wrote ${outPath} (${frames.length} frames, ${COLS}×${ROWS})`);
console.log("--- rest ---");
console.log(frames[0]);
console.log("--- bounce ---");
console.log(frames[3]);
console.log("--- blink ---");
console.log(frames[11]);
