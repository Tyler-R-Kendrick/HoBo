/**
 * Generate packages/code/src/_generated/hobo-logo-tui.ts from the Chewy
 * "HoBo" wordmark PNG via the shipped sprite→TUI converter.
 *
 *   node --import tsx packages/code/scripts/gen-logo-tui.mts
 *
 * Source asset: packages/code/assets/hobo-logo.png — rendered from the
 * site's display font (Chewy, see site/src/styles/global.css --font-display)
 * at 220px, 8-bit gray+alpha (PNG ct=4), dark ink on transparent.
 */
import { readFileSync, writeFileSync, mkdirSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import {
	decodeGrayAlphaPng,
	measureTuiSprite,
	spriteStripToTuiFrames,
} from "../src/sprite-tui.js";

const here = dirname(fileURLToPath(import.meta.url));
const pkgRoot = join(here, "..");
const pngPath = join(pkgRoot, "assets", "hobo-logo.png");
const outPath = join(pkgRoot, "src", "_generated", "hobo-logo-tui.ts");

const COLS = 64;
const ROWS = 15;
const MODE = "half-block" as const;

const img = decodeGrayAlphaPng(readFileSync(pngPath));
const frames = spriteStripToTuiFrames(img, 1, {
	cols: COLS,
	rows: ROWS,
	mode: MODE,
	alphaMin: 40,
});

const frame = frames[0]!;
const m = measureTuiSprite(frame);
if (!m.fixed || m.lines !== ROWS || m.width !== COLS) {
	throw new Error(`logo geometry ${JSON.stringify(m)}`);
}

const out = `/**
 * AUTO-GENERATED by packages/code/scripts/gen-logo-tui.mts
 * Source: packages/code/assets/hobo-logo.png (Chewy wordmark — the site's
 * --font-display logo font, site/src/styles/global.css)
 * Converter: sprite-tui.ts (half-block · ${COLS}×${ROWS} · single frame)
 * Do not hand-edit — re-run generator after logo changes.
 */
export const HOBO_LOGO_TUI_COLS = ${COLS} as const;
export const HOBO_LOGO_TUI_ROWS = ${ROWS} as const;
export const HOBO_LOGO_TUI_MODE = "${MODE}" as const;
export const HOBO_LOGO_TUI_SOURCE = "assets/hobo-logo.png" as const;
export const HOBO_LOGO_TUI: string = ${JSON.stringify(frame)};
`;

mkdirSync(dirname(outPath), { recursive: true });
writeFileSync(outPath, out);
console.log(`wrote ${outPath} (${COLS}×${ROWS})`);
console.log(frame);
