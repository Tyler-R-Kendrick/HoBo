{
	"name": "@hobo/conformance",
	"version": "0.0.1",
	"license": "MIT",
	"type": "module",
	"files": [
		"LICENSE",
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./runtime-port": {
			"types": "./dist/suites/runtime-port/index.d.ts",
			"default": "./dist/suites/runtime-port/index.js"
		},
		"./component-host": {
			"types": "./dist/suites/component-host/index.d.ts",
			"default": "./dist/suites/component-host/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@hobo/core": "workspace:*",
		"@hobo/runtime": "workspace:*"
	},
	"devDependencies": {
		"@hobo/provider-kafka": "workspace:*",
		"@hobo/runtime-dapr": "workspace:*",
		"@types/node": "^22.15.3",
		"tsx": "^4.20.3"
	},
	"scripts": {
		"build": "pnpm --filter @hobo/core build && pnpm --filter @hobo/runtime build && tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"pretest": "pnpm --filter @hobo/core build && pnpm --filter @hobo/runtime build && pnpm --filter @hobo/runtime-local build && pnpm --filter @hobo/provider-kafka build && pnpm --filter @hobo/runtime-dapr build",
		"build-corpus": "node --import tsx src/corpus/record.ts",
		"test": "vitest run",
		"test:contract:consumer": "vitest run contracts/consumer"
	}
}
