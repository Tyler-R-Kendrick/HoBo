{
	"name": "@hobo/conformance",
	"version": "0.0.1",
	"license": "MIT",
	"type": "module",
	"files": [
		"LICENSE",
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./runtime-port": {
			"types": "./dist/suites/runtime-port/index.d.ts",
			"default": "./dist/suites/runtime-port/index.js"
		},
		"./component-host": {
			"types": "./dist/suites/component-host/index.d.ts",
			"default": "./dist/suites/component-host/index.js"
		},
		"./anonymous": {
			"types": "./dist/suites/anonymous/index.d.ts",
			"default": "./dist/suites/anonymous/index.js"
		},
		"./live": {
			"types": "./dist/live/index.d.ts",
			"default": "./dist/live/index.js"
		},
		"./provider-lifecycle": {
			"types": "./dist/provider-lifecycle.d.ts",
			"default": "./dist/provider-lifecycle.js"
		}
	},
	"bin": {
		"hobo-conformance-live": "./dist/live/cli.js"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@hobo/bindings": "workspace:*",
		"@hobo/capability-profiles": "workspace:*",
		"@hobo/claims": "workspace:*",
		"@hobo/core": "workspace:*",
		"@hobo/runtime": "workspace:*",
		"@hobo/trust": "workspace:*"
	},
	"devDependencies": {
		"@hobo/provider-kafka": "workspace:*",
		"@hobo/runtime-dapr": "workspace:*",
		"@types/node": "^22.15.3",
		"tsx": "^4.20.3"
	},
	"scripts": {
		"build": "pnpm --filter @hobo/core build && pnpm --filter @hobo/runtime build && pnpm --filter @hobo/capability-profiles build && pnpm --filter @hobo/trust build && pnpm --filter @hobo/bindings build && pnpm --filter @hobo/claims build && tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"pretest": "pnpm --filter @hobo/core build && pnpm --filter @hobo/runtime build && pnpm --filter @hobo/runtime-local build && pnpm --filter @hobo/provider-kafka build && pnpm --filter @hobo/runtime-dapr build && pnpm --filter @hobo/capability-profiles build && pnpm --filter @hobo/trust build && pnpm --filter @hobo/bindings build && pnpm --filter @hobo/claims build",
		"build-corpus": "node --import tsx src/corpus/record.ts",
		"conformance:live": "node --import tsx src/live/cli.ts",
		"test": "vitest run",
		"test:contract:consumer": "vitest run contracts/consumer"
	}
}
