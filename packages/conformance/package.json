{
	"name": "@hobo/conformance",
	"version": "0.0.1",
	"type": "module",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@hobo/core": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^22.15.3",
		"tsx": "^4.20.3"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"pretest": "pnpm --filter @hobo/core build",
		"test": "vitest run --passWithNoTests",
		"test:contract:consumer": "vitest run --passWithNoTests contracts/consumer"
	}
}
