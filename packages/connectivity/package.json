{
	"name": "@hobo/connectivity",
	"version": "0.0.1",
	"license": "MIT",
	"description": "HoBo multi-tenant connectivity foundations: hierarchical naming helpers, overlay (Tailscale/Netbird), pluggable DNS, PolicyEngine, metering, and local named endpoints (portless optional).",
	"type": "module",
	"files": [
		"LICENSE",
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@hobo/core": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^22.15.29",
		"vitest": "^4.1.9"
	},
	"scripts": {
		"prebuild": "pnpm --filter @hobo/core build",
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"pretest": "pnpm run build",
		"test": "vitest run"
	}
}
