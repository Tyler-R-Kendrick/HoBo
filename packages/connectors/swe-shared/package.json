{
	"name": "@hobo/swe-shared",
	"version": "0.0.1",
	"license": "MIT",
	"type": "module",
	"private": true,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"pretest": "node --experimental-strip-types ../../../scripts/ensure-built.mts",
		"test": "vitest run"
	},
	"dependencies": {
		"@bufbuild/protobuf": "2.12.1",
		"@hobo/connector-acp": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^22.15.29",
		"typescript": "^6.0.3",
		"vitest": "^4.1.9"
	},
	"description": "Shared SWE-task session shape, sandbox access reports, and guardrail defaults for vendor swe-* ACP adapters."
}
