{
	"consumer": { "name": "@hobo/control-yard" },
	"provider": { "name": "@hobo/control-api" },
	"interactions": [
		{
			"description": "GET yard snapshot after station init",
			"request": {
				"method": "GET",
				"path": "/v1/yard/snapshot",
				"query": { "stationId": "station:local" }
			},
			"response": {
				"status": 200,
				"body": {
					"ok": true,
					"code": "HOBO_OK",
					"data": {
						"occupancy": { "stationId": "station:local", "status": "open" },
						"rails": [],
						"connections": [],
						"metering": { "trafficRate": 0 },
						"seq": 0
					}
				}
			}
		},
		{
			"description": "POST connection create through management path",
			"request": {
				"method": "POST",
				"path": "/v1/connection/create",
				"body": {
					"provider": "asana",
					"alias": "work",
					"stationId": "station:local"
				}
			},
			"response": {
				"status": 200,
				"body": {
					"ok": true,
					"data": {
						"connection": {
							"provider": "asana",
							"status": "pending",
							"stationId": "station:local"
						}
					}
				}
			}
		},
		{
			"description": "POST station rails activate",
			"request": {
				"method": "POST",
				"path": "/v1/station/rails/activate",
				"body": { "hashOrId": "sha256:deadbeef", "stationId": "station:local" }
			},
			"response": {
				"status": 200,
				"body": { "ok": true }
			}
		},
		{
			"description": "GET broker status",
			"request": {
				"method": "GET",
				"path": "/v1/broker/status",
				"query": { "stationId": "station:local" }
			},
			"response": {
				"status": 200,
				"body": { "ok": true, "data": { "ok": true } }
			}
		},
		{
			"description": "GET world snapshot returns the yard-world read model with demo provenance",
			"request": {
				"method": "GET",
				"path": "/v1/world/snapshot"
			},
			"response": {
				"status": 200,
				"body": {
					"ok": true,
					"data": {
						"world": {
							"tick": 0,
							"stations": {},
							"layouts": {},
							"yards": {},
							"camps": {},
							"junctions": {},
							"characters": {},
							"packets": {}
						},
						"demo": false,
						"seed": null
					}
				}
			}
		},
		{
			"description": "GET world stream opens an SSE stream: world-snapshot event first, then world deltas",
			"request": {
				"method": "GET",
				"path": "/v1/world/stream"
			},
			"response": {
				"status": 200,
				"headers": { "Content-Type": "text/event-stream; charset=utf-8" }
			}
		},
		{
			"description": "GET deployment view with no local cloud event source returns an honest empty view",
			"request": {
				"method": "GET",
				"path": "/v1/deployments/view"
			},
			"response": {
				"status": 200,
				"body": {
					"ok": true,
					"code": "HOBO_OK",
					"data": {
						"available": false,
						"source": "none",
						"yards": [],
						"deployments": [],
						"count": 0,
						"seq": 0
					}
				}
			}
		},
		{
			"description": "GET credential audit with no local credential event source returns an honest empty view",
			"request": {
				"method": "GET",
				"path": "/v1/audit/credentials"
			},
			"response": {
				"status": 200,
				"body": {
					"ok": true,
					"code": "HOBO_OK",
					"data": {
						"available": false,
						"sources": [],
						"rows": [],
						"count": 0,
						"seq": 0
					}
				}
			}
		},
		{
			"description": "POST OTLP/JSON traces are mapped through @hobo/yard-world into the world read model",
			"request": {
				"method": "POST",
				"path": "/v1/otlp/v1/traces",
				"headers": { "Content-Type": "application/json" },
				"body": { "resourceSpans": [] }
			},
			"response": {
				"status": 200,
				"body": { "ok": true, "data": { "accepted": 0, "demo": false } }
			}
		}
	],
	"metadata": {
		"pactSpecification": { "version": "3.0.0" }
	}
}
