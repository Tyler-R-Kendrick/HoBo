{
	"name": "@hobo/control-yard",
	"version": "0.0.1",
	"license": "MIT",
	"description": "HoBo Yard: Phaser 3 control-plane game UI with OpenUI generative overlays.",
	"type": "module",
	"files": [
		"LICENSE",
		"dist",
		"assets"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./assets/*": "./assets/*"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@hobo/control-api": "workspace:*",
		"@hobo/management": "workspace:*",
		"@hobo/yard-world": "workspace:*",
		"phaser": "3.87.0"
	},
	"devDependencies": {
		"@types/node": "^22.15.29",
		"esbuild": "^0.28.1",
		"typescript": "^6.0.3",
		"vitest": "^4.1.9"
	},
	"scripts": {
		"prebuild": "pnpm --filter @hobo/management build",
		"build": "tsc -p tsconfig.json",
		"bundle": "esbuild src/main.ts --bundle --format=esm --platform=browser --minify --outfile=public/dist/yard.js --log-level=warning",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"pretest": "pnpm run build && pnpm run assets:validate",
		"test": "vitest run",
		"preplay": "pnpm run bundle",
		"preserve": "pnpm run bundle",
		"preevidence": "pnpm run bundle",
		"assets:validate": "node --import tsx ./scripts/validate-assets.mts",
		"assets:probe": "node --import tsx ./scripts/probe-sheet.mts",
		"assets:sizes": "uv run ../../.agents/skills/gamedev-assets/scripts/asset_sizes.py --root ./assets --json ./tmp/asset_sizes.json",
		"assets:coverage": "uv run ../../.agents/skills/gamedev-assets/scripts/asset_manifest_check.py --manifest ./assets/assets_index.json --root ./assets --json ./tmp/coverage.json",
		"assets:extract-frames": "node --import tsx ./scripts/extract-anim-frames.mts",
		"play": "node --import tsx ./scripts/play-demo.mts",
		"evidence": "node --import tsx ./scripts/play-demo.mts && node --import tsx ./scripts/evidence-check.mts",
		"evidence:check": "node --import tsx ./scripts/evidence-check.mts",
		"serve": "node --import tsx ./scripts/serve-demo.mts",
		"play:anim": "echo open public/anim-test.html via pnpm run serve"
	}
}
