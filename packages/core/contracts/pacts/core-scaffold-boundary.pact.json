{
	"consumer": { "name": "WorkspaceSkeleton" },
	"provider": { "name": "CoreScaffoldBoundary" },
	"interactions": [
		{
			"description": "core scaffold exposes package identity for workspace validation",
			"request": { "method": "GET", "path": "/core/scaffold" },
