{"method":"canonicalJson","name":"trailing newline is load-bearing","input":[{}],"expect":"{}\n"}
{"method":"canonicalJson","name":"insensitive to written key order","input":[{"a":1,"b":2}],"expect":"{\n  \"a\": 1,\n  \"b\": 2\n}\n"}
