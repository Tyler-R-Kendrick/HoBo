# parsePluginManifest — a plugin manifest is third-party input, so refusals are the surface.
{"method": "parsePluginManifest", "name": "parses and freezes a valid manifest", "input": [{"schema": "hobo.plugin/v1", "entry": "./dist/plugin.js", "extensions": [{"point": "hobo.cloud-provider/v1", "export": "createAcmeProvider"}]}], "subset": {"schema": "hobo.plugin/v1", "entry": "./dist/plugin.js", "extensions": [{"point": "hobo.cloud-provider/v1", "export": "createAcmeProvider"}]}}
{"method": "parsePluginManifest", "name": "refuses a wrong schema id", "input": [{"schema": "hobo.plugin/v2", "entry": "./dist/plugin.js", "extensions": [{"point": "hobo.cloud-provider/v1", "export": "createAcmeProvider"}]}], "throwsSubset": {"name": "PluginManifestParseError"}}
{"method": "parsePluginManifest", "name": "refuses a missing schema id", "input": [{"entry": "./dist/plugin.js", "extensions": [{"point": "hobo.cloud-provider/v1", "export": "createAcmeProvider"}]}], "throwsSubset": {"name": "PluginManifestParseError"}}
{"method": "parsePluginManifest", "name": "refuses a non-relative entry", "input": [{"schema": "hobo.plugin/v1", "entry": "dist/plugin.js", "extensions": [{"point": "hobo.cloud-provider/v1", "export": "createAcmeProvider"}]}], "throws": "starting with \\./"}
{"method": "parsePluginManifest", "name": "refuses a bare package specifier as entry", "input": [{"schema": "hobo.plugin/v1", "entry": "@acme/other", "extensions": [{"point": "hobo.cloud-provider/v1", "export": "createAcmeProvider"}]}], "throwsSubset": {"name": "PluginManifestParseError"}}
{"method": "parsePluginManifest", "name": "refuses no extensions at all", "input": [{"schema": "hobo.plugin/v1", "entry": "./dist/plugin.js", "extensions": []}], "throwsSubset": {"name": "PluginManifestParseError"}}
{"method": "parsePluginManifest", "name": "refuses an extension point that is not an id", "input": [{"schema": "hobo.plugin/v1", "entry": "./dist/plugin.js", "extensions": [{"point": "not-an-id", "export": "x"}]}], "throws": "hobo\\.<name>/v<major>"}
{"method": "parsePluginManifest", "name": "refuses duplicate (point, export) pairs", "input": [{"schema": "hobo.plugin/v1", "entry": "./dist/plugin.js", "extensions": [{"point": "hobo.cloud-provider/v1", "export": "createAcmeProvider"}, {"point": "hobo.cloud-provider/v1", "export": "createAcmeProvider"}]}], "throws": "unique \\(point, export\\)"}
{"method": "parsePluginManifest", "name": "refuses an extra key on an extension", "input": [{"schema": "hobo.plugin/v1", "entry": "./dist/plugin.js", "extensions": [{"point": "hobo.cloud-provider/v1", "export": "x", "factory": "y"}]}], "throwsSubset": {"name": "PluginManifestParseError"}}
{"method": "parsePluginManifest", "name": "refuses an unknown top-level key", "input": [{"schema": "hobo.plugin/v1", "entry": "./dist/plugin.js", "extensions": [{"point": "hobo.cloud-provider/v1", "export": "createAcmeProvider"}], "autoload": true}], "throwsSubset": {"name": "PluginManifestParseError"}}
# parsePluginPackageJson / isPluginPackageJson — telling 'not a plugin' from 'broken plugin'.
{"method": "parsePluginPackageJson", "name": "parses a plugin package.json", "input": [{"name": "@acme/hobo-provider-acme", "hobo": {"schema": "hobo.plugin/v1", "entry": "./dist/plugin.js", "extensions": [{"point": "hobo.cloud-provider/v1", "export": "createAcmeProvider"}]}}], "subset": {"packageName": "@acme/hobo-provider-acme", "plugin": {"extensions": [{"point": "hobo.cloud-provider/v1"}]}}}
{"method": "parsePluginPackageJson", "name": "a package with no hobo block is not a plugin", "input": [{"name": "@acme/plain"}], "throws": "not a HoBo plugin package"}
{"method": "parsePluginPackageJson", "name": "a malformed hobo block is a broken plugin, not a non-plugin", "input": [{"name": "@acme/p", "hobo": {"schema": "nope"}}], "throwsSubset": {"name": "PluginManifestParseError"}}
{"method": "isPluginPackageJson", "name": "false for a plain package", "input": [{"name": "@acme/plain"}], "expect": false}
{"method": "isPluginPackageJson", "name": "true for one carrying a hobo block", "input": [{"name": "@acme/p", "hobo": {"schema": "hobo.plugin/v1", "entry": "./dist/plugin.js", "extensions": [{"point": "hobo.cloud-provider/v1", "export": "createAcmeProvider"}]}}], "expect": true}
