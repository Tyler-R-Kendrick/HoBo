{
	"consumer": {
		"name": "RoutingControlLoopConsumer"
	},
	"provider": {
		"name": "DispatcherDecisionBoundary"
	},
	"interactions": [
		{
			"description": "budget-pressured traffic dispatch selects the cheapest in-budget backend",
			"request": {
				"method": "POST",
				"path": "/dispatcher/decide",
				"body": {
					"category": "traffic-backend",
					"objective": "maximize-credits",
					"units": 100
				}
			},
			"response": {
				"status": 200,
				"body": {
					"ok": true,
					"selectedProvider": "lakebed-cheap",
					"dispatchEvent": { "type": "dispatch.Decided" }
				}
			}
		},
		{
			"description": "no registered candidates fails closed without a dispatch.Decided fact",
			"request": {
				"method": "POST",
				"path": "/dispatcher/decide",
				"body": {
					"category": "runner",
					"objective": "maximize-credits"
				}
			},
			"response": {
				"status": 200,
				"body": {
					"ok": false,
					"reason": "no registered runner candidates"
				}
			}
		},
		{
			"description": "all registered hosting backends exceed the hard budget and no decision fact is emitted",
			"request": {
				"method": "POST",
				"path": "/dispatcher/decide",
				"body": { "category": "traffic-backend", "objective": "maximize-credits", "units": 2 }
			},
			"response": {
				"status": 200,
				"body": { "ok": false, "reason": "no eligible candidates within budget and capacity" }
			}
		}
	],
	"metadata": {
		"pactSpecification": {
			"version": "3.0.0"
		}
	}
}
