{
	"consumer": { "name": "HoboVercelDeploy" },
	"provider": { "name": "VercelApi" },
	"interactions": [
		{
			"description": "a project nobody created is a 404 with Vercel's error envelope",
			"providerStates": [{ "name": "no project hobo-pact-site exists" }],
			"request": {
				"method": "GET",
				"path": "/v9/projects/hobo-pact-site",
				"headers": { "authorization": "Bearer hobo_pact_token" }
			},
			"response": {
				"status": 404,
				"body": { "error": { "code": "not_found" } }
			}
		},
		{
			"description": "create the project",
			"providerStates": [{ "name": "no project hobo-pact-site exists" }],
			"request": {
				"method": "POST",
				"path": "/v9/projects",
				"headers": {
					"authorization": "Bearer hobo_pact_token",
					"content-type": "application/json"
				},
				"body": { "name": "hobo-pact-site" }
			},
			"response": {
