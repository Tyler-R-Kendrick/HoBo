{
	"name": "@hobo/hobo",
	"version": "0.0.1",
	"license": "MIT",
	"description": "HoBo composition-root app: wires the default LOCAL/MOCKED runtimes so the composed `hobo` binary runs the cloud verbs (collect/plan/up/down/dev) end to end without shell stubs.",
	"type": "module",
	"bin": {
		"hobo": "./dist/bin/hobo.js",
		"hobo-mcp": "./dist/bin/hobo-mcp.js"
	},
	"files": [
		"LICENSE",
		"CI.md",
		"dist",
		"wit"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@bytecodealliance/jco": "1.24.3",
		"@bufbuild/protobuf": "2.12.1",
		"@hobo/adapter-opensesame": "workspace:*",
		"@hobo/auth-md": "workspace:*",
		"@hobo/bindings": "workspace:*",
		"@hobo/bindles": "workspace:*",
		"@hobo/broker": "workspace:*",
		"@hobo/camps": "workspace:*",
		"@hobo/capability-profiles": "workspace:*",
		"@hobo/claims": "workspace:*",
		"@hobo/ci-gh-actions": "workspace:*",
		"@hobo/cli": "workspace:*",
		"@hobo/cloud": "workspace:*",
		"@hobo/code": "workspace:*",
		"@hobo/conformance": "workspace:*",
		"@hobo/connectivity": "workspace:*",
		"@hobo/contracts": "workspace:*",
		"@hobo/control-api": "workspace:*",
		"@hobo/core": "workspace:*",
		"@hobo/data": "workspace:*",
		"@hobo/iac-pulumi": "workspace:*",
		"@hobo/identity": "workspace:*",
		"@hobo/management": "workspace:*",
		"@hobo/mcp": "workspace:*",
		"@hobo/policy": "workspace:*",
		"@hobo/provider-aws": "workspace:*",
		"@hobo/provider-azure": "workspace:*",
		"@hobo/provider-cloudflare": "workspace:*",
		"@hobo/provider-digitalocean": "workspace:*",
		"@hobo/provider-gcp": "workspace:*",
		"@hobo/provider-hetzner": "workspace:*",
		"@hobo/provider-hostinger": "workspace:*",
		"@hobo/provider-kafka": "workspace:*",
		"@hobo/provider-kubernetes": "workspace:*",
		"@hobo/provider-lakebed": "workspace:*",
		"@hobo/provider-neon": "workspace:*",
		"@hobo/provider-netlify": "workspace:*",
		"@hobo/provider-prisma-postgres": "workspace:*",
		"@hobo/provider-ttl-sh": "workspace:*",
		"@hobo/provider-upstash": "workspace:*",
		"@hobo/provider-vercel": "workspace:*",
		"@hobo/recipes": "workspace:*",
		"@hobo/replay": "workspace:*",
		"@hobo/runner-blacksmith": "workspace:*",
		"@hobo/runner-depot": "workspace:*",
		"@hobo/runner-github": "workspace:*",
		"@hobo/runtime-cloud-native": "workspace:*",
		"@hobo/runtime-dapr": "workspace:*",
		"@hobo/runtime-local": "workspace:*",
		"@hobo/runtime-oci": "workspace:*",
		"@hobo/runtime-wasm": "workspace:*",
		"@hobo/stations": "workspace:*",
		"@hobo/trails": "workspace:*",
		"@hobo/trust": "workspace:*",
		"@hobo/yards": "workspace:*",
		"esbuild": "^0.25.0",
		"tsx": "4.22.4"
	},
	"devDependencies": {
		"@hobo/ci": "workspace:*",
		"@hobo/contract-harness": "workspace:*",
		"@hobo/example-hello-bindle": "workspace:*",
		"@hobo/testing": "workspace:*",
		"@types/pg": "8.15.5",
		"pg": "8.22.0"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"test": "vitest run",
		"pretest:ci-e2e": "node --experimental-strip-types ../../scripts/ensure-built.mts",
		"test:ci-e2e": "vitest run --config vitest.ci-e2e.config.ts"
	}
}
