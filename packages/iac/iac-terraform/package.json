{
	"name": "@hobo/iac-terraform",
	"version": "0.0.1",
	"license": "MIT",
	"description": "HoBo HCL-lane IacProvider: one adapter driving the OpenTofu (default) or Terraform binary over per-resource workspaces (HOBO-717).",
	"type": "module",
	"private": true,
	"files": [
		"LICENSE",
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@hobo/core": "workspace:*"
	},
	"scripts": {
		"prebuild": "pnpm --filter @hobo/core build",
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"pretest": "pnpm run build",
		"test": "vitest run",
		"test:contract:consumer": "vitest run contracts/consumer"
	}
}
