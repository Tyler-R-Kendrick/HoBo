{
	"consumer": { "name": "@hobo/control-api" },
	"provider": { "name": "@hobo/management" },
	"interactions": [
		{
			"description": "station init creates open occupancy with bootstrap rail",
			"request": {
				"method": "POST",
				"path": "/management/station/init",
				"body": { "name": "local", "tenant": "local" }
			},
			"response": {
				"status": 200,
				"body": {
					"ok": true,
					"data": {
						"stationId": "station:local",
						"created": true,
						"bootstrapActive": true
					}
				}
			}
		},
		{
			"description": "yard projection snapshot includes occupancy rails connections metering",
			"request": {
				"method": "GET",
				"path": "/management/yard/snapshot",
				"query": { "stationId": "station:local" }
			},
			"response": {
				"status": 200,
				"body": {
					"ok": true,
					"data": {
						"occupancy": { "stationId": "station:local", "status": "open" },
						"rails": [],
						"connections": [],
						"metering": { "quotaUsed": 0, "quotaLimit": 0 },
						"seq": 0
					}
				}
			}
		},
		{
			"description": "connection create requires station context and returns pending",
			"request": {
				"method": "POST",
				"path": "/management/connection/create",
				"body": {
					"provider": "asana",
					"stationId": "station:local",
					"alias": "work"
				}
			},
			"response": {
				"status": 200,
				"body": {
					"ok": true,
					"data": {
						"connection": {
							"provider": "asana",
							"status": "pending",
							"stationId": "station:local"
						}
					}
				}
			}
		},
		{
			"description": "deployment view with no local cloud event source is an honest empty view",
			"request": {
				"method": "GET",
				"path": "/management/deployments/view"
			},
			"response": {
				"status": 200,
				"body": {
					"ok": true,
					"code": "HOBO_OK",
					"data": {
						"available": false,
						"source": "none",
						"yards": [],
						"deployments": [],
						"count": 0,
						"seq": 0
					}
				}
			}
		},
		{
			"description": "credential audit folds the local connection store when present",
			"request": {
				"method": "GET",
				"path": "/management/audit/credentials"
			},
			"response": {
				"status": 200,
				"body": {
					"ok": true,
					"code": "HOBO_OK",
					"data": {
						"available": true,
						"sources": ["connections-store"],
						"rows": [
							{
								"correlationId": "corr-connection-conn-1",
								"connectionIds": ["conn-1"],
								"grantCount": 0
							}
						],
						"count": 1
					}
				}
			}
		}
	],
	"metadata": {
		"pactSpecification": { "version": "3.0.0" }
	}
}
