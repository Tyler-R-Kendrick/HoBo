{
	"name": "@hobo/management",
	"version": "0.0.1",
	"license": "MIT",
	"description": "Pure Station/Connection/Broker management functions shared by CLI, MCP, and the control-plane game UI.",
	"type": "module",
	"files": ["LICENSE", "dist"],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@hobo/identity": "workspace:*",
		"@hobo/stations": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^22.15.29",
		"typescript": "^6.0.3",
		"vitest": "^4.1.9"
	},
	"scripts": {
		"prebuild": "pnpm --filter @hobo/stations build && pnpm --filter @hobo/identity build",
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"pretest": "pnpm run build",
		"test": "vitest run"
	}
}
