{
	"consumer": { "name": "hobo-planner" },
	"provider": { "name": "hobo-resource-intent-declaration" },
	"interactions": [
		{
			"description": "a lowered manifest node crosses the boundary with its bind edges intact",
			"request": {
				"method": "POST",
				"path": "/declarations/hobo.resource-intent/v1",
				"body": {
					"name": "service",
					"port": "compute",
					"require": ["http"],
					"negotiation": "require",
					"deps": ["assets", "sessions"],
					"objective": "min-cost"
				}
			},
			"response": {
				"status": 200,
				"body": {
					"schema": "hobo.resource-intent/v1",
					"accepted": true,
					"canonical": "{\"deps\":[\"assets\",\"sessions\"],\"name\":\"service\",\"negotiation\":\"require\",\"objective\":\"min-cost\",\"port\":\"compute\",\"require\":[\"http\"]}"
				}
			}
		},
		{
			"description": "a declaration that names a provider is refused before it can reach matching",
			"request": {
				"method": "POST",
				"path": "/declarations/hobo.resource-intent/v1",
				"body": {
					"name": "service",
					"port": "compute",
					"negotiation": "require",
					"objective": "min-cost",
					"provider": "neon"
				}
			},
			"response": {
				"status": 422,
				"body": {
					"schema": "hobo.resource-intent/v1",
					"accepted": false,
					"code": "INVALID_RESOURCE_INTENT",
					"path": "$.provider",
					"message": "resource intent $.provider: unknown field; expected one of name, port, require, prefer, negotiation, deps, region, objective, placement"
				}
			}
		},
		{
			"description": "a present-but-empty region is refused rather than decaying into an absent one",
			"request": {
				"method": "POST",
				"path": "/declarations/hobo.resource-intent/v1",
				"body": {
					"name": "service",
					"port": "compute",
					"negotiation": "require",
					"objective": "min-cost",
					"region": ""
				}
			},
			"response": {
				"status": 422,
				"body": {
					"schema": "hobo.resource-intent/v1",
					"accepted": false,
					"code": "INVALID_RESOURCE_INTENT",
					"path": "$.region",
					"message": "resource intent $.region: must not be empty"
				}
			}
		},
		{
			"description": "a placement selector with no operand is refused rather than rejecting every candidate silently",
			"request": {
				"method": "POST",
				"path": "/declarations/hobo.resource-intent/v1",
				"body": {
					"name": "cache",
					"port": "kv",
					"negotiation": "require",
					"objective": "min-cost",
					"placement": {
						"selectors": [{ "key": "region", "op": "eq" }]
					}
				}
			},
			"response": {
				"status": 422,
				"body": {
					"schema": "hobo.resource-intent/v1",
					"accepted": false,
					"code": "INVALID_RESOURCE_INTENT",
					"path": "$.placement.selectors[0].values",
					"message": "resource intent $.placement.selectors[0].values: the \"eq\" operator needs at least one operand"
				}
			}
		}
	]
}
