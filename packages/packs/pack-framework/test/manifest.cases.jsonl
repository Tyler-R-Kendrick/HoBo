# digest pinning — an image reference must name exactly one immutable blob.
{"method":"parsePinnedImageRef","name":"fully qualified digest reference","input":["registry.example.test/example/pack@sha256:1111111111111111111111111111111111111111111111111111111111111111"],"subset":{"registry":"registry.example.test","repositoryPath":"example/pack","digest":"sha256:1111111111111111111111111111111111111111111111111111111111111111"}}
{"method":"parsePinnedImageRef","name":"refuses a moving tag","input":["docker.io/library/postgres:17"],"throwsSubset":{"name":"PackError","code":"PACK_INTEGRITY_UNVERIFIED"}}
{"method":"parsePinnedImageRef","name":"refuses a tag smuggled in alongside a digest","input":["docker.io/library/postgres:17@sha256:1111111111111111111111111111111111111111111111111111111111111111"],"throwsSubset":{"name":"PackError","code":"PACK_INTEGRITY_UNVERIFIED"}}
{"method":"parsePinnedImageRef","name":"requires an explicit registry host so nobody has to guess the default","input":["postgres@sha256:1111111111111111111111111111111111111111111111111111111111111111"],"throwsSubset":{"name":"PackError","code":"PACK_MANIFEST_INVALID"}}
{"method":"parseImageDigest","name":"accepts a full lowercase sha256","input":["sha256:1111111111111111111111111111111111111111111111111111111111111111"],"expect":"sha256:1111111111111111111111111111111111111111111111111111111111111111"}
{"method":"parseImageDigest","name":"refuses a short digest","input":["sha256:abc"],"throwsSubset":{"name":"PackError","code":"PACK_INTEGRITY_UNVERIFIED"}}
{"method":"parseImageDigest","name":"refuses an uppercase digest","input":["SHA256:1111111111111111111111111111111111111111111111111111111111111111"],"throwsSubset":{"name":"PackError","code":"PACK_INTEGRITY_UNVERIFIED"}}
# pack ids
{"method":"parsePackId","name":"parses family and qualifiers","input":["pack.postgres.oci/v1"],"subset":{"family":"postgres","qualifiers":["oci"],"major":1}}
{"method":"parsePackId","name":"rejects an id that is not pack-namespaced","input":["data.postgres/v1"],"throwsSubset":{"name":"PackError","code":"PACK_MANIFEST_INVALID"}}
# parsePackManifest — the fixture, then one rejected patch per rule.
{"method":"parseFixtureManifest","name":"parses the fixture and forces pack realization","input":[],"subset":{"packId":"pack.example.oci/v1","implementsProfiles":[{"realization":"pack"}],"images":[{"architecture":"linux/amd64"},{"architecture":"linux/arm64"}]}}
{"method":"parseFixtureManifest","name":"rejects an unknown schema version as a contract change","input":[{"schemaVersion":"hobo.pack-manifest/v2"}],"throwsSubset":{"name":"PackError","code":"PROVIDER_CONTRACT_CHANGED"}}
{"method":"parseFixtureManifest","name":"rejects an unsupported architecture","input":[{"images":[{"architecture":"linux/riscv64","reference":"registry.example.test/example/pack@sha256:1111111111111111111111111111111111111111111111111111111111111111"}]}],"throwsSubset":{"name":"PackError","code":"ARCHITECTURE_UNSUPPORTED"}}
{"method":"parseFixtureManifest","name":"rejects images pulled from two different repositories","input":[{"images":[{"architecture":"linux/amd64","reference":"registry.example.test/example/pack@sha256:1111111111111111111111111111111111111111111111111111111111111111"},{"architecture":"linux/arm64","reference":"registry.example.test/other/pack@sha256:2222222222222222222222222222222222222222222222222222222222222222"}]}],"throwsSubset":{"name":"PackError","code":"PACK_MANIFEST_INVALID"}}
{"method":"parseFixtureManifest","name":"rejects a persistent pack with no declared volume","input":[{"persistence":{"requirement":"required","volumes":[]}}],"throwsSubset":{"name":"PackError","code":"PACK_MANIFEST_INVALID"}}
{"method":"parseFixtureManifest","name":"rejects a persistent pack that exposes no volume configuration key","input":[{"configSchema":[{"key":"authPasswordRef","kind":"secret-ref","necessity":"required","description":"Locator for the credential minted in secret custody."}]}],"throwsSubset":{"name":"PackError","code":"PACK_MANIFEST_INVALID"}}
{"method":"parseFixtureManifest","name":"rejects a default value on a required configuration key","input":[{"configSchema":[{"key":"dataVolume","kind":"volume-name","necessity":"required","description":"Name of the declared volume that carries durable state.","defaultValue":"data"},{"key":"authPasswordRef","kind":"secret-ref","necessity":"required","description":"Locator for the credential minted in secret custody."}]}],"throwsSubset":{"name":"PackError","code":"PACK_MANIFEST_INVALID"}}
{"method":"parseFixtureManifest","name":"rejects a probe whose timeout exceeds its period","input":[{"probes":{"readiness":{"kind":"tcp","portName":"main","initialDelayMs":0,"periodMs":1000,"timeoutMs":5000,"failureThreshold":3}}}],"throwsSubset":{"name":"PackError","code":"PACK_MANIFEST_INVALID"}}
{"method":"parseFixtureManifest","name":"rejects a probe that references an undeclared port","input":[{"probes":{"readiness":{"kind":"tcp","portName":"nope","initialDelayMs":0,"periodMs":1000,"timeoutMs":500,"failureThreshold":3}}}],"throwsSubset":{"name":"PackError","code":"PACK_MANIFEST_INVALID"}}
# A manifest arriving as JSON can carry any string here; provider-claim is exactly the one that must not survive.
{"method":"parseFixtureManifest","name":"rejects an ownership strategy that implies a provider claim","input":[{"ownership":"provider-claim"}],"throwsSubset":{"name":"PackError","code":"PACK_MANIFEST_INVALID"}}
{"method":"parseFixtureManifest","name":"rejects an operation that asks for a shell","input":[{"operations":[{"id":"example.backup","kind":"backup","description":"Copy durable state out of the volume.","credentialDelivery":"environment","shell":true,"argvBuilderRef":"buildExampleBackupArgv"}]}],"throwsSubset":{"name":"PackError","code":"PACK_MANIFEST_INVALID"}}
{"method":"parseFixtureManifest","name":"rejects provenance with no cited source","input":[{"provenance":{"builder":"example upstream publisher","buildType":"upstream-published","sourceRepository":"https://github.com/example/pack","sourceRevision":"0000000000000000000000000000000000000000","attestationRefs":[],"sourceRefs":[]}}],"throwsSubset":{"name":"PackError","code":"PACK_MANIFEST_INVALID"}}
# Canonical ordering is asserted as a named order, not as "two calls agree".
{"method":"fixtureImageOrder","name":"sorts images regardless of authoring order","input":[{"images":[{"architecture":"linux/arm64","reference":"registry.example.test/example/pack@sha256:2222222222222222222222222222222222222222222222222222222222222222"},{"architecture":"linux/amd64","reference":"registry.example.test/example/pack@sha256:1111111111111111111111111111111111111111111111111111111111111111"}]}],"expect":["linux/amd64","linux/arm64"]}
{"method":"fixtureConfigOrder","name":"sorts config keys regardless of authoring order","input":[],"expect":["authPasswordRef","dataVolume","maxMemoryBytes"]}
# canonicalJson
{"method":"canonicalJson","name":"sorts object keys at every depth but preserves array order","input":[{"b":1,"a":{"d":[3,1,2],"c":true}}],"expect":"{\"a\":{\"c\":true,\"d\":[3,1,2]},\"b\":1}"}
{"method":"canonicalJson","name":"is stable across authoring order","input":[{"a":{"c":true,"d":[3,1,2]},"b":1}],"expect":"{\"a\":{\"c\":true,\"d\":[3,1,2]},\"b\":1}"}
