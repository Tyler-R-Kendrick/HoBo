{
	"name": "@hobo/policy",
	"version": "0.0.1",
	"type": "module",
	"files": ["dist"],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./guardrails": {
			"types": "./dist/agent-guardrails.d.ts",
			"default": "./dist/agent-guardrails.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@types/node": "^22.15.29",
		"vitest": "^4.1.9"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"pretest": "pnpm run build",
		"test": "vitest run",
		"test:contract:consumer": "vitest run contracts/consumer"
	}
}
