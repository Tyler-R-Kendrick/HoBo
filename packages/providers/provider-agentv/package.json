{
	"name": "@hobo/provider-agentv",
	"version": "0.0.1",
	"type": "module",
	"private": true,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "pnpm --filter @hobo/core build && tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"pretest": "pnpm run build && pnpm --filter @hobo/training-pipeline build",
		"test": "vitest run"
	},
	"dependencies": {
		"@agentv/core": "4.42.4",
		"@bufbuild/protobuf": "2.12.1",
		"@hobo/core": "workspace:*"
	},
	"devDependencies": {
		"@hobo/training-pipeline": "workspace:*",
		"@types/node": "^22.15.3",
		"tsx": "^4.20.3",
		"typescript": "^6.0.3",
		"vitest": "^4.1.9"
	}
}
