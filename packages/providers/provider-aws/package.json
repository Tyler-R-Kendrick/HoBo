{
	"name": "@hobo/provider-aws",
	"version": "0.0.1",
	"license": "MIT",
	"type": "module",
	"private": true,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "pnpm --filter @hobo/core build && tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"pretest": "pnpm run build",
		"test": "vitest run"
	},
	"dependencies": {
		"@hobo/core": "workspace:*"
	},
	"description": "HoBo AWS CloudProvider: RDS/S3/Fargate/SQS/ElastiCache/DynamoDB behind the agnostic ports (HOBO-711)."
}
