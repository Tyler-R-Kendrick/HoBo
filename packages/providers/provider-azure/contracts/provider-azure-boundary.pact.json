{
  "consumer": {
    "name": "@hobo/runtime"
  },
  "provider": {
    "name": "ProviderAzureBoundary"
  },
  "metadata": {
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "interactions": [
    {
      "description": "publish capability manifest bundle for the six Azure equivalence-class ports",
      "request": {
        "method": "POST",
        "path": "/providers/azure/manifest/publish"
      },
      "response": {
        "status": 200,
        "body": {
          "ok": true,
          "paths": [
            "/.well-known/capability-manifest/index.json",
            "/.well-known/capability-manifest/capabilities.json",
            "/.well-known/capability-manifest/auth.json",
            "/.well-known/capability-manifest/cost.json"
          ]
        }
      }
    },
    {
      "description": "keyless auth posture: Entra workload identity federation, no client secrets",
      "request": {
        "method": "GET",
        "path": "/providers/azure/manifest/auth"
      },
      "response": {
        "status": 200,
        "body": {
          "schema": "hobo.provider-auth/v1",
          "mode": "svid-federation",
          "tokenAudience": "api://AzureADTokenExchange",
          "exchange": "azuread:WorkloadIdentityFederation",
          "staticSecrets": false
        }
      }
    },
    {
      "description": "realize a compute ResourcePlan into a pulumi IacProgram with an azure:container-app resource",
      "request": {
        "method": "POST",
        "path": "/providers/azure/realize",
        "body": {
          "name": "api",
          "port": "compute",
          "provider": "azure"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "iac": {
            "apiVersion": "hobo.iac-program/v1",
            "kind": "iac-program",
            "provider": "pulumi",
            "resources": [
              {
                "name": "api",
                "type": "azure:container-app",
                "provider": "azure"
              }
            ]
          }
        }
      }
    }
  ]
}
