{
  "consumer": {
    "name": "@hobo/runtime"
  },
  "provider": {
    "name": "ProviderHetznerBoundary"
  },
  "metadata": {
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "interactions": [
    {
      "description": "publish capability manifest bundle for the two Hetzner equivalence-class ports",
      "request": {
        "method": "POST",
        "path": "/providers/hetzner/manifest/publish"
      },
      "response": {
        "status": 200,
        "body": {
          "ok": true,
          "paths": [
            "/.well-known/capability-manifest/index.json",
            "/.well-known/capability-manifest/capabilities.json",
            "/.well-known/capability-manifest/auth.json",
            "/.well-known/capability-manifest/cost.json"
          ]
        }
      }
    },
    {
      "description": "broker-custody credential locator posture: no static secrets in the package",
      "request": {
        "method": "GET",
        "path": "/providers/hetzner/manifest/auth"
      },
      "response": {
        "status": 200,
        "body": {
          "schema": "hobo.provider-auth/v1",
          "mode": "svid-federation",
          "exchange": "hobo:broker-credential-locator",
          "staticSecrets": false
        }
      }
    },
    {
      "description": "realize a compute ResourcePlan into a pulumi IacProgram with a hetzner:cloud-server resource",
      "request": {
        "method": "POST",
        "path": "/providers/hetzner/realize",
        "body": {
          "name": "api",
          "port": "compute",
          "provider": "hetzner"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "iac": {
            "apiVersion": "hobo.iac-program/v1",
            "kind": "iac-program",
            "provider": "pulumi",
            "resources": [
              {
                "name": "api",
                "type": "hetzner:cloud-server",
                "provider": "hetzner"
              }
            ]
          }
        }
      }
    },
    {
      "description": "reconcile a cloud server twice: one create call, one stable physicalId",
      "request": {
        "method": "POST",
        "path": "/providers/hetzner/resolve",
        "body": {
          "productId": "hetzner.cloud-server/v1",
          "logicalId": "api-1",
          "desired": {
            "location": "fsn1",
            "serverType": "cx22",
            "image": "ubuntu-24.04"
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "contract": "hobo.resource-resolver/v1",
          "action": "create",
          "createCalls": 1,
          "reconcileTwiceAction": "noop"
        }
      }
    }
  ]
}
