{
	"name": "@hobo/provider-netlify",
	"version": "0.0.1",
	"license": "MIT",
	"type": "module",
	"private": true,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"pretest": "node --experimental-strip-types ../../../scripts/ensure-built.mts",
		"test": "vitest run"
	},
	"dependencies": {
		"@hobo/bindings": "workspace:*",
		"@hobo/capability-profiles": "workspace:*",
		"@hobo/claims": "workspace:*",
		"@hobo/core": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^22.15.29",
		"vitest": "^4.1.9"
	},
	"description": "HoBo Netlify CloudProvider — equivalence, temporary/agent Environment Station contract, and the direct-anonymous netlify.anonymous-static/v1 claim strategy (static hosting only)."
}
