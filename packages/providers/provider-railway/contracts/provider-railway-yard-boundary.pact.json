{
	"consumer": {
		"name": "hobo-yard-placement-plane"
	},
	"provider": {
		"name": "ProviderRailwayYardBoundary"
	},
	"metadata": {
		"pactSpecification": {
			"version": "3.0.0"
		},
		"boundary": {
			"kind": "in-process",
			"note": "This provider crosses no network from src/. Its boundary is the yard placement / Examples deploy plane, which asks for a descriptor, a capability manifest, a Matching answer, a realized driver program, a client binding, or a temporary Environment Station. Interactions are therefore messages, not HTTP. test/boundary.contract.test.ts replays every one of them against the real createRailwayProvider().",
			"consumerNote": "No package in this repo imports @hobo/provider-railway yet; the consumer named here is the plane whose shapes these are (@hobo/broker yard-placement plus the Examples yard deploy sources). Recording that now is what makes the drift visible when the first consumer lands."
		}
	},
	"interactions": [
		{
			"description": "describe the provider before any plan is matched",
			"request": {
				"type": "message",
				"body": {
					"call": "createRailwayProvider"
				}
			},
			"response": {
				"body": {
					"id": "@hobo/provider-railway",
					"regions": ["global"],
					"ports": ["compute", "kv", "queue"]
				}
			}
		},
		{
			"description": "publish the capability manifest",
			"request": {
				"type": "message",
				"body": {
					"call": "capabilityManifest"
				}
			},
			"response": {
				"body": {
					"providerId": "@hobo/provider-railway",
					"published": {},
					"capabilities": {
						"capabilities": [
							{ "port": "compute" },
							{ "port": "kv" },
							{ "port": "queue" }
						]
					},
					"auth": {
						"exchange": "hobo:brokered-deploy-token",
						"staticSecrets": false
					},
					"cost": {
						"facts": []
					}
				}
			}
		},
		{
			"description": "answer a compute requirement whose features the equivalence class carries",
			"request": {
				"type": "message",
				"body": {
					"call": "satisfies",
					"port": "compute",
					"features": ["http", "container", "managed"]
				}
			},
			"response": {
				"body": {
					"kind": "full"
				}
			}
		},
		{
			"description": "answer a compute requirement asking for a feature Railway does not carry",
			"request": {
				"type": "message",
				"body": {
					"call": "satisfies",
					"port": "compute",
					"features": ["http", "autoscale"]
				}
			},
			"response": {
				"body": {
					"kind": "partial",
					"missing": ["autoscale"]
				}
			}
		},
		{
			"description": "answer a requirement for a port Railway does not realize",
			"request": {
				"type": "message",
				"body": {
					"call": "satisfies",
					"port": "data",
					"features": []
				}
			},
			"response": {
				"body": {
					"kind": "none"
				}
			}
		},
		{
			"description": "estimate cost for a kv requirement while the provider publishes no cost facts",
			"request": {
				"type": "message",
				"body": {
					"call": "estimateCost",
					"port": "kv"
				}
			},
			"response": {
				"body": {
					"currency": "USD",
					"sku": "railway:redis",
					"unit": "request",
					"marginalPrice": "0",
					"pricingStatus": "unknown"
				}
			}
		},
		{
			"description": "realize a kv plan into a one-resource driver program",
			"request": {
				"type": "message",
				"body": {
					"call": "realize",
					"plan": {
						"name": "sessions",
						"port": "kv"
					}
				}
			},
			"response": {
				"body": {
					"driver": {
						"apiVersion": "hobo.driver-program/v1",
						"driver": "railway-deploy",
						"resources": [
							{
								"name": "sessions",
								"type": "railway:redis",
								"provider": "railway"
							}
						]
					}
				}
			}
		},
		{
			"description": "reject a plan whose port Railway cannot realize, at the parser rather than inside a driver program",
			"request": {
				"type": "message",
				"body": {
					"call": "realize",
					"plan": {
						"name": "analytics",
						"port": "data"
					}
				}
			},
			"response": {
				"body": {
					"error": {
						"code": "HOBO_RAILWAY_INPUT_REJECTED",
						"field": "port"
					}
				}
			}
		},
		{
			"description": "reject a plan name that could not become a DNS label",
			"request": {
				"type": "message",
				"body": {
					"call": "realize",
					"plan": {
						"name": "Sessions Store",
						"port": "kv"
					}
				}
			},
			"response": {
				"body": {
					"error": {
						"code": "HOBO_RAILWAY_INPUT_REJECTED",
						"field": "name"
					}
				}
			}
		},
		{
			"description": "bind deploy outputs for the compute port",
			"request": {
				"type": "message",
				"body": {
					"call": "client",
					"port": "compute",
					"outputs": {
						"SERVICE_URL": "https://demo.up.railway.app",
						"SERVICE_ID": "svc_fake_0000"
					}
				}
			},
			"response": {
				"body": {
					"port": "compute",
					"resourceClass": "railway:service",
					"providerService": "Railway Service",
					"bindings": {
						"SERVICE_URL": "https://demo.up.railway.app",
						"SERVICE_ID": "svc_fake_0000"
					}
				}
			}
		},
		{
			"description": "reject a deploy output that carries a document instead of a locator",
			"request": {
				"type": "message",
				"body": {
					"call": "client",
					"port": "compute",
					"outputs": {
						"SERVICE_URL": "https://demo.up.railway.app\nPGPASSWORD=REDACTED"
					}
				}
			},
			"response": {
				"body": {
					"error": {
						"code": "HOBO_RAILWAY_INPUT_REJECTED",
						"field": "bindings.SERVICE_URL"
					}
				}
			}
		},
		{
			"description": "refuse a temporary Environment Station request rather than ask for a permanent token",
			"request": {
				"type": "message",
				"body": {
					"call": "provisionTemporaryEnvironmentStation",
					"stationId": "st-fake-0001"
				}
			},
			"response": {
				"body": {
					"providerId": "railway",
					"code": "HOBO_TEMP_PROVISION_UNAVAILABLE",
					"supportsAnonymousTemporaryDeploy": false
				}
			}
		}
	]
}
