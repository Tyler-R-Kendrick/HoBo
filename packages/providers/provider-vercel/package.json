{
	"name": "@hobo/provider-vercel",
	"version": "0.0.1",
	"license": "MIT",
	"type": "module",
	"private": true,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"pretest": "node --experimental-strip-types ../../../scripts/ensure-built.mts",
		"test": "vitest run",
		"pretest:mirror": "node --experimental-strip-types ../../../scripts/ensure-built.mts",
		"test:mirror": "vitest run --config vitest.mirror.config.ts"
	},
	"dependencies": {
		"@hobo/bindings": "workspace:*",
		"@hobo/capability-profiles": "workspace:*",
		"@hobo/claims": "workspace:*",
		"@hobo/core": "workspace:*"
	},
	"devDependencies": {
		"@hobo/contract-harness": "workspace:*",
		"@types/node": "^22.15.29",
		"vitest": "^4.1.9"
	},
	"description": "HoBo Vercel CloudProvider — equivalence, temporary/agent Environment Station contract, and the sponsor-backed vercel.sponsored-project-transfer/v1 claim strategy (project + associated marketplace resource)."
}
