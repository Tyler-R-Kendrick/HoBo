{
	"consumer": {
		"name": "hobo-yard-placement-plane"
	},
	"provider": {
		"name": "ProviderWebernetesYardBoundary"
	},
	"metadata": {
		"pactSpecification": {
			"version": "3.0.0"
		},
		"boundary": {
			"kind": "in-process",
			"note": "The yard half of this package crosses no network: the plane asks for a descriptor, a capability manifest, a Matching answer, a realized driver program, or a client binding. Interactions are therefore messages, not HTTP. test/boundary.contract.test.ts replays every one against the real createWebernetesProvider(). The station half has its own pact, provider-webernetes-local-station.pact.json, because it does have a seam.",
			"consumerNote": "The Examples yard deploy source (examples/try-site/yards/webernetes.deploy.ts) and @hobo/broker yard-placement are the planes these shapes belong to."
		}
	},
	"interactions": [
		{
			"description": "describe the provider before any plan is matched",
			"request": {
				"type": "message",
				"body": {
					"call": "createWebernetesProvider"
				}
			},
			"response": {
				"body": {
					"id": "@hobo/provider-webernetes",
					"regions": ["global"],
					"ports": ["compute", "kv", "queue"]
				}
			}
		},
		{
			"description": "publish the capability manifest",
			"request": {
				"type": "message",
				"body": {
					"call": "capabilityManifest"
				}
			},
			"response": {
				"body": {
					"providerId": "@hobo/provider-webernetes",
					"published": {},
					"capabilities": {
						"capabilities": [
							{ "port": "compute" },
							{ "port": "kv" },
							{ "port": "queue" }
						]
					},
					"auth": {
						"exchange": "hobo:brokered-deploy-token",
						"staticSecrets": false
					},
					"cost": {
						"facts": []
					}
				}
			}
		},
		{
			"description": "answer a compute requirement whose features the local pod carries",
			"request": {
				"type": "message",
				"body": {
					"call": "satisfies",
					"port": "compute",
					"features": ["http", "container"]
				}
			},
			"response": {
				"body": {
					"kind": "full"
				}
			}
		},
		{
			"description": "refuse to claim managed compute, which a local pod is not",
			"request": {
				"type": "message",
				"body": {
					"call": "satisfies",
					"port": "compute",
					"features": ["http", "managed"]
				}
			},
			"response": {
				"body": {
					"kind": "partial",
					"missing": ["managed"]
				}
			}
		},
		{
			"description": "answer a requirement for a port the local yard does not host",
			"request": {
				"type": "message",
				"body": {
					"call": "satisfies",
					"port": "bucket",
					"features": []
				}
			},
			"response": {
				"body": {
					"kind": "none"
				}
			}
		},
		{
			"description": "estimate cost for a compute requirement on hardware that bills nobody",
			"request": {
				"type": "message",
				"body": {
					"call": "estimateCost",
					"port": "compute"
				}
			},
			"response": {
				"body": {
					"currency": "USD",
					"sku": "webernetes:pod",
					"unit": "request",
					"marginalPrice": "0",
					"pricingStatus": "verified-zero"
				}
			}
		},
		{
			"description": "realize a compute plan into a one-resource driver program",
			"request": {
				"type": "message",
				"body": {
					"call": "realize",
					"plan": {
						"name": "hello-world",
						"port": "compute"
					}
				}
			},
			"response": {
				"body": {
					"driver": {
						"apiVersion": "hobo.driver-program/v1",
						"driver": "webernetes-deploy",
						"resources": [
							{
								"name": "hello-world",
								"type": "webernetes:pod",
								"provider": "webernetes"
							}
						]
					}
				}
			}
		},
		{
			"description": "reject a plan whose port the local yard cannot host",
			"request": {
				"type": "message",
				"body": {
					"call": "realize",
					"plan": {
						"name": "uploads",
						"port": "bucket"
					}
				}
			},
			"response": {
				"body": {
					"error": {
						"code": "HOBO_WEBERNETES_INPUT_REJECTED",
						"field": "port"
					}
				}
			}
		},
		{
			"description": "reject a plan name that could not become a DNS label",
			"request": {
				"type": "message",
				"body": {
					"call": "realize",
					"plan": {
						"name": "Hello World",
						"port": "compute"
					}
				}
			},
			"response": {
				"body": {
					"error": {
						"code": "HOBO_WEBERNETES_INPUT_REJECTED",
						"field": "name"
					}
				}
			}
		},
		{
			"description": "bind deploy outputs for the kv port",
			"request": {
				"type": "message",
				"body": {
					"call": "client",
					"port": "kv",
					"outputs": {
						"KV_ENDPOINT": "http://kv.webernetes.hobo.localhost"
					}
				}
			},
			"response": {
				"body": {
					"port": "kv",
					"resourceClass": "webernetes:kv",
					"providerService": "Local KV",
					"bindings": {
						"KV_ENDPOINT": "http://kv.webernetes.hobo.localhost"
					}
				}
			}
		},
		{
			"description": "reject a deploy output that carries a document instead of a locator",
			"request": {
				"type": "message",
				"body": {
					"call": "client",
					"port": "kv",
					"outputs": {
						"KV_ENDPOINT": "http://kv.webernetes.hobo.localhost\nKV_TOKEN=REDACTED"
					}
				}
			},
			"response": {
				"body": {
					"error": {
						"code": "HOBO_WEBERNETES_INPUT_REJECTED",
						"field": "bindings.KV_ENDPOINT"
					}
				}
			}
		}
	]
}
