# Every downgrade appears twice: refused without an allowance, disclosed with one.
# The old suite asserted both halves inside one test, so a refusal that stops
# refusing and a disclosure that goes quiet were one red line instead of two.
{"method":"compile","name":"a second claim is refused when one was asked for","input":[{"recipe":"sqlApi","semantics":{"claimCount":1}}],"subset":{"ok":false,"rejectionCodes":["CLAIM_MODE_INSUFFICIENT"]}}
{"method":"compile","name":"a second claim is disclosed when allowed","input":[{"recipe":"sqlApi","semantics":{"claimCount":1},"policy":{"allowedWidenings":["claim.single-to-multiple"]}}],"subset":{"ok":true,"wideningKinds":["claim.single-to-multiple"]}}
{"method":"compile","name":"a sponsor migration is refused when a provider-native claim was asked for","input":[{"recipe":"convexCloud","semantics":{"claimKind":"provider-native","bootstrap":"public-anonymous"},"policy":{"maximumSponsoredCostMinorUnits":1000}}],"subset":{"ok":false,"rejectionCodes":["BOOTSTRAP_POLICY_DENIED"]}}
{"method":"compile","name":"a sponsor migration is disclosed when allowed","input":[{"recipe":"convexCloud","semantics":{"claimKind":"provider-native","bootstrap":"public-anonymous"},"policy":{"maximumSponsoredCostMinorUnits":1000,"allowedWidenings":["bootstrap.public-anonymous-to-sponsored","claim.provider-native-to-sponsor-migration"]}}],"subset":{"ok":true,"wideningKinds":["bootstrap.public-anonymous-to-sponsored","claim.provider-native-to-sponsor-migration"]}}
{"method":"compile","name":"ephemeral state is refused when persistence was asked for","input":[{"recipe":"netlifyReport","semantics":{"persistence":"persistent"}}],"subset":{"ok":false,"rejectionCodes":["PERSISTENCE_REQUIRED"]}}
{"method":"compile","name":"ephemeral state is disclosed when allowed","input":[{"recipe":"netlifyReport","semantics":{"persistence":"persistent"},"policy":{"allowedWidenings":["persistence.persistent-to-ephemeral"]}}],"subset":{"ok":true,"wideningKinds":["persistence.persistent-to-ephemeral"]}}
{"method":"compile","name":"polling is refused when a websocket was asked for","input":[{"recipe":"leaderboard","semantics":{"realtime":"websocket"}}],"subset":{"ok":false,"rejectionCodes":["WEBSOCKET_REQUIRED"]}}
{"method":"compile","name":"polling is disclosed when allowed","input":[{"recipe":"leaderboard","semantics":{"realtime":"websocket"},"policy":{"allowedWidenings":["realtime.websocket-to-polling"]}}],"subset":{"ok":true,"wideningKinds":["realtime.websocket-to-polling"]}}
{"method":"compile","name":"plaintext credentials are refused when secret-ref custody was asked for","input":[{"recipe":"inbox","deliver":{"id":"recipe.test.plaintext-inbox/v1","delivers":{"credentialCustody":"plaintext"}}}],"subset":{"ok":false,"rejectionCodes":["SECRET_CUSTODY_UNAVAILABLE"]}}
{"method":"compile","name":"plaintext credentials are disclosed when allowed","input":[{"recipe":"inbox","deliver":{"id":"recipe.test.plaintext-inbox/v1","delivers":{"credentialCustody":"plaintext"}},"policy":{"allowedWidenings":["credential.secret-ref-to-plaintext"]}}],"subset":{"ok":true,"wideningKinds":["credential.secret-ref-to-plaintext"]}}
{"method":"compile","name":"spending sponsor budget is refused when a public-anonymous bootstrap was asked for","input":[{"recipe":"issueTracker","semantics":{"bootstrap":"public-anonymous"},"policy":{"maximumSponsoredCostMinorUnits":500}}],"subset":{"ok":false,"rejectionCodes":["BOOTSTRAP_POLICY_DENIED"]}}
{"method":"compile","name":"spending sponsor budget is disclosed when allowed","input":[{"recipe":"issueTracker","semantics":{"bootstrap":"public-anonymous"},"policy":{"maximumSponsoredCostMinorUnits":500,"allowedWidenings":["bootstrap.public-anonymous-to-sponsored"]}}],"subset":{"ok":true,"wideningKinds":["bootstrap.public-anonymous-to-sponsored"]}}
# Profile widening: the recipe is rewritten onto a weaker profile than the request asks for.
{"method":"compile","name":"generic relational storage is refused when postgres was asked for","input":[{"recipe":"neonSandbox","weaken":{"id":"recipe.test.generic-relational-sandbox/v1","to":"data.relational/v1"},"request":{"deploymentRef":"junction/generic-relational","capabilities":[{"ref":"db","profileId":"data.postgres/v1"}]}}],"subset":{"ok":false,"rejectionCodes":["PROFILE_INCOMPATIBLE"]}}
{"method":"compile","name":"generic relational storage is disclosed when allowed","input":[{"recipe":"neonSandbox","weaken":{"id":"recipe.test.generic-relational-sandbox/v1","to":"data.relational/v1"},"request":{"deploymentRef":"junction/generic-relational","capabilities":[{"ref":"db","profileId":"data.postgres/v1"}]},"policy":{"allowedWidenings":["profile.postgres-to-generic-relational"]}}],"subset":{"ok":true,"wideningKinds":["profile.postgres-to-generic-relational"]}}
{"method":"compile","name":"a plain key/value promise is refused when redis-compatible was asked for","input":[{"recipe":"leaderboard","weaken":{"id":"recipe.test.weakened-leaderboard/v1","to":"kv.key-value/v1","placementId":"board"},"request":{"deploymentRef":"junction/weakened-leaderboard","capabilities":[{"ref":"api","profileId":"api.http/v1","extra":{"runtime":{"allowed":["serverless_faas"]}}},{"ref":"board","profileId":"kv.redis-compatible/v1"}],"dependencies":[{"fromCapabilityRef":"api","toCapabilityRef":"board"}]}}],"subset":{"ok":false,"rejectionCodes":["PROFILE_INCOMPATIBLE"]}}
{"method":"compile","name":"a plain key/value promise names the placement it weakened","input":[{"recipe":"leaderboard","weaken":{"id":"recipe.test.weakened-leaderboard/v1","to":"kv.key-value/v1","placementId":"board"},"request":{"deploymentRef":"junction/weakened-leaderboard","capabilities":[{"ref":"api","profileId":"api.http/v1","extra":{"runtime":{"allowed":["serverless_faas"]}}},{"ref":"board","profileId":"kv.redis-compatible/v1"}],"dependencies":[{"fromCapabilityRef":"api","toCapabilityRef":"board"}]},"policy":{"allowedWidenings":["profile.weakened"]}}],"subset":{"ok":true,"wideningKinds":["profile.weakened"],"wideningPlacements":["board"]}}
