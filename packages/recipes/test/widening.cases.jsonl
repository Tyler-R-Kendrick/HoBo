{"method":"compile","name":"a pack realization is refused where native was allowed","input":[{"recipe":"neonSandbox","catalogRealization":"pack","request":{"deploymentRef":"junction/realization","capabilities":[{"ref":"db","profileId":"data.postgres/v1","extra":{"realization":{"allowNative":true,"allowPack":true}}}]}}],"subset":{"ok":false,"rejectionCodes":["REALIZATION_DENIED"]}}
{"method":"compile","name":"a pack realization is disclosed when allowed","input":[{"recipe":"neonSandbox","catalogRealization":"pack","request":{"deploymentRef":"junction/realization","capabilities":[{"ref":"db","profileId":"data.postgres/v1","extra":{"realization":{"allowNative":true,"allowPack":true}}}]},"policy":{"allowedWidenings":["realization.native-to-pack"]}}],"subset":{"ok":true,"wideningKinds":["realization.native-to-pack"]}}
{"method":"compile","name":"a bridge realization is refused where pack was the weakest allowed","input":[{"recipe":"neonSandbox","catalogRealization":"bridge","request":{"deploymentRef":"junction/realization","capabilities":[{"ref":"db","profileId":"data.postgres/v1","extra":{"realization":{"allowNative":false,"allowPack":true,"allowBridge":true}}}]}}],"subset":{"ok":false,"rejectionCodes":["REALIZATION_DENIED"]}}
