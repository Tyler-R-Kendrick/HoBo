{"method":"offerNotices","name":"every permitted widening reaches the offer","input":[{"recipe":"leaderboard","semantics":{"realtime":"websocket","claimCount":1},"policy":{"allowedWidenings":["claim.single-to-multiple","realtime.websocket-to-polling"]}}],"expect":["claim.single-to-multiple","realtime.websocket-to-polling"]}
