{"method":"kindsWithoutCases","name":"every declared widening kind is exercised by a case","input":[],"expect":[]}
{"method":"declaredKinds","name":"the declared set, so a removal is caught too","input":[],"expect":["bootstrap.public-anonymous-to-sponsored","claim.provider-native-to-sponsor-migration","claim.single-to-multiple","credential.secret-ref-to-plaintext","persistence.persistent-to-ephemeral","profile.postgres-to-generic-relational","profile.weakened","realization.native-to-pack","realization.pack-to-bridge","realtime.websocket-to-polling"]}
