{
	"consumer": {
		"name": "@hobo/code"
	},
	"provider": {
		"name": "hobo-rift-cli"
	},
	"comment": "The boundary @hobo/code depends on: argv in, exit code plus stdout out. Verified for real by test/pact.test.ts, which runs the built CLI for every interaction below.",
	"interactions": [
		{
			"description": "capability reports the chosen tier and why",
			"request": {
				"argv": ["capability", "--json"]
			},
			"response": {
				"exitCode": 0,
				"jsonKeys": ["tier", "available", "reason", "isolatesInPlaceWrites"]
			}
		},
		{
			"description": "init is idempotent so callers may run it before every create",
			"request": {
				"argv": ["init"]
			},
			"response": {
				"exitCode": 0,
				"repeatable": true
			}
		},
		{
			"description": "create prints the workspace path on stdout as the last line",
			"request": {
				"argv": ["create", "--name", "claude"]
			},
			"response": {
				"exitCode": 0,
				"stdoutLastLineIsAbsolutePath": true
			}
		},
		{
			"description": "create refuses a duplicate name instead of clobbering the tree",
			"request": {
				"argv": ["create", "--name", "claude"]
			},
			"response": {
				"exitCode": 1,
				"stderrMatches": "already exists"
			}
		},
		{
			"description": "create refuses a traversing name",
			"request": {
				"argv": ["create", "--name", "../escaped"]
			},
			"response": {
				"exitCode": 1,
				"stderrMatches": "invalid workspace name"
			}
		},
		{
			"description": "list reports registered workspaces as JSON",
			"request": {
				"argv": ["list", "--json"]
			},
			"response": {
				"exitCode": 0,
				"jsonKeys": ["root", "workspaces"]
			}
		},
		{
			"description": "exec --print-cmd yields the command that enters the workspace",
			"request": {
				"argv": ["exec", "--name", "claude", "--print-cmd", "--", "pwd"]
			},
			"response": {
				"exitCode": 0,
				"stdoutContains": "pwd"
			}
		},
		{
			"description": "exec on an unknown workspace fails rather than running in the source",
			"request": {
				"argv": ["exec", "--name", "ghost", "--print-cmd", "--", "pwd"]
			},
			"response": {
				"exitCode": 1,
				"stderrMatches": "no workspace"
			}
		},
		{
			"description": "remove deletes the workspace and reports it",
			"request": {
				"argv": ["remove", "--name", "claude"]
			},
			"response": {
				"exitCode": 0
			}
		}
	],
	"metadata": {
		"pactSpecification": {
			"version": "3.0.0"
		}
	}
}
