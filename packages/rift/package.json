{
	"name": "@hobo/rift",
	"version": "0.0.1",
	"license": "MIT",
	"description": "Virtual worktrees for hobo-code: copy-on-write agent workspaces that work on this machine, not just on btrfs.",
	"type": "module",
	"bin": {
		"hobo-rift": "./dist/bin/hobo-rift.js"
	},
	"files": [
		"dist",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"postbuild": "node -e \"require('node:fs').chmodSync('dist/bin/hobo-rift.js', 0o755)\"",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"pretest": "pnpm run build",
		"test": "vitest run"
	},
	"devDependencies": {
		"@types/node": "^22.15.29",
		"typescript": "^6.0.3",
		"vitest": "^4.1.9"
	},
	"dependencies": {
		"@bufbuild/protobuf": "^2.13.0"
	}
}
