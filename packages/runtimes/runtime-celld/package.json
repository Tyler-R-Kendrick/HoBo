{
	"name": "@hobo/runtime-celld",
	"version": "0.0.1",
	"license": "MIT",
	"description": "Experimental Durable Objects dialect adapter for celld. Not a WASM Component Model host. One fleet per trust boundary.",
	"type": "module",
	"private": true,
	"files": [
		"LICENSE",
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"dependencies": {
		"@hobo/core": "workspace:*"
	},
	"devDependencies": {
		"@types/node": ">=24.0.0"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"fetch:celld": "node --import tsx ../../../scripts/fetch-celld.mts",
		"pretest": "node --experimental-strip-types ../../../scripts/ensure-built.mts && pnpm run fetch:celld",
		"test": "vitest run"
	}
}
