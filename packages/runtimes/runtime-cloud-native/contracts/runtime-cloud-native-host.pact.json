{
	"consumer": { "name": "hobo-composition-root" },
	"provider": { "name": "runtime-cloud-native-host" },
	"interactions": [
		{
			"description": "ensure cloud-native registry with mock default",
			"request": {
				"method": "POST",
				"path": "/runtime-host/ensure",
				"body": { "kind": "cloud-native", "defaultProvider": "mock" }
			},
			"response": {
				"status": 200,
				"body": {
					"kind": "cloud-native",
					"ready": true,
					"defaultProvider": "mock"
				}
			}
		}
	],
	"metadata": {
		"pactSpecification": { "version": "3.0.0" }
	}
}
