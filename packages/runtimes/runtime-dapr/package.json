{
	"name": "@hobo/runtime-dapr",
	"version": "0.0.1",
	"license": "MIT",
	"description": "Optional Camp runtime / component-host adapter realizing ActorHost + wasi:messaging over Dapr sidecars (ADR-0138). In-process wasm remains default (ADR-0031).",
	"type": "module",
	"private": true,
	"files": [
		"LICENSE",
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@hobo/core": "workspace:*"
	},
	"devDependencies": {
		"@types/node": ">=24.0.0"
	},
	"scripts": {
		"build": "pnpm --filter @hobo/core build && tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"pretest": "pnpm run build",
		"test": "vitest run"
	}
}
