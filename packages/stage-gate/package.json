{
	"name": "@hobo/stage-gate",
	"version": "0.0.1",
	"type": "module",
	"bin": {
		"hobo-stage-gate": "./dist/cli.js"
	},
	"files": ["dist"],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@types/node": "^22.19.11",
		"typescript": "^6.0.3",
		"vitest": "^4.1.9"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"test": "vitest run --no-isolate",
		"test:contract:consumer": "vitest run contracts/consumer --no-isolate"
	}
}
