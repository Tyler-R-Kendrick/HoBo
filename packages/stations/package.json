{
	"name": "@hobo/stations",
	"version": "0.0.1",
	"license": "MIT",
	"type": "module",
	"files": [
		"LICENSE",
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@bufbuild/protobuf": "2.12.1",
		"@hobo/ci": "workspace:*",
		"@hobo/bindles": "workspace:*",
		"@hobo/connectivity": "workspace:*",
		"@hobo/core": "workspace:*",
		"@hobo/dispatcher": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^22.15.29",
		"typescript": "^6.0.3",
		"vitest": "^4.1.9"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"pretest": "node --experimental-strip-types ../../scripts/ensure-built.mts",
		"test": "vitest run"
	}
}
