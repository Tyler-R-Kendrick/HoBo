# SLO folding.
{"method":"rows","name":"folds slo measurements into scoped component rows","input":[[{"seq":1,"ts":"2026-08-17T00:00:00.000Z","project":"shop","slo":{}}]],"subset":{"project:shop":{"components":{"kit-web":{"status":"operational","attainment":0.9995}}}}}
{"method":"rows","name":"ignores malformed slo payloads without wedging the row","input":[[{"seq":1,"ts":"2026-08-17T00:00:00.000Z","project":"shop","slo":{}},{"type":"slo.Measured","seq":2,"ts":"2026-08-17T00:01:00.000Z","project":"shop","data":{"componentId":"","attainment":"high","target":2}}]],"subset":{"project:shop":{"lastSeq":2,"components":{"kit-web":{"status":"operational"}}}}}
{"method":"rows","name":"clamps out-of-range attainment","input":[[{"seq":1,"ts":"2026-08-17T00:00:00.000Z","project":"shop","slo":{"attainment":1.7}}]],"subset":{"project:shop":{"components":{"kit-web":{"attainment":1}}}}}
{"method":"rows","name":"never lets a late measurement overwrite a newer status","input":[[{"seq":1,"ts":"2026-08-17T02:00:00.000Z","project":"shop","slo":{"attainment":0.9995,"measuredAt":"2026-08-17T02:00:00.000Z"}},{"seq":2,"ts":"2026-08-17T02:01:00.000Z","project":"shop","slo":{"attainment":0.5,"measuredAt":"2026-08-17T01:00:00.000Z"}}]],"subset":{"project:shop":{"components":{"kit-web":{"status":"operational","lastSignalAt":"2026-08-17T02:00:00.000Z"}}}}}
# Scope keying: explicit scopeKey, then project, then tenant.
{"method":"defaultScopeKey","name":"an explicit scopeKey wins","input":[{"type":"slo.Measured","seq":1,"ts":"2026-08-17T00:00:00.000Z","data":{"scopeKey":"bindle:shop"}}],"expect":"bindle:shop"}
{"method":"defaultScopeKey","name":"falls back to the project","input":[{"type":"slo.Measured","seq":1,"ts":"2026-08-17T00:00:00.000Z","project":"shop","data":{}}],"expect":"project:shop"}
{"method":"defaultScopeKey","name":"falls back to the tenant","input":[{"type":"slo.Measured","seq":1,"ts":"2026-08-17T00:00:00.000Z","data":{}}],"expect":"tenant:local"}
# Graded status from attainment against target.
{"method":"statusFromAttainment","name":"at or above target is operational","input":[0.9995,0.999],"expect":"operational"}
{"method":"statusFromAttainment","name":"just below target is degraded","input":[0.995,0.999],"expect":"degraded"}
{"method":"statusFromAttainment","name":"well below target is a partial outage","input":[0.95,0.999],"expect":"partial_outage"}
{"method":"statusFromAttainment","name":"far below target is a major outage","input":[0.5,0.999],"expect":"major_outage"}
# Bounded per-day history, aggregated to the worst of each day.
{"method":"historySummary","name":"keeps at most the day limit and rolls up to the worst","input":[],"expect":{"withinLimit":true,"worst":"major_outage","samples":2}}
# Incident lifecycle.
{"method":"rows","name":"handles the incident lifecycle with public posts","input":[[{"type":"incident.Opened","seq":1,"ts":"2026-08-17T00:00:00.000Z","project":"shop","data":{"incidentId":"INC-1","title":"Checkout latency","impact":"major","affectedComponents":["kit-web"],"currentStatus":"investigating"}},{"type":"statuspage.IncidentPosted","seq":2,"ts":"2026-08-17T00:05:00.000Z","project":"shop","data":{"incidentId":"INC-1","currentStatus":"identified","body":"Cache stampede identified."}},{"type":"incident.Resolved","seq":3,"ts":"2026-08-17T00:30:00.000Z","project":"shop","data":{"incidentId":"INC-1","resolutionSummary":"Cache warmed."}}]],"subset":{"project:shop":{"incidents":{"INC-1":{"state":"resolved","resolvedAt":"2026-08-17T00:30:00.000Z","updates":[{"public":true},{}]}}}}}
{"method":"rows","name":"keeps a resolved tombstone when Resolved arrives before Opened","input":[[{"type":"incident.Resolved","seq":1,"ts":"2026-08-17T01:00:00.000Z","project":"shop","data":{"incidentId":"INC-9","resolutionSummary":"Fixed."}},{"type":"incident.Opened","seq":2,"ts":"2026-08-17T00:00:00.000Z","project":"shop","data":{"incidentId":"INC-9","title":"Late open","impact":"critical","affectedComponents":["kit-api"],"currentStatus":"investigating"}}]],"subset":{"project:shop":{"incidents":{"INC-9":{"state":"resolved","title":"Late open","affectedComponents":["kit-api"],"openedAt":"2026-08-17T00:00:00.000Z"}}}}}
{"method":"rows","name":"ignores lifecycle regressions and duplicate opens","input":[[{"type":"incident.Opened","seq":1,"ts":"2026-08-17T00:00:00.000Z","data":{"incidentId":"INC-2","title":"First","impact":"minor","affectedComponents":[],"currentStatus":"monitoring"}},{"type":"incident.Updated","seq":2,"ts":"2026-08-17T00:05:00.000Z","data":{"incidentId":"INC-2","currentStatus":"investigating","body":"Regression attempt"}},{"type":"incident.Opened","seq":3,"ts":"2026-08-17T00:06:00.000Z","data":{"incidentId":"INC-2","title":"Duplicate","impact":"critical","affectedComponents":[],"currentStatus":"investigating"}}]],"subset":{"tenant:local":{"incidents":{"INC-2":{"state":"monitoring","title":"First","impact":"minor"}}}}}
# Maintenance is forward-only, and an inverted window is not a maintenance at all.
{"method":"rows","name":"upserts maintenance with a forward-only state machine","input":[[{"type":"maintenance.Scheduled","seq":1,"ts":"2026-08-17T00:00:00.000Z","data":{"maintenanceId":"MTN-1","title":"DB upgrade","windowStart":"2026-08-18T02:00:00.000Z","windowEnd":"2026-08-18T03:00:00.000Z","affectedComponents":["dep-db"],"expectedImpact":"Reads may be briefly delayed."}},{"type":"maintenance.Updated","seq":2,"ts":"2026-08-18T02:00:00.000Z","data":{"maintenanceId":"MTN-1","state":"in-progress"}},{"type":"maintenance.Updated","seq":3,"ts":"2026-08-18T02:01:00.000Z","data":{"maintenanceId":"MTN-1","state":"scheduled"}}]],"subset":{"tenant:local":{"maintenances":{"MTN-1":{"state":"in-progress"}}}}}
{"method":"rows","name":"rejects an inverted maintenance window","input":[[{"type":"maintenance.Scheduled","seq":1,"ts":"2026-08-17T00:00:00.000Z","data":{"maintenanceId":"MTN-2","title":"Bad window","windowStart":"2026-08-18T03:00:00.000Z","windowEnd":"2026-08-18T02:00:00.000Z","affectedComponents":[],"expectedImpact":"n/a"}}]],"expect":{"tenant:local":{"scopeKey":"tenant:local","lastSeq":1,"lastEventAt":"2026-08-17T00:00:00.000Z","components":{},"incidents":{},"maintenances":{}}}}
# Publish and unpublish audit state.
{"method":"rows","name":"records publish audit state","input":[[{"type":"statuspage.Published","seq":1,"ts":"2026-08-17T00:00:00.000Z","project":"shop","data":{"scopeKind":"project","scopeId":"shop","contentHash":"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","components":["kit-web"]}}]],"subset":{"project:shop":{"published":{"contentHash":"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}}}}
{"method":"rows","name":"unpublish clears the published record and keeps the reason","input":[[{"type":"statuspage.Published","seq":1,"ts":"2026-08-17T00:00:00.000Z","project":"shop","data":{"scopeKind":"project","scopeId":"shop","contentHash":"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","components":["kit-web"]}},{"type":"statuspage.Unpublished","seq":2,"ts":"2026-08-17T01:00:00.000Z","project":"shop","data":{"scopeKind":"project","scopeId":"shop","reason":"incident review"}}]],"subset":{"project:shop":{"lastUnpublished":{"reason":"incident review"}}}}
# A quarantined event takes its offending predecessor out of the replay (ADR-0086).
{"method":"rows","name":"skips quarantined events during replay","input":[[{"seq":1,"ts":"2026-08-17T00:00:00.000Z","project":"shop","slo":{"attainment":0.5}},{"type":"status.Quarantined","seq":2,"ts":"2026-08-17T00:01:00.000Z","data":{"offendingSeq":1}}]],"expect":{}}
# Contracts with the data plane and with replay.
{"method":"readSet","name":"declares its read-set for the data plane","input":[],"expect":["incident.Opened","incident.Resolved","incident.Updated","maintenance.Scheduled","maintenance.Updated","slo.Measured","statuspage.IncidentPosted","statuspage.Published","statuspage.Unpublished"]}
{"method":"isDeterministic","name":"identical folds produce identical rows","input":[[{"seq":1,"ts":"2026-08-17T00:00:00.000Z","project":"shop","slo":{}},{"seq":2,"ts":"2026-08-17T00:05:00.000Z","project":"shop","slo":{"attainment":0.99}},{"type":"incident.Opened","seq":3,"ts":"2026-08-17T00:06:00.000Z","project":"shop","data":{"incidentId":"INC-3","title":"Blip","impact":"minor","affectedComponents":["kit-web"],"currentStatus":"investigating"}}]],"expect":true}
