{
	"name": "@hobo/testing",
	"version": "0.0.1",
	"license": "MIT",
	"description": "HoBo out-of-box application test harness: deploy a collected Bindle topology, assert against it, and destroy it, across an in-process whole-graph lane and a credential-gated ephemeral-Camp lane, with an ADR-0042 fidelity attestation on every handle.",
	"type": "module",
	"files": [
		"LICENSE",
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@hobo/core": "workspace:*",
		"@hobo/runtime-local": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^22.15.29",
		"vitest": "^4.1.9"
	},
	"scripts": {
		"prebuild": "pnpm --filter @hobo/core build",
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"pretest": "pnpm run build",
		"test": "vitest run test/",
		"test:unit": "vitest run test/"
	}
}
