{
	"name": "@hobo/wit",
	"version": "0.0.1",
	"type": "module",
	"files": [
		"dist",
		"generated",
		"wit",
		"wit-lock.json"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"codegen": "tsx scripts/generate-bindings.ts",
		"roundtrip": "tsx bin/reverse-extract.ts --wit wit/hobo-sdk.wit --artifact fixtures/golden-component.imports-exports.json",
		"test": "vitest run"
	},
	"devDependencies": {
		"@bytecodealliance/jco": "1.24.3",
		"@types/node": "^22.15.29",
		"tsx": "^4.20.3",
		"typescript": "^6.0.3",
		"vitest": "^4.1.9"
	}
}
