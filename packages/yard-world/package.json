{
	"name": "@hobo/yard-world",
	"version": "0.0.1",
	"license": "MIT",
	"type": "module",
	"private": true,
	"files": ["dist"],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./layout-store": {
			"types": "./dist/layout-store.d.ts",
			"default": "./dist/layout-store.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"pretest": "pnpm run build",
		"test": "vitest run"
	},
	"devDependencies": {
		"@types/node": "^22.15.29",
		"vitest": "^4.1.9"
	},
	"description": "Pure yard-world model for HoBo observability: OTel spans/logs/metrics mapped onto Stations, Yards, Camps, Junctions, and Bindle characters. Zero runtime dependencies; no I/O in the core."
}
