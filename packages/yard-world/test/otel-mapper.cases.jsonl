# OTLP span kinds, including the unset default.
{"method":"spanKindFromOtlp","input":[1],"expect":"internal"}
{"method":"spanKindFromOtlp","input":[2],"expect":"server"}
{"method":"spanKindFromOtlp","input":[3],"expect":"client"}
{"method":"spanKindFromOtlp","input":[4],"expect":"producer"}
{"method":"spanKindFromOtlp","input":[5],"expect":"consumer"}
{"method":"spanKindFromOtlp","name":"an unset kind is internal","input":[],"expect":"internal"}
# Span kind and status drive the character's state.
{"method":"after","name":"a server span drives the character and ends cleanly at idle","input":[{"submissions":[{"payload":{}}]}],"subset":{"events":[{"type":"span-started","spanKind":"server"}],"characters":{"station-a/orders-api":{"state":"idle","campId":"camp-orders"}}}}
{"method":"after","name":"a db client span maps to reading while open","input":[{"submissions":[{"payload":{"kind":3,"spanAttrs":[{"key":"db.system","value":{"stringValue":"postgresql"}}]},"apply":"started"}]}],"subset":{"characters":{"station-a/orders-api":{"state":"reading"}}}}
{"method":"after","name":"an error status leaves the character stuck","input":[{"submissions":[{"payload":{"statusCode":2}}]}],"subset":{"characters":{"station-a/orders-api":{"state":"stuck"}}}}
{"method":"after","name":"hobo.primitive selects the crew kind","input":[{"submissions":[{"payload":{"service":"op-sam","primitive":"crew"},"apply":"none"}]}],"subset":{"characters":{"station-a/op-sam":{"kind":"crew"}}}}
{"method":"after","name":"hobo.primitive selects the actor kind","input":[{"submissions":[{"payload":{"service":"reconciler","primitive":"actor"},"apply":"none"}]}],"subset":{"characters":{"station-a/reconciler":{"kind":"actor"}}}}
{"method":"after","name":"the same service in two stations never mixes","input":[{"submissions":[{"payload":{"station":"station-a"},"apply":"none"},{"payload":{"station":"station-b"},"apply":"none"}],"visibleIn":["station-a"]}],"subset":{"events":[{"characterId":"station-b/orders-api"}],"visibleIn":{"station-a":["station-a/orders-api"]}}}
# Junction packets: a client span in one camp with a server child in another.
{"method":"after","name":"client span in camp A with a server child in camp B emits packet-started","input":[{"world":"camps-and-junction","submissions":[{"preset":"cross-camp","apply":"none"}]}],"match":"\"type\":\"packet-started\".*\"traceId\":\"trace-x\".*\"spanId\":\"child-1\".*\"junctionId\":\"j1\".*\"fromCampId\":\"camp-a\".*\"toCampId\":\"camp-b\""}
{"method":"after","name":"no packet when parent and child are in the same camp","input":[{"world":"camps-and-junction","submissions":[{"preset":"cross-camp-same-camp","apply":"none"}]}],"subset":{"eventTypes":["span-started","span-ended","span-started","span-ended"],"packetIds":[]}}
{"method":"after","name":"a hobo.junction attribute emits a packet without a parent span","input":[{"world":"camps-and-junction","submissions":[{"apply":"none","raw":{"resourceSpans":[{"resource":{"attributes":[{"key":"service.name","value":{"stringValue":"orders"}},{"key":"hobo.station","value":{"stringValue":"s1"}},{"key":"hobo.camp","value":{"stringValue":"camp-b"}}]},"scopeSpans":[{"spans":[{"traceId":"trace-y","spanId":"sp-y","name":"POST /orders","kind":2,"startTimeUnixNano":"1000000000","endTimeUnixNano":"2000000000","status":{"code":1},"attributes":[{"key":"hobo.junction","value":{"stringValue":"j1"}}]}]}]}]}}]}],"match":"\"type\":\"packet-started\".*\"junctionId\":\"j1\".*\"fromCampId\":\"camp-a\".*\"toCampId\":\"camp-b\""}
{"method":"after","name":"the packet appears in the world once the pair is reduced","input":[{"world":"camps-and-junction","submissions":[{"preset":"cross-camp","apply":"except-ended"}]}],"subset":{"packetIds":["child-1"]}}
# Cross-request pairs: the parent arrives in one request, the child in another.
{"method":"after","name":"a parent alone emits no packet and is remembered by the index","input":[{"world":"camps-and-junction","index":{},"submissions":[{"preset":"cross-camp-parent-only","nowMs":1000,"apply":"none"}]}],"subset":{"eventTypes":["span-started","span-ended"],"indexSize":1}}
{"method":"after","name":"parent and child in separate requests still emit a packet","input":[{"world":"camps-and-junction","index":{},"submissions":[{"preset":"cross-camp-parent-only","nowMs":1000,"apply":"none"},{"preset":"cross-camp-child-only","nowMs":2000,"apply":"none"}]}],"match":"\"type\":\"packet-started\".*\"traceId\":\"trace-x\".*\"spanId\":\"child-1\".*\"junctionId\":\"j1\".*\"fromCampId\":\"camp-a\".*\"toCampId\":\"camp-b\""}
{"method":"after","name":"no packet without an index when the parent is in another request","input":[{"world":"camps-and-junction","submissions":[{"preset":"cross-camp-parent-only","apply":"none"},{"preset":"cross-camp-child-only","apply":"none"}]}],"subset":{"eventTypes":["span-started","span-ended"]}}
{"method":"after","name":"an expired parent resolves to nothing","input":[{"world":"camps-and-junction","index":{"ttlMs":10000,"sweepMs":1000},"submissions":[{"preset":"cross-camp-parent-only","nowMs":1000,"apply":"none"},{"preset":"cross-camp-child-only","nowMs":5000,"apply":"none"}]}],"subset":{"eventTypes":["span-started","span-ended"]}}
