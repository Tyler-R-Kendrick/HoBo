{
	"name": "@hobo/yards",
	"version": "0.0.1",
	"license": "MIT",
	"type": "module",
	"private": true,
	"files": ["LICENSE", "dist"],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@hobo/camps": "workspace:*",
		"@hobo/core": "workspace:*"
	},
	"devDependencies": {
		"@hobo/bindles": "workspace:*",
		"@types/node": "^22.15.29"
	},
	"scripts": {
		"prebuild": "pnpm --filter @hobo/camps build",
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"pretest": "pnpm --filter @hobo/bindles build && pnpm --filter @hobo/camps build",
		"test": "vitest run"
	}
}
