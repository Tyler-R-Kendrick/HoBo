---
// A puffy cartoon cloud: stroked circles for the outline, then the same
// circles unstroked on top to erase the interior lines. Pure line-art.
interface Props {
	size?: number;
	class?: string;
}
const { size = 120, class: className = "" } = Astro.props;
const puffs = [
	{ cx: 34, cy: 46, r: 20 },
	{ cx: 60, cy: 32, r: 24 },
	{ cx: 90, cy: 42, r: 19 },
	{ cx: 110, cy: 54, r: 14 },
	{ cx: 70, cy: 54, r: 22 },
];
---

<svg
	width={size}
	height={size * 0.6}
	viewBox="0 0 130 78"
	class={`cloud ${className}`}
	aria-hidden="true"
>
	<g class="cloud-outline" stroke-width="5">
		{puffs.map((p) => <circle cx={p.cx} cy={p.cy} r={p.r} />)}
	</g>
	<g class="cloud-fill">
		{puffs.map((p) => <circle cx={p.cx} cy={p.cy} r={p.r} />)}
	</g>
</svg>
