---
import BoIdle from "./BoIdle.astro";
import Logo from "./Logo.astro";
import { nav } from "../nav";
import { href } from "../lib/url";

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container">
		<div class="footer-grid">
			<div class="footer-brand">
				<a class="brand" href={href("/")}>
					<Logo />
					<span>HoBo</span>
				</a>
				<p>
					Every app deserves a good home — preferably a cheap one. HoBo
					describes your app once, finds it the best-value home that passes
					your policies, and keeps it moving when a better one opens up.
				</p>
				<p>
					<a
						class="footer-github"
						href="https://github.com/Tyler-R-Kendrick/HoBo"
						target="_blank"
						rel="noopener"
					>
						<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" style="vertical-align: -3px; margin-right: 6px;">
							<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
						</svg>HoBo on GitHub
					</a>
				</p>
			</div>
			{
				nav.map((group) => (
					<nav aria-label={`Footer: ${group.label}`}>
						<p class="nav-label">{group.label}</p>
						<ul>
							{group.items.map((item) => (
								<li>
									<a href={href(item.slug)}>{item.label}</a>
								</li>
							))}
						</ul>
					</nav>
				))
			}
		</div>
		<div class="footer-note">
			<BoIdle size="3.25rem" class="footer-bo" />
			<span>
				HoBo is <strong>pre-release</strong> — the surfaces documented here are
				the contract the product is being built to.
			</span>
			<span>
				Homeward bound since the design phase · © {year} Tyler Kendrick ·
				<a href="https://github.com/Tyler-R-Kendrick/HoBo/blob/main/LICENSE" target="_blank" rel="noopener">MIT licensed</a> ·
				<a href={href("/legal/")}>Legal</a>
			</span>
			<span class="footer-trademark">
				Third-party product names are trademarks of their respective owners.
				HoBo is not affiliated with or endorsed by any of them.
			</span>
		</div>
	</div>
</footer>
