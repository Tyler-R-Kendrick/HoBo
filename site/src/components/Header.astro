---
import Logo from "./Logo.astro";
import { nav, sections, sectionFor } from "../nav";
import { href } from "../lib/url";

const path = Astro.url.pathname;
// The header shows sections, not groups. `aria-current="page"` is the spec
// value — "true" is not a valid token and screen readers ignore it.
//
// `sectionFor` is the *sole* authority here. It used to be backed up by a
// `path.startsWith(section.slug)` fallback, which marked a second link on any
// page where the two disagreed — `/agents/` came out with both "Learn" and
// "Agents" current. `aria-current="page"` identifies one element, so two is an
// invalid state, not a redundant one. Now that `sectionFor` resolves section
// slugs as namespace roots, the fallback only ever added the wrong answer.
const here = sectionFor(path.replace(href("/"), "/"), nav);
---

<header class="site-header">
	<div class="container">
		<a class="brand" href={href("/")}>
			<Logo />
			<span>HoBo</span>
		</a>
		<nav class="site-nav" id="site-nav" aria-label="Main">
			{/* The ink nav — and beneath it, each world's own. A world does not
			    rename these links; it re-frames them: a newspaper has sections,
			    a photoplay has acts, a dispatch board has tracks, a scrapbook
			    has tabs. Same five destinations, five vocabularies. */}
			<span class="ink-world nav-links">
				{
					sections.map((section) => (
						<a
							href={href(section.slug)}
							aria-current={here?.label === section.label ? "page" : undefined}
						>
							{section.label}
						</a>
					))
				}
			</span>
			<span class="world-nav world-nav-herald">
				<a href={href("/guide/")}>Dispatches</a>
				<a href={href("/examples/")}>Classifieds</a>
				<a href={href("/operations/")}>Rail Schedules</a>
				<a href={href("/reference/")}>The Record</a>
				<a href={href("/agents/")}>Union Hall</a>
			</span>
			<span class="world-nav world-nav-photoplay">
				<a href={href("/guide/")}><span class="act">ACT I</span> Learn</a>
				<a href={href("/examples/")}><span class="act">ACT II</span> Examples</a>
				<a href={href("/operations/")}><span class="act">ACT III</span> Operate</a>
				<a href={href("/reference/")}><span class="act">INTERMISSION</span> Reference</a>
				<a href={href("/agents/")}><span class="act">ACT IV</span> Agents</a>
			</span>
			<span class="world-nav world-nav-dispatch">
				<a href={href("/guide/")}><span class="trk">TRK·00</span>learn</a>
				<a href={href("/examples/")}><span class="trk">TRK·01</span>examples</a>
				<a href={href("/operations/")}><span class="trk">TRK·02</span>operate</a>
				<a href={href("/reference/")}><span class="trk">TRK·03</span>reference</a>
				<a href={href("/agents/")}><span class="trk">TRK·04</span>agents</a>
			</span>
			<span class="world-nav world-nav-scrapbook">
				<a href={href("/guide/")}>the road</a>
				<a href={href("/examples/")}>the kit</a>
				<a href={href("/operations/")}>the yards</a>
				<a href={href("/reference/")}>the map</a>
				<a href={href("/agents/")}>the crew</a>
			</span>
		</nav>
		<div class="header-actions">
			<a
				class="icon-btn github-link"
				href="https://github.com/Tyler-R-Kendrick/HoBo"
				aria-label="HoBo source on GitHub"
				title="HoBo source on GitHub"
				target="_blank"
				rel="noopener"
			>
				<svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
					<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
				</svg>
			</a>
			<details class="palette-picker">
				<summary class="icon-btn picker-summary" aria-label="Choose a design" title="Design">
					<span class="picker-word">Design</span>
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<circle cx="13.5" cy="6.5" r="1.5"></circle><circle cx="17.5" cy="10.5" r="1.5"></circle>
						<circle cx="8.5" cy="7.5" r="1.5"></circle><circle cx="6.5" cy="12.5" r="1.5"></circle>
						<path d="M12 2a10 10 0 1 0 0 20c.6 0 1-.4 1-1 0-.3-.1-.5-.3-.7-.2-.2-.3-.5-.3-.8 0-.6.4-1 1-1H15a5 5 0 0 0 5-5c0-5-3.6-9-8-9Z"></path>
					</svg>
				</summary>
				<div class="palette-menu" role="group" aria-label="Design">
					{/* Captions say what you GET, not the CSS that makes it — "paper
					    planes, hard shadows" was judged tokens-speak by the persona
					    review. And the current choice is marked: an unlabeled menu
					    with no state forced people to memorise what each design looks
					    like to know where they were. */}
					<button type="button" data-set-design="ink">
						Ink <span>the classic — black ink on white paper</span>
					</button>
					<button type="button" data-set-design="broadsheet">
						Broadsheet <span>reads like a newspaper</span>
					</button>
					<button type="button" data-set-design="titlecard">
						Title Card <span>big centred cinema type</span>
					</button>
					<button type="button" data-set-design="ledger">
						Ledger <span>compact and technical</span>
					</button>
					<button type="button" data-set-design="cutout">
						Cutout <span>paper stickers with hard shadows</span>
					</button>
				</div>
			</details>
			<button class="icon-btn theme-toggle" aria-label="Toggle color theme" aria-pressed="false">
				<svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
					<circle cx="12" cy="12" r="4"></circle>
					<path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
				</svg>
				<svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
				</svg>
			</button>
			<button class="icon-btn nav-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="site-nav">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
					<path d="M3 6h18M3 12h18M3 18h18"></path>
				</svg>
			</button>
		</div>
	</div>
</header>
