---
import Logo from "./Logo.astro";
import { nav } from "../nav";
import { href } from "../lib/url";

const path = Astro.url.pathname;
const isActive = (slug: string) => path.startsWith(href(slug));
---

<header class="site-header">
	<div class="container">
		<a class="brand" href={href("/")}>
			<Logo />
			<span>HoBo</span>
			<span class="badge badge-accent">homeward bound</span>
		</a>
		<nav class="site-nav" aria-label="Main">
			{
				nav.map((group) => (
					<a href={href(group.slug)} aria-current={isActive(group.slug)}>
						{group.label}
					</a>
				))
			}
		</nav>
		<div class="header-actions">
			<button class="icon-btn theme-toggle" aria-label="Toggle color theme">
				<svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
					<circle cx="12" cy="12" r="4"></circle>
					<path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
				</svg>
				<svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
				</svg>
			</button>
			<button class="icon-btn nav-toggle" aria-label="Toggle menu" aria-expanded="false">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
					<path d="M3 6h18M3 12h18M3 18h18"></path>
				</svg>
			</button>
		</div>
	</div>
</header>
