---
// The HoBo mark: a 16×16 pixel tile — outlined plate, hard bevel, accent
// monogram. Every edge lands on the grid, so it stays crisp at any integer
// scale (16 / 32 / 48 …). Colors are tokens, so it flips with the theme.
interface Props {
	/** Rendered size in px. Keep it a multiple of 16 — integer scaling only. */
	size?: number;
}
const { size = 32 } = Astro.props;
---

<svg
	width={size}
	height={size}
	viewBox="0 0 16 16"
	class="pixel-art hobo-mark"
	role="img"
	aria-hidden="true"
>
	<!-- plate + outline -->
	<rect x="0" y="0" width="16" height="16" fill="var(--ink)"></rect>
	<rect x="2" y="2" width="12" height="12" fill="var(--bg-inset)"></rect>
	<!-- pixel bevel: highlight up top, shade below -->
	<rect x="2" y="2" width="12" height="1" fill="var(--bg)"></rect>
	<rect x="2" y="13" width="12" height="1" fill="var(--border-strong)"></rect>
	<!-- monogram -->
	<rect x="4" y="4" width="2" height="8" fill="var(--accent-strong)"></rect>
	<rect x="10" y="4" width="2" height="8" fill="var(--accent-strong)"></rect>
	<rect x="6" y="7" width="4" height="2" fill="var(--accent-strong)"></rect>
</svg>
