		<g class="mascot-puff">
			<circle cx="20" cy="196" r="9"></circle>
			<circle cx="33" cy="202" r="7"></circle>
			<circle cx="14" cy="206" r="5"></circle>
			<circle cx="44" cy="210" r="2.2"></circle>
			<circle cx="8" cy="192" r="1.8"></circle>
		</g>
	)}
