	width={size}
	height={size * 1.15}
	viewBox="0 0 200 230"
	fill="none"
	class={`mascot ${flip ? "mascot-flip" : ""} ${className}`}
	role="img"
	aria-label="Bo, the HoBo bindlebug, walking with a bindle stick"
