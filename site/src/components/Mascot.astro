---
// Bo, the HoBo bindlebug: a raggedy mop of soot with googly eyes, rubber-hose
// legs, big cartoon shoes, and a bindle stick. The fur is a single compound
// path of ~60 curved strands (generated deterministically at design time).
// Ink/paper colors come from CSS custom properties so Bo works in both themes.
interface Props {
	size?: number;
	class?: string;
	flip?: boolean;
	puffs?: boolean;
}
const { size = 120, class: className = "", flip = false, puffs = false } = Astro.props;
