---
// Bo, the HoBo bindlebug: a fuzzy little traveler with googly eyes and a
// bindle stick, drawn in the site's cartoon line-art language. The ink and
// paper colors come from CSS custom properties so Bo works in both themes.
interface Props {
	size?: number;
	class?: string;
	flip?: boolean;
	puffs?: boolean;
}
const { size = 120, class: className = "", flip = false, puffs = false } = Astro.props;
---

<svg
	width={size}
	height={size * 1.15}
	viewBox="0 0 200 230"
	fill="none"
	class={`mascot ${className}`}
	style={flip ? "transform: scaleX(-1);" : undefined}
	role="img"
	aria-label="Bo, the HoBo bindlebug, walking with a bindle stick"
>
	{puffs && (
		<g class="mascot-puff">
			<circle cx="18" cy="196" r="9" />
			<circle cx="31" cy="203" r="7" />
			<circle cx="12" cy="207" r="5" />
		</g>
	)}
	<!-- legs (walking) -->
	<g class="mascot-ink" stroke-width="7" stroke-linecap="round">
		<path d="M78 166 L70 196 L52 202" fill="none" class="stroke-only"></path>
		<path d="M120 168 L128 200 L146 204" fill="none" class="stroke-only"></path>
	</g>
	<!-- fur body -->
	<path
		class="mascot-body"
		d="M96.4,42.1 L100.0,13.0 L103.6,42.1 L110.1,39.1 L120.1,15.3 L117.5,40.9 L120.9,48.9 L130.7,36.7 L126.9,52.0 L131.7,55.0 L155.6,34.2 L136.8,59.6 L145.3,60.0 L158.4,54.8 L149.7,66.4 L148.8,73.7 L184.7,65.1 L151.4,80.3 L149.4,86.6 L173.3,86.0 L150.2,93.3 L156.6,99.1 L173.0,106.1 L155.7,106.6 L153.5,112.3 L174.0,122.4 L150.9,119.3 L143.0,121.6 L160.4,139.7 L139.2,127.1 L138.8,134.4 L162.1,162.7 L133.4,139.2 L130.1,145.1 L130.1,157.3 L123.3,148.6 L115.5,144.7 L121.5,173.6 L108.9,146.3 L103.5,148.2 L97.8,167.5 L96.5,148.2 L89.9,153.1 L82.8,177.1 L82.4,151.2 L78.5,144.6 L57.9,169.8 L72.3,141.3 L69.0,136.0 L55.7,149.9 L64.0,131.6 L55.3,131.5 L31.2,139.6 L51.0,125.2 L49.6,119.0 L37.2,122.8 L47.0,112.2 L50.9,105.3 L10.0,103.1 L50.1,98.7 L44.9,93.0 L24.0,90.2 L45.8,85.7 L45.3,79.3 L29.7,65.6 L48.0,72.2 L56.4,70.0 L35.6,55.9 L60.3,64.5 L62.4,58.8 L54.8,39.6 L67.6,54.2 L69.7,46.6 L53.6,17.5 L76.5,43.0 L84.1,45.9 L86.5,25.9 L90.8,44.3 Z"
	></path>
	<!-- bindle stick (paper-filled so it reads over the body) -->
	<g class="mascot-paper" stroke-width="4" stroke-linejoin="round">
		<path d="M112 128 L178 56" stroke-width="9" class="stick-under"></path>
		<path d="M112 128 L178 56" stroke-width="5" class="stick-over"></path>
	</g>
	<!-- bindle bag + knot -->
	<g class="mascot-paper" stroke-width="5" stroke-linejoin="round">
		<path d="M177 57 C 196 66 200 88 186 97 C 172 106 154 94 158 76 C 160 66 168 58 177 57 Z"></path>
		<path d="M176 56 C 170 44 172 36 180 30 C 179 40 181 44 183 47 C 186 41 192 38 199 39 C 193 44 190 49 190 54 Z" stroke-width="4"></path>
	</g>
	<!-- eyes -->
	<g>
		<circle class="mascot-eye" cx="82" cy="92" r="19"></circle>
		<circle class="mascot-eye" cx="118" cy="90" r="16"></circle>
		<circle class="mascot-pupil" cx="87" cy="95" r="8"></circle>
		<circle class="mascot-pupil" cx="121" cy="92" r="7"></circle>
	</g>
</svg>
