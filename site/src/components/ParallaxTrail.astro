---
// ==========================================================================
// The open road: a side-scrolling parallax band with Bo walking the trail.
//
// Nearly all of it is supplied artwork. Clouds, the horizon, the telephone
// poles and the ground itself are plates dropped into public/parallax/plates/
// and looped as given, at their own aspect ratios (see ../lib/trail-plates.ts).
// The only thing drawn here is the wire strung between the poles, which has to
// be generated because it spans the gap and closes across the tile seam (see
// ../lib/trail-art.ts). This file is the machinery that moves both.
//
// A layer scrolls by translating exactly one of its own tile widths, over and
// over, so the wrap always lands on identical pixels. Layers stay in vertical
// alignment because every tile — drawn or supplied — is pinned to the band
// height and composed against the same 300-unit scene. What differs is only
// how long one tile takes to go by.
//
// Bo is the uploaded 36-frame walk sprite (6x6 grid, repacked to 160x157 per
// frame and posterized to the four tones the drawing actually uses). He holds
// one spot while the world slides past, and his stride is timed against the
// ground plate so his feet plant instead of skating.
//
// He can walk either way. `facing` picks the sheet and reverses every layer,
// so the world slides the other way and his feet still plant. The two sheets
// are separate drawings, not one flipped: Bo is not symmetric, and mirroring
// hands the bindle to the wrong arm (see ../lib/bo-walk.ts).
// ==========================================================================

import { href } from "../lib/url";
import { BO_FEET, TH, TRAIL_LAYERS, TRAIL_SECONDS } from "../lib/trail-art";
import { plates } from "../lib/trail-plates";
import { CLOUD_SPEED, CLOUD_TILE, CLOUD_TONE, clouds } from "../lib/trail-clouds";
import { type Facing, WALK_SHEETS, hasWalkSheet, walkSheet } from "../lib/bo-walk";

interface Props {
	/** Which way Bo walks. The whole band reverses with him. */
	facing?: Facing;
}

const { facing = "east" } = Astro.props;
const west = facing === "west";

// Throws, with the reason, if the sheet for this direction is not on disk.
const sheet = walkSheet(facing);

const round = (v: number) => Math.round(v * 100) / 100;

// TRAIL_SECONDS times one 1200-unit tile. A layer with a wider tile has more
// ground to cover in the same apparent motion, so its duration scales with its
// own width — otherwise a plate that is not 4:1 travels at the wrong speed and
// the parallax it claims is not the parallax you see.
const seconds = (tileUnits: number, speed: number) =>
	round((TRAIL_SECONDS * (tileUnits / 1200)) / speed);

type Layer = {
	key: string;
	order: number;
	front: boolean;
	href?: string;
	style: string;
	kind: "plate" | "drawn" | "clouds";
	night: string;
};

const supplied: Layer[] = plates().map((p) => ({
	key: p.key,
	order: p.order,
	front: p.front,
	kind: "plate",
	night: p.night,
	href: href(`/parallax/plates/${p.file}`),
	style: [
		`--plate:url("${href(`/parallax/plates/${p.file}`)}")`,
		`--plate-tile:calc(var(--band-h) * ${round(p.aspect)})`,
		`--plx-dur:${seconds(p.aspect * TH, p.speed)}s`,
		`--tone:${p.tone}`,
		`opacity:${p.opacity}`,
	].join(";"),
}));

const drawn: Layer[] = TRAIL_LAYERS.map((layer) => ({
	key: layer.key,
	order: layer.order,
	front: false,
	kind: "drawn",
	// Already themed at the source — the route serves a light tile and a dark
	// one and the swap happens above. Filtering as well would invert twice.
	night: "keep",
	style: [
		`--art-light:url("${href(`/parallax/${layer.key}-light.svg`)}")`,
		`--art-dark:url("${href(`/parallax/${layer.key}-dark.svg`)}")`,
		`--plx-dur:${seconds(1200, layer.speed)}s`,
		`--tone:${layer.tone}`,
	].join(";"),
}));

// The clouds are sprites, not a plate, so each can squash on its own. The
// track is a row of identical segments scrolling by exactly one of them —
// same loop guarantee as a tiled plate, just built out of elements.
const sky = clouds();
const SKY_SEGMENTS = 6; // one tile is 4x the band height, so six spans any viewport
const cloudLayer: Layer | null = sky.length
	? {
			key: "clouds",
			order: 20,
			front: false,
			kind: "clouds",
			night: "keep",
			style: `--plx-dur:${seconds(CLOUD_TILE, CLOUD_SPEED)}s;--tone:${CLOUD_TONE}`,
		}
	: null;

// One depth order over all three sources, so a drawn layer can sit between two
// plates — the wires hang in front of the poles and behind the ground.
const ordered = [...supplied, ...drawn, ...(cloudLayer ? [cloudLayer] : [])].sort(
	(a, b) => a.order - b.order,
);
const behind = ordered.filter((l) => !l.front);
const inFront = ordered.filter((l) => l.front);

// Sprite geometry: 6x6 grid of 554x542 source frames, feet at 524/542 down.
const BO_FRAME_H = 128; // frame height, in tile units
const BO_FRAME_W = (BO_FRAME_H * 554) / 542;
const BO_BOTTOM = TH - BO_FEET - (1 - 524 / 542) * BO_FRAME_H;
// 50ms a frame, the cadence the sprite was exported at: 9 frames to a step,
// 18 to a stride, so the whole 36-frame sheet is two strides in 1.8s. That is
// also what TRAIL_SECONDS is derived from — change one and change the other.
const BO_FRAME = 0.05;

const rootStyle = [
	`--bo-frame-h:${BO_FRAME_H}`,
	`--bo-frame-w:${Math.round(BO_FRAME_W * 100) / 100}`,
	`--bo-bottom:${Math.round(BO_BOTTOM * 100) / 100}`,
	`--bo-frame:${BO_FRAME}s`,
	// Only the matching rule resolves its var(), so the sheet for the other
	// direction is never fetched. The one for a direction with no artwork is
	// simply not declared, rather than pointing at a 404.
	`--bo-sprite-east:url("${href(`/parallax/${WALK_SHEETS.east}`)}")`,
	...(hasWalkSheet("west")
		? [`--bo-sprite-west:url("${href(`/parallax/${WALK_SHEETS.west}`)}")`]
		: []),
].join(";");

const preloadSheet = href(`/parallax/${sheet}`);
---

{
	supplied.map((p) => (
		<link rel="preload" as="image" href={p.href} />
	))
}
{
	sky.map((c) => (
		<link rel="preload" as="image" href={href(`/parallax/clouds/${c.file}`)} />
	))
}
<link rel="preload" as="image" href={preloadSheet} />
<div class:list={["plx", west && "is-west"]} data-plx style={rootStyle}>
	<div
		class="plx-scene"
		role="img"
		aria-label={`Bo the bindlebug walking ${west ? "west" : "east"} along a country trail past telephone poles and drifting clouds`}
	>
		{
			behind.map((l) =>
				l.kind === "clouds" ? (
					<div class:list={["plx-layer", "plx-sky", `is-${l.night}`]} style={l.style}>
						{Array.from({ length: SKY_SEGMENTS }, () => (
							<div class="plx-sky-seg">
								{sky.map((c) => (
									<span
										class="plx-cloud"
										style={`--cx:${c.x};--cy:${c.y};--cw:${c.w};--ch:${c.h};--cloud:url("${href(`/parallax/clouds/${c.file}`)}")`}
									/>
								))}
							</div>
						))}
					</div>
				) : (
					<div
						class:list={[
							"plx-layer",
							l.kind === "plate" && "plx-plate",
							`plx-${l.key}`,
							`is-${l.night}`,
						]}
						style={l.style}
					/>
				),
			)
		}
		<div class="plx-bo"></div>
		{
			inFront.map((l) => (
				<div
					class:list={[
						"plx-layer",
						l.kind === "plate" && "plx-plate",
						`plx-${l.key}`,
						`is-${l.night}`,
					]}
					style={l.style}
				/>
			))
		}
	</div>
	<button class="plx-pause" type="button" aria-pressed="false">
		<span class="plx-pause-icon" aria-hidden="true"></span>
		<span class="plx-pause-label">Pause the trail animation</span>
	</button>
</div>

<style>
	.plx {
		--band-h: 155px;
		--tile: calc(var(--band-h) * 4);
		--u: calc(var(--band-h) / 300); /* one tile unit, in CSS pixels */
		--bo-h: calc(var(--u) * var(--bo-frame-h));
		--bo-w: calc(var(--u) * var(--bo-frame-w));

		/* --band-h is the scene, not the scene plus its rule: the layers are
		   sized in tile units off it, so the border must not eat into it. */
		box-sizing: content-box;
		position: relative;
		height: var(--band-h);
		overflow: hidden;
		border-bottom: 3px dashed var(--border-strong);
		background: var(--bg);
		contain: layout paint style;
	}

	.plx-scene {
		position: absolute;
		inset: 0;
	}

	/* Every layer is the same 4:1 tile pinned to the band height, so the only
	   thing that can differ between them is how fast one tile goes by. */
	.plx-layer {
		position: absolute;
		top: 0;
		left: 0;
		height: 100%;
		width: calc(100% + var(--tile));
		background-image: var(--art-dark);
		background-repeat: repeat-x;
		background-size: var(--tile) 100%;
		background-position: 0 0;
		animation: plx-scroll var(--plx-dur) linear infinite;
		animation-play-state: var(--plx-play, running);
		will-change: transform;
	}

	:global(:root:not([data-theme="dark"])) .plx-layer {
		background-image: var(--art-light);
	}

	/* A plate is used as given: its own aspect, its own tile width, no theme
	   swap — it is artwork, not something this file re-inks. */
	.plx-plate {
		background-image: var(--plate);
		background-size: auto 100%;
		width: calc(100% + var(--plate-tile));
		animation-name: plx-scroll-plate;
	}

	:global(:root:not([data-theme="dark"])) .plx-plate {
		background-image: var(--plate);
	}

	@keyframes plx-scroll-plate {
		from {
			transform: translate3d(0, 0, 0);
		}
		to {
			transform: translate3d(calc(var(--plate-tile) * -1), 0, 0);
		}
	}

	/* ---------- night ---------- */

	/* Three treatments, one per layer, because the scene is not all one kind
	   of thing (see ../lib/trail-plates.ts). Each is graded by --tone, so the
	   far layers sit back in the dark instead of every layer arriving at the
	   same brilliant white and flattening the depth the parallax just built.
	   By day none of this applies: paper is behind everything and distance
	   already reads without help. */
	:global(:root[data-theme="dark"]) .plx-layer.is-invert {
		filter: invert(1) brightness(var(--tone, 1));
	}

	/* Keeping means keeping the ink, not keeping the brightness — a cloud that
	   stays paper-white is a cut-out pasted on the night. */
	:global(:root[data-theme="dark"]) .plx-layer.is-keep {
		opacity: var(--tone, 1);
	}

	/* A solid silhouette stays solid and gets an ink outline instead — the
	   same four-way rim Bo takes, so a black post reads against a black sky
	   without turning into a white one. */
	:global(:root[data-theme="dark"]) .plx-layer.is-rim {
		/* Scaled off the tile unit rather than fixed: a pole shaft is only a
		   few pixels across at this band height, so a rim that does not shrink
		   with the band eats the black it is supposed to be outlining. */
		--rim: calc(var(--u) * 0.75);
		/* The rim carries the depth. Mixing toward the background rather than
		   picking a grey keeps it correct in both themes and at any tone. */
		--rim-ink: color-mix(in srgb, var(--ink) calc(var(--tone, 1) * 100%), var(--bg));
		filter: drop-shadow(var(--rim) 0 0 var(--rim-ink))
			drop-shadow(calc(var(--rim) * -1) 0 0 var(--rim-ink))
			drop-shadow(0 var(--rim) 0 var(--rim-ink))
			drop-shadow(0 calc(var(--rim) * -1) 0 var(--rim-ink));
	}

	/* ---------- the clouds ---------- */

	/* Sprites rather than a plate, so each one can squash on its own. The
	   track is a row of identical segments and scrolls by exactly one of
	   them, which is the same loop guarantee a tiled plate gets. */
	.plx-sky {
		display: flex;
		width: max-content;
		background-image: none;
		animation-name: plx-scroll;
	}

	.plx-sky-seg {
		position: relative;
		flex: 0 0 var(--tile);
		width: var(--tile);
		height: 100%;
	}

	.plx-cloud {
		position: absolute;
		left: calc(var(--u) * var(--cx));
		top: calc(var(--u) * var(--cy));
		width: calc(var(--u) * var(--cw));
		height: calc(var(--u) * var(--ch));
		background-image: var(--cloud);
		background-repeat: no-repeat;
		background-size: 100% 100%;
		/* Squashing about a point low in the shape is what makes it read as
		   weight settling rather than a box being scaled. */
		transform-origin: 50% 72%;
		animation: plx-cloud-squash 3.1s ease-in-out infinite;
		animation-play-state: var(--plx-play, running);
		will-change: transform;
	}

	@keyframes plx-cloud-squash {
		0%,
		100% {
			transform: translateY(0) scale(1);
		}
		18% {
			transform: translateY(calc(var(--u) * 1.6)) scale(1.08, 0.92);
		}
		36% {
			transform: translateY(calc(var(--u) * -2.1)) scale(0.95, 1.08);
		}
		55% {
			transform: translateY(calc(var(--u) * 0.6)) scale(1.04, 0.97);
		}
		72% {
			transform: translateY(calc(var(--u) * -0.66)) scale(0.98, 1.03);
		}
	}

	/* Exactly one tile of travel, so the wrap lands on identical pixels. */
	@keyframes plx-scroll {
		from {
			transform: translate3d(0, 0, 0);
		}
		to {
			transform: translate3d(calc(var(--tile) * -1), 0, 0);
		}
	}

	/* Bo: 36 frames in a 6x6 grid. One animation walks the columns; a second,
	   exactly six times slower, steps down the rows. */
	.plx-bo {
		position: absolute;
		left: var(--bo-x, 26%);
		bottom: calc(var(--u) * var(--bo-bottom));
		width: var(--bo-w);
		height: var(--bo-h);
		background-image: var(--bo-sprite-east);
		background-repeat: no-repeat;
		background-size: calc(var(--bo-w) * 6) calc(var(--bo-h) * 6);
		background-position: 0 0;
		animation:
			bo-col calc(var(--bo-frame) * 6) steps(6) infinite,
			bo-row calc(var(--bo-frame) * 36) steps(6) infinite;
		animation-play-state: var(--plx-play, running);
	}

	/* Walking the other way. The sprite sheet is the same drawing mirrored per
	   frame — mirroring the whole sheet would reverse the column order, and the
	   column is the frame index, so the walk would run backwards. Every layer
	   reverses with him; his own two animations do not, because the gait plays
	   forward whichever way he is pointed. animation-direction does not
	   inherit, so the cloud squash inside the track is left alone too. */
	.plx.is-west .plx-bo {
		background-image: var(--bo-sprite-west);
	}

	.plx.is-west .plx-layer {
		animation-direction: reverse;
	}

	.plx.is-west {
		--bo-x: 62%;
	}

	/* At night the soot silhouette gets the cream rim the SVG Bo already has. */
	:global(:root[data-theme="dark"]) .plx-bo {
		filter: drop-shadow(1.2px 0 0 var(--ink)) drop-shadow(-1.2px 0 0 var(--ink))
			drop-shadow(0 1.2px 0 var(--ink)) drop-shadow(0 -1.2px 0 var(--ink));
	}

	@keyframes bo-col {
		from {
			background-position-x: 0;
		}
		to {
			background-position-x: calc(var(--bo-w) * -6);
		}
	}

	@keyframes bo-row {
		from {
			background-position-y: 0;
		}
		to {
			background-position-y: calc(var(--bo-h) * -6);
		}
	}

	/* ---------- stopping ---------- */

	/* A hovering cursor, a held finger, a tap, the pause button, a hidden tab
	   or a band scrolled off screen: every one of them freezes Bo and the
	   parallax together, because they all resolve to the same inherited
	   property and every animation in here reads it. */
	.plx.is-held,
	.plx.is-paused,
	.plx.is-idle {
		--plx-play: paused;
	}

	/* Hover only where hover is real. On a touchscreen :hover latches after a
	   tap, which would leave the scene stuck the moment someone tapped it to
	   start it again — there, the tap toggle below is the whole story. */
	@media (hover: hover) and (pointer: fine) {
		.plx:hover {
			--plx-play: paused;
		}

		.plx:hover .plx-pause {
			opacity: 1;
		}
	}

	/* Keyboard focus too — but only the keyboard kind. Plain :focus-within
	   would leave the scene frozen after a mouse click on the button, which
	   makes pressing "play" look broken. */
	.plx:has(:focus-visible) {
		--plx-play: paused;
	}

	.plx-pause {
		position: absolute;
		right: 0.75rem;
		bottom: 0.75rem;
		display: grid;
		place-items: center;
		width: 2.1rem;
		height: 2.1rem;
		padding: 0;
		border: 2px solid var(--ink);
		border-radius: 50%;
		background: var(--bg);
		color: var(--ink);
		cursor: pointer;
		opacity: 0;
		transition: opacity 0.18s var(--ease);
	}

	.plx-pause:focus-visible,
	.plx.is-paused .plx-pause {
		opacity: 1;
	}

	/* Without a cursor there is nothing to reveal it with, and a pause control
	   is not optional for something that moves forever — so on touch it just
	   sits there. */
	@media (hover: none) {
		.plx-pause {
			opacity: 0.9;
		}
	}

	.plx-pause-icon {
		width: 0.7rem;
		height: 0.78rem;
		background: currentColor;
		clip-path: polygon(0 0, 34% 0, 34% 100%, 0 100%, 0 50%, 66% 50%, 66% 0, 100% 0, 100% 100%, 66% 100%, 66% 50%, 0 50%);
	}

	.plx.is-paused .plx-pause-icon {
		clip-path: polygon(10% 0, 100% 50%, 10% 100%);
	}

	.plx-pause-label {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	/* ---------- sizes ---------- */

	@media (max-width: 900px) {
		.plx {
			--bo-x: 20%;
		}

		.plx.is-west {
			--bo-x: 68%;
		}
	}

	@media (max-width: 560px) {
		.plx {
			--band-h: 135px;
			--bo-x: 14%;
		}

		.plx.is-west {
			--bo-x: 74%;
		}

		.plx-pause {
			right: 0.5rem;
			bottom: 0.5rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.plx {
			--plx-play: paused;
		}

		.plx-pause {
			display: none;
		}
	}
</style>

<script is:inline>
	// The trail walks itself; everything here is about stopping it. CSS already
	// covers hover and focus — this adds touch, the pause button, and not
	// burning frames on a band nobody is looking at.
	for (const band of document.querySelectorAll("[data-plx]")) {
		const button = band.querySelector(".plx-pause");
		const setPaused = (on) => {
			band.classList.toggle("is-paused", on);
			button.setAttribute("aria-pressed", String(on));
		};

		button.addEventListener("click", (event) => {
			event.stopPropagation();
			setPaused(!band.classList.contains("is-paused"));
		});

		// Touch and pen: held down stops it; letting go latches the stop on or
		// off, so a tap is a real toggle rather than a 100ms pause.
		band.addEventListener(
			"pointerdown",
			(event) => {
				if (event.pointerType !== "mouse") band.classList.add("is-held");
			},
			{ passive: true },
		);
		band.addEventListener(
			"pointerup",
			(event) => {
				if (event.pointerType === "mouse") return;
				band.classList.remove("is-held");
				if (!button.contains(event.target)) {
					setPaused(!band.classList.contains("is-paused"));
				}
			},
			{ passive: true },
		);
		for (const type of ["pointercancel", "pointerleave"]) {
			band.addEventListener(
				type,
				(event) => {
					if (event.pointerType !== "mouse") band.classList.remove("is-held");
				},
				{ passive: true },
			);
		}

		// Idle when off screen or on a background tab.
		const idle = new Set();
		const flag = (key, on) => {
			idle[on ? "add" : "delete"](key);
			band.classList.toggle("is-idle", idle.size > 0);
		};

		document.addEventListener("visibilitychange", () => {
			flag("hidden", document.visibilityState === "hidden");
		});

		if ("IntersectionObserver" in window) {
			new IntersectionObserver(([entry]) => flag("offscreen", !entry.isIntersecting), {
				rootMargin: "80px",
			}).observe(band);
		}
	}
</script>
