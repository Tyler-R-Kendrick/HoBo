---
// ==========================================================================
// The open road: a side-scrolling parallax band with Bo walking the trail.
//
// Nearly all of it is supplied artwork. Clouds, the horizon, the telephone
// poles and the ground itself are plates dropped into public/parallax/plates/
// and looped as given, at their own aspect ratios (see ../lib/trail-plates.ts).
// The only thing drawn here is the wire strung between the poles, which has to
// be generated because it spans the gap and closes across the tile seam (see
// ../lib/trail-art.ts). This file is the machinery that moves both.
//
// A layer scrolls by translating exactly one of its own tile widths, over and
// over, so the wrap always lands on identical pixels. Layers stay in vertical
// alignment because every tile — drawn or supplied — is pinned to the band
// height and composed against the same 300-unit scene. What differs is only
// how long one tile takes to go by.
//
// Bo is the uploaded 36-frame walk sprite (6x6 grid, repacked to 160x157 per
// frame and posterized to the four tones the drawing actually uses). He holds
// one spot while the world slides past, and his stride is timed against the
// ground plate so his feet plant instead of skating.
// ==========================================================================

import { href } from "../lib/url";
import { BO_FEET, TH, TRAIL_LAYERS, TRAIL_SECONDS } from "../lib/trail-art";
import { plates } from "../lib/trail-plates";

const round = (v: number) => Math.round(v * 100) / 100;

// TRAIL_SECONDS times one 1200-unit tile. A layer with a wider tile has more
// ground to cover in the same apparent motion, so its duration scales with its
// own width — otherwise a plate that is not 4:1 travels at the wrong speed and
// the parallax it claims is not the parallax you see.
const seconds = (tileUnits: number, speed: number) =>
	round((TRAIL_SECONDS * (tileUnits / 1200)) / speed);

type Layer = {
	key: string;
	order: number;
	front: boolean;
	href?: string;
	style: string;
	plate: boolean;
};

const supplied: Layer[] = plates().map((p) => ({
	key: p.key,
	order: p.order,
	front: p.front,
	plate: true,
	href: href(`/parallax/plates/${p.file}`),
	style: [
		`--plate:url("${href(`/parallax/plates/${p.file}`)}")`,
		`--plate-tile:calc(var(--band-h) * ${round(p.aspect)})`,
		`--plx-dur:${seconds(p.aspect * TH, p.speed)}s`,
		`opacity:${p.opacity}`,
	].join(";"),
}));

const drawn: Layer[] = TRAIL_LAYERS.map((layer) => ({
	key: layer.key,
	order: layer.order,
	front: false,
	plate: false,
	style: [
		`--art-light:url("${href(`/parallax/${layer.key}-light.svg`)}")`,
		`--art-dark:url("${href(`/parallax/${layer.key}-dark.svg`)}")`,
		`--plx-dur:${seconds(1200, layer.speed)}s`,
	].join(";"),
}));

// One depth order over both sources, so a drawn layer can sit between two
// plates — the wires hang in front of the poles and behind the ground.
const ordered = [...supplied, ...drawn].sort((a, b) => a.order - b.order);
const behind = ordered.filter((l) => !l.front);
const inFront = ordered.filter((l) => l.front);

// Sprite geometry: 6x6 grid of 554x542 source frames, feet at 524/542 down.
const BO_FRAME_H = 128; // frame height, in tile units
const BO_FRAME_W = (BO_FRAME_H * 554) / 542;
const BO_BOTTOM = TH - BO_FEET - (1 - 524 / 542) * BO_FRAME_H;
// 50ms a frame, the cadence the sprite was exported at: 9 frames to a step,
// 18 to a stride, so the whole 36-frame sheet is two strides in 1.8s. That is
// also what TRAIL_SECONDS is derived from — change one and change the other.
const BO_FRAME = 0.05;

const rootStyle = [
	`--bo-frame-h:${BO_FRAME_H}`,
	`--bo-frame-w:${Math.round(BO_FRAME_W * 100) / 100}`,
	`--bo-bottom:${Math.round(BO_BOTTOM * 100) / 100}`,
	`--bo-frame:${BO_FRAME}s`,
	`--bo-sprite:url("${href("/parallax/bo-walk.png")}")`,
].join(";");
---

{
	supplied.map((p) => (
		<link rel="preload" as="image" href={p.href} />
	))
}
<link rel="preload" as="image" href={href("/parallax/bo-walk.png")} />
<div class="plx" data-plx style={rootStyle}>
	<div
		class="plx-scene"
		role="img"
		aria-label="Bo the bindlebug walking a country trail past telephone poles and drifting clouds"
	>
		{
			behind.map((l) => (
				<div
					class:list={["plx-layer", l.plate && "plx-plate", `plx-${l.key}`]}
					style={l.style}
				/>
			))
		}
		<div class="plx-bo"></div>
		{
			inFront.map((l) => (
				<div
					class:list={["plx-layer", l.plate && "plx-plate", `plx-${l.key}`]}
					style={l.style}
				/>
			))
		}
	</div>
	<button class="plx-pause" type="button" aria-pressed="false">
		<span class="plx-pause-icon" aria-hidden="true"></span>
		<span class="plx-pause-label">Pause the trail animation</span>
	</button>
</div>

<style>
	.plx {
		--band-h: 155px;
		--tile: calc(var(--band-h) * 4);
		--u: calc(var(--band-h) / 300); /* one tile unit, in CSS pixels */
		--bo-h: calc(var(--u) * var(--bo-frame-h));
		--bo-w: calc(var(--u) * var(--bo-frame-w));

		/* --band-h is the scene, not the scene plus its rule: the layers are
		   sized in tile units off it, so the border must not eat into it. */
		box-sizing: content-box;
		position: relative;
		height: var(--band-h);
		overflow: hidden;
		border-bottom: 3px dashed var(--border-strong);
		background: var(--bg);
		contain: layout paint style;
	}

	.plx-scene {
		position: absolute;
		inset: 0;
	}

	/* Every layer is the same 4:1 tile pinned to the band height, so the only
	   thing that can differ between them is how fast one tile goes by. */
	.plx-layer {
		position: absolute;
		top: 0;
		left: 0;
		height: 100%;
		width: calc(100% + var(--tile));
		background-image: var(--art-dark);
		background-repeat: repeat-x;
		background-size: var(--tile) 100%;
		background-position: 0 0;
		animation: plx-scroll var(--plx-dur) linear infinite;
		animation-play-state: var(--plx-play, running);
		will-change: transform;
	}

	:global(:root[data-theme="light"]) .plx-layer {
		background-image: var(--art-light);
	}

	/* A plate is used as given: its own aspect, its own tile width, no theme
	   swap — it is artwork, not something this file re-inks. */
	.plx-plate {
		background-image: var(--plate);
		background-size: auto 100%;
		width: calc(100% + var(--plate-tile));
		animation-name: plx-scroll-plate;
	}

	:global(:root[data-theme="light"]) .plx-plate {
		background-image: var(--plate);
		filter: none;
	}

	:global(:root:not([data-theme="light"])) .plx-plate {
		filter: invert(1);
	}

	@keyframes plx-scroll-plate {
		from {
			transform: translate3d(0, 0, 0);
		}
		to {
			transform: translate3d(calc(var(--plate-tile) * -1), 0, 0);
		}
	}

	/* Exactly one tile of travel, so the wrap lands on identical pixels. */
	@keyframes plx-scroll {
		from {
			transform: translate3d(0, 0, 0);
		}
		to {
			transform: translate3d(calc(var(--tile) * -1), 0, 0);
		}
	}

	/* Bo: 36 frames in a 6x6 grid. One animation walks the columns; a second,
	   exactly six times slower, steps down the rows. */
	.plx-bo {
		position: absolute;
		left: var(--bo-x, 26%);
		bottom: calc(var(--u) * var(--bo-bottom));
		width: var(--bo-w);
		height: var(--bo-h);
		background-image: var(--bo-sprite);
		background-repeat: no-repeat;
		background-size: calc(var(--bo-w) * 6) calc(var(--bo-h) * 6);
		background-position: 0 0;
		animation:
			bo-col calc(var(--bo-frame) * 6) steps(6) infinite,
			bo-row calc(var(--bo-frame) * 36) steps(6) infinite;
		animation-play-state: var(--plx-play, running);
	}

	/* At night the soot silhouette gets the cream rim the SVG Bo already has. */
	:global(:root:not([data-theme="light"])) .plx-bo {
		filter: drop-shadow(1.2px 0 0 var(--ink)) drop-shadow(-1.2px 0 0 var(--ink))
			drop-shadow(0 1.2px 0 var(--ink)) drop-shadow(0 -1.2px 0 var(--ink));
	}

	@keyframes bo-col {
		from {
			background-position-x: 0;
		}
		to {
			background-position-x: calc(var(--bo-w) * -6);
		}
	}

	@keyframes bo-row {
		from {
			background-position-y: 0;
		}
		to {
			background-position-y: calc(var(--bo-h) * -6);
		}
	}

	/* ---------- stopping ---------- */

	/* A hovering cursor, a held finger, a tap, the pause button, a hidden tab
	   or a band scrolled off screen: every one of them freezes Bo and the
	   parallax together, because they all resolve to the same inherited
	   property and every animation in here reads it. */
	.plx.is-held,
	.plx.is-paused,
	.plx.is-idle {
		--plx-play: paused;
	}

	/* Hover only where hover is real. On a touchscreen :hover latches after a
	   tap, which would leave the scene stuck the moment someone tapped it to
	   start it again — there, the tap toggle below is the whole story. */
	@media (hover: hover) and (pointer: fine) {
		.plx:hover {
			--plx-play: paused;
		}

		.plx:hover .plx-pause {
			opacity: 1;
		}
	}

	/* Keyboard focus too — but only the keyboard kind. Plain :focus-within
	   would leave the scene frozen after a mouse click on the button, which
	   makes pressing "play" look broken. */
	.plx:has(:focus-visible) {
		--plx-play: paused;
	}

	.plx-pause {
		position: absolute;
		right: 0.75rem;
		bottom: 0.75rem;
		display: grid;
		place-items: center;
		width: 2.1rem;
		height: 2.1rem;
		padding: 0;
		border: 2px solid var(--ink);
		border-radius: 50%;
		background: var(--bg);
		color: var(--ink);
		cursor: pointer;
		opacity: 0;
		transition: opacity 0.18s var(--ease);
	}

	.plx-pause:focus-visible,
	.plx.is-paused .plx-pause {
		opacity: 1;
	}

	/* Without a cursor there is nothing to reveal it with, and a pause control
	   is not optional for something that moves forever — so on touch it just
	   sits there. */
	@media (hover: none) {
		.plx-pause {
			opacity: 0.9;
		}
	}

	.plx-pause-icon {
		width: 0.7rem;
		height: 0.78rem;
		background: currentColor;
		clip-path: polygon(0 0, 34% 0, 34% 100%, 0 100%, 0 50%, 66% 50%, 66% 0, 100% 0, 100% 100%, 66% 100%, 66% 50%, 0 50%);
	}

	.plx.is-paused .plx-pause-icon {
		clip-path: polygon(10% 0, 100% 50%, 10% 100%);
	}

	.plx-pause-label {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	/* ---------- sizes ---------- */

	@media (max-width: 900px) {
		.plx {
			--bo-x: 20%;
		}
	}

	@media (max-width: 560px) {
		.plx {
			--band-h: 135px;
			--bo-x: 14%;
		}

		.plx-pause {
			right: 0.5rem;
			bottom: 0.5rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.plx {
			--plx-play: paused;
		}

		.plx-pause {
			display: none;
		}
	}
</style>

<script is:inline>
	// The trail walks itself; everything here is about stopping it. CSS already
	// covers hover and focus — this adds touch, the pause button, and not
	// burning frames on a band nobody is looking at.
	for (const band of document.querySelectorAll("[data-plx]")) {
		const button = band.querySelector(".plx-pause");
		const setPaused = (on) => {
			band.classList.toggle("is-paused", on);
			button.setAttribute("aria-pressed", String(on));
		};

		button.addEventListener("click", (event) => {
			event.stopPropagation();
			setPaused(!band.classList.contains("is-paused"));
		});

		// Touch and pen: held down stops it; letting go latches the stop on or
		// off, so a tap is a real toggle rather than a 100ms pause.
		band.addEventListener(
			"pointerdown",
			(event) => {
				if (event.pointerType !== "mouse") band.classList.add("is-held");
			},
			{ passive: true },
		);
		band.addEventListener(
			"pointerup",
			(event) => {
				if (event.pointerType === "mouse") return;
				band.classList.remove("is-held");
				if (!button.contains(event.target)) {
					setPaused(!band.classList.contains("is-paused"));
				}
			},
			{ passive: true },
		);
		for (const type of ["pointercancel", "pointerleave"]) {
			band.addEventListener(
				type,
				(event) => {
					if (event.pointerType !== "mouse") band.classList.remove("is-held");
				},
				{ passive: true },
			);
		}

		// Idle when off screen or on a background tab.
		const idle = new Set();
		const flag = (key, on) => {
			idle[on ? "add" : "delete"](key);
			band.classList.toggle("is-idle", idle.size > 0);
		};

		document.addEventListener("visibilitychange", () => {
			flag("hidden", document.visibilityState === "hidden");
		});

		if ("IntersectionObserver" in window) {
			new IntersectionObserver(([entry]) => flag("offscreen", !entry.isIntersecting), {
				rootMargin: "80px",
			}).observe(band);
		}
	}
</script>
