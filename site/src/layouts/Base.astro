---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import "../styles/native-chrome.css";
import "../styles/worlds.css";

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="referrer" content="no-referrer" />
		<link rel="canonical" href={canonical} />
		<link
			rel="icon"
			type="image/svg+xml"
			href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.svg`}
		/>
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Chewy&display=swap"
		/>
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta name="twitter:card" content="summary" />
		<meta name="color-scheme" content="light dark" />
		<script is:inline>
			// Theme boot: runs before paint to avoid a flash. Kept tiny on purpose.
			(() => {
				const stored = localStorage.getItem("hobo-theme");
				const theme =
					stored === "light" || stored === "dark"
						? stored
						: matchMedia("(prefers-color-scheme: dark)").matches
							? "dark"
							: "light";
				document.documentElement.dataset.theme = theme;
				// Design is the second axis — layout, type and surface, not just
				// colour. Absent or unknown => ink, the canonical rubberhose, so a
				// bad stored value cannot strand anyone in a half-applied theme.
				const dsn = localStorage.getItem("hobo-design");
				if (dsn && ["broadsheet", "titlecard", "ledger", "cutout"].includes(dsn)) {
					document.documentElement.dataset.design = dsn;
				}
			})();
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />
		<script is:inline>
			// The site's entire client-side behavior: theme + menu toggles.
			const themeToggle = document.querySelector(".theme-toggle");
			// The markup ships `aria-pressed="false"`, but the boot script runs in
			// <head> — before this button exists — so it cannot sync there. Without
			// this the button reports "not pressed" while night is active, which is
			// worse than omitting the attribute.
			const syncPressed = () =>
				themeToggle?.setAttribute(
					"aria-pressed",
					String(document.documentElement.dataset.theme === "dark"),
				);
			syncPressed();
			themeToggle?.addEventListener("click", () => {
				const root = document.documentElement;
				const next = root.dataset.theme === "dark" ? "light" : "dark";
				root.dataset.theme = next;
				localStorage.setItem("hobo-theme", next);
				syncPressed();
			});
			// Design picker. `ink` clears the attribute rather than setting a
			// value, so the default stays the absence of a choice. The current
			// choice is marked with aria-current so the open menu answers "which
			// one am I in?" — without it, knowing required memorising the designs.
			const markCurrent = () => {
				const cur = document.documentElement.dataset.design ?? "ink";
				for (const b of document.querySelectorAll("[data-set-design]"))
					if (b.dataset.setDesign === cur) b.setAttribute("aria-current", "true");
					else b.removeAttribute("aria-current");
			};
			markCurrent();
			for (const b of document.querySelectorAll("[data-set-design]")) {
				b.addEventListener("click", () => {
					const p = b.dataset.setDesign;
					const root = document.documentElement;
					if (p === "ink") {
						delete root.dataset.design;
						localStorage.removeItem("hobo-design");
					} else {
						root.dataset.design = p;
						localStorage.setItem("hobo-design", p);
					}
					markCurrent();
					b.closest("details")?.removeAttribute("open");
				});
			}
			// Click-away and Escape close the picker; a disclosure that only
			// closes by clicking its own summary reads as broken.
			document.addEventListener("click", (e) => {
				const d = document.querySelector(".palette-picker[open]");
				if (d && !d.contains(e.target)) d.removeAttribute("open");
			});
			document.addEventListener("keydown", (e) => {
				if (e.key === "Escape")
					document.querySelector(".palette-picker[open]")?.removeAttribute("open");
			});
			for (const [btn, target] of [
				[".nav-toggle", ".site-nav"],
				[".docs-sidebar-toggle", ".docs-sidebar"],
			]) {
				const el = document.querySelector(btn);
				el?.addEventListener("click", () => {
					const open = document.querySelector(target)?.classList.toggle("open");
					el.setAttribute("aria-expanded", String(Boolean(open)));
				});
			}
			// Horizontally scrollable tables must be keyboard-reachable.
			for (const t of document.querySelectorAll(".prose table")) {
				t.tabIndex = 0;
			}
			// Every code block gets a copy button — for humans and agents alike.
			for (const pre of document.querySelectorAll("pre")) {
				const wrap = document.createElement("div");
				wrap.className = "code-block";
				pre.replaceWith(wrap);
				wrap.append(pre);
				const btn = document.createElement("button");
				btn.type = "button";
				btn.className = "code-copy";
				btn.textContent = "Copy";
				btn.setAttribute("aria-label", "Copy code to clipboard");
				btn.addEventListener("click", async () => {
					await navigator.clipboard.writeText(pre.innerText);
					btn.textContent = "Copied ✓";
					btn.classList.add("copied");
					setTimeout(() => {
						btn.textContent = "Copy";
						btn.classList.remove("copied");
					}, 2000);
				});
				wrap.append(btn);
			}
		</script>
	</body>
</html>
