---
import Base from "./Base.astro";
import { nav, groupsOf, sectionFor } from "../nav";
import { href } from "../lib/url";

interface Props {
	frontmatter: {
		title: string;
		description: string;
	};
	rawContent?: () => string;
}

const { frontmatter, rawContent } = Astro.props;
const path = Astro.url.pathname;
const normalize = (p: string) => p.replace(/\/$/, "");
// The sidebar shows ONE section, not all fourteen groups. Rendering every
// group on every page produced a 109-link, ~4000px column in a 236px rail —
// byte-identical to the footer, so a docs page showed the same 109 links
// twice. `sectionFor` resolves cross-listed pages by namespace root rather
// than by who lists them, so /reference/session-replay/ — listed under both
// Observability and Reference — is badged Reference, the namespace it lives in.
const navSection = sectionFor(path.replace(href("/"), "/"), nav);
const sectionGroups = navSection ? groupsOf(navSection, nav) : [];
const section = navSection ?? sectionFor("/guide/", nav);
const current = (slug: string) =>
	normalize(path) === normalize(href(slug)) ? "page" : undefined;

// The page's own markdown, served to the copy button. Optimized for agents:
// title + description up front, then the raw source with stable headings.
const pageMarkdown = rawContent
	? `# ${frontmatter.title}\n\n> ${frontmatter.description}\n\n${rawContent().replace(/^\s*#\s+.+\n/, "")}`.trim()
	: null;
---

<Base
	title={`${frontmatter.title} · HoBo docs`}
	description={frontmatter.description}
>
	<div class="container docs">
		<div>
			<button
				class="docs-sidebar-toggle"
				aria-expanded="false"
				aria-controls="docs-sidebar"
			>
				{section?.label ?? "Docs"} menu ▾
			</button>
			<aside class="docs-sidebar" id="docs-sidebar">
				{
					sectionGroups.map((group) => (
						<nav aria-label={group.label}>
							<p class="nav-label">{group.label}</p>
							<ul>
								{group.items.map((item) => (
									<li>
										<a href={href(item.slug)} aria-current={current(item.slug)}>
											{item.label}
										</a>
									</li>
								))}
							</ul>
						</nav>
					))
				}
			</aside>
		</div>
		<article class="prose">
			<div class="docs-meta">
				<span class="badge">{section?.label ?? "Docs"}</span>
				{
					pageMarkdown && (
						<button
							type="button"
							class="copy-md-btn"
							aria-label="Copy this page as markdown"
						>
							Copy page as Markdown
						</button>
					)
				}
			</div>
			<slot />
		</article>
	</div>
	{
		pageMarkdown && (
			<script
				type="application/json"
				id="page-markdown"
				set:html={JSON.stringify(pageMarkdown).replace(/</g, "\\u003c")}
			/>
		)
	}
	<script is:inline>
		// Copy the page's markdown source — the agent-friendly form of this page.
		(() => {
			const btn = document.querySelector(".copy-md-btn");
			const src = document.getElementById("page-markdown");
			if (!btn || !src) return;
			btn.addEventListener("click", async () => {
				await navigator.clipboard.writeText(JSON.parse(src.textContent));
				btn.textContent = "Copied ✓";
				btn.classList.add("copied");
				setTimeout(() => {
					btn.textContent = "Copy page as Markdown";
					btn.classList.remove("copied");
				}, 2000);
			});
		})();
	</script>
</Base>
