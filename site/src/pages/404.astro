---
import Base from "../layouts/Base.astro";
import { href } from "../lib/url";
---

<Base
	title="Page not found · HoBo"
	description="This page has moved on down the line."
>
	<div class="error-page">
		<p class="badge">Off the map</p>
		<h1>404</h1>
		<p>This page packed its bindle and moved on down the line.</p>
		<p>
			<a class="btn btn-primary" href={href("/")}>Back to the campfire</a>
		</p>
	</div>
</Base>

<style>
	.error-page .badge {
		justify-self: center;
		margin-bottom: 1.25rem;
	}
</style>
