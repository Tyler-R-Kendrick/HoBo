---
import Base from "../layouts/Base.astro";
import Mascot from "../components/Mascot.astro";
import { href } from "../lib/url";
---

<Base
	title="Page not found · HoBo"
	description="This page has moved on down the line."
>
	<div class="error-page">
		<Mascot size={130} class="lost-bo" />
		<h1><span class="gradient-text">404</span></h1>
		<p>This page packed its bindle and moved on down the line.</p>
		<p>
			<a class="btn btn-primary" href={href("/")}>Back to the campfire</a>
		</p>
	</div>
</Base>

<style>
	@keyframes lost-bob {
		from,
		to {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-6px);
		}
	}

	.lost-bo {
		margin-inline: auto;
		animation: lost-bob 3.6s var(--ease) infinite;
	}
</style>
