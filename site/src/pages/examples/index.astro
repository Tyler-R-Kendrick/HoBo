---
import Base from "../../layouts/Base.astro";
---

<Base
	title="Try HoBo — station-first Examples"
	description="1 Pool stations · 2 Ship apps · 3 Live preview and claim — browser Home Station."
>
	<!--
		THESIS: Three-board film strip — stations, apps, live claim — not a SaaS console.
		OWN-WORLD: HoBo Rubberhose ink-on-paper; Chewy boards; thick ink frames; sticker shadows.
		STORY: Lay stations, pick apps to ship, preview hosts, claim a deployment.
		FIRST VIEWPORT: Chewy hero + short line; title-card host stage; Pool · Ship · Live boards.
		FORM: Film-strip storyboard (grounded candidate 3); seed key 116fd7b0.
	-->

	<section class="ex-hero">
		<div class="container">
			<h1>
				Stations.<br />
				<em>Apps. Claim.</em>
			</h1>
			<p>
				Three stamps on a browser Home Station: stand up Environment Stations,
				ship a catalog app (browser WIT or local Wasp bridge), then preview /
				open / claim a live host.
			</p>
		</div>
	</section>

	<section
		class="ex-console"
		data-examples-console
		data-base={import.meta.env.BASE_URL}
		data-station-broker={import.meta.env.PUBLIC_HOBO_STATION_BROKER_URL ?? ""}
	>
		<div class="container">
			<div class="ex-layout">
				<section class="ex-stage" aria-labelledby="workspace-title" data-stage>
					<header class="ex-stage-head">
						<h2 id="workspace-title" data-example-title>Stage</h2>
						<div class="ex-stage-actions">
							<a class="ex-text-btn" data-open-preview hidden rel="noopener" target="_blank">Open preview</a>
							<div class="ex-view-tabs" aria-label="Workspace view">
								<button type="button" aria-pressed="true" data-view="host">Host</button>
								<button type="button" aria-pressed="false" data-view="source">Source</button>
							</div>
						</div>
					</header>

					<div class="ex-stage-body host-view" data-view-panel="host">
						<nav class="ex-host-tabs" aria-label="Live hosts" data-host-tabs hidden></nav>
						<div class="ex-empty" data-host-empty>
							<p class="ex-empty-stamp" aria-hidden="true">1 → 2 → 3</p>
							<h3 data-empty-title>Stamp stations first</h3>
							<p data-provision-preview>
								Pool lays track. Ship loads apps. Live is where you preview and claim.
							</p>
						</div>
						<p class="ex-claimed-banner" data-claimed-banner hidden></p>
						<p class="ex-junction" data-junction-note hidden></p>
					</div>

					<div class="ex-stage-body source-view" data-view-panel="source" hidden>
						<div class="ex-source-path" data-source-path></div>
						<pre tabindex="0"><code data-source></code></pre>
					</div>
				</section>

				<div class="ex-strip" aria-label="Deploy storyboard" data-phase="pool">
					<section class="ex-board" aria-labelledby="board-pool" data-board="pool">
						<h2 id="board-pool"><span class="ex-board-num" aria-hidden="true">1</span> Pool</h2>
						<p class="ex-board-lead">
							Pick yards, stamp Environment Stations.
							Home Station <code class="ex-mono" data-station-id>station:browser:…</code>
						</p>
						<label class="ex-field">
							<span>Yards</span>
							<select multiple size="6" data-yard-select aria-label="Yards to stamp"></select>
						</label>
						<details class="ex-policy-fold">
							<summary>Station policy</summary>
							<label class="ex-field">
								<span>Demo policy</span>
								<select data-demo-policy></select>
							</label>
							<dl class="ex-policy" data-station-policy></dl>
						</details>
						<p class="ex-plan" data-station-plan-line>Calculating station plan…</p>
						<button class="btn btn-primary ex-stamp" type="button" data-deploy-stations disabled>
							<span>Deploy stations</span>
						</button>
						<div class="ex-board-foot">
							<div class="ex-foot-head">
								<h3>Deployed</h3>
								<button type="button" class="ex-text-btn" data-clear-stations>Clear</button>
							</div>
							<label class="ex-field">
								<span>Station</span>
								<select data-station-select aria-label="Deployed stations">
									<option value="">None yet</option>
								</select>
							</label>
							<button type="button" class="ex-text-btn" data-remove-station disabled>Remove selected</button>
						</div>
					</section>

					<section class="ex-board" aria-labelledby="board-ship" data-board="ship" data-locked="true">
						<h2 id="board-ship"><span class="ex-board-num" aria-hidden="true">2</span> Ship</h2>
						<p class="ex-board-lead">
							Deploy at least one station in Pool first. Ship stays locked until stations are ready.
						</p>
						<div class="ex-ship-gate" data-ship-gate>
							<p class="ex-empty-stamp" aria-hidden="true">1 → 2</p>
							<p>Deploy at least one station in Pool first.</p>
						</div>
						<div class="ex-ship-body" data-ship-body hidden>
							<label class="ex-field">
								<span>App</span>
								<select data-app-select aria-label="App to ship">
									<option value="">Select an app…</option>
								</select>
							</label>
							<details class="ex-policy-fold">
								<summary>App plan</summary>
								<dl class="ex-policy" data-example-policy></dl>
							</details>
							<p class="ex-plan" data-example-plan-line>Deploy stations first…</p>
							<button class="btn btn-primary ex-stamp" type="button" data-deploy-apps disabled>
								<span>Locked — deploy stations first</span>
							</button>
						</div>
					</section>

					<section class="ex-board ex-board-log" aria-labelledby="board-live" data-board="live">
						<h2 id="board-live"><span class="ex-board-num" aria-hidden="true">3</span> Live</h2>
						<p class="ex-board-lead">
							Pick a host, Preview on stage, Open in a new tab, then Claim.
						</p>
						<div class="ex-log-head">
							<span>Deploy reel</span>
							<span class="ex-mono" data-deploy-state>idle</span>
						</div>
						<div
							class="deploy-terminal"
							role="log"
							aria-live="polite"
							aria-label="Deploy output"
							data-terminal
						>
							<p class="system">
								Stamp stations, ship an app, then preview and claim a host here.
							</p>
						</div>
						<div class="ex-cast">
							<label class="ex-field">
								<span>Deployment</span>
								<select data-live-select aria-label="Live deployments">
									<option value="">None yet</option>
								</select>
							</label>
							<div class="ex-live-actions" data-live-actions>
								<button type="button" class="ex-text-btn" data-live-preview disabled>Preview</button>
								<button type="button" class="ex-text-btn" data-live-open disabled>Open</button>
								<button type="button" class="btn btn-primary live-claim" data-live-claim disabled>Claim</button>
							</div>
							<p class="ex-claimed" data-claimed-line hidden></p>
							<p class="ex-placement-line" data-placement>Ship an app to see placement.</p>
						</div>
					</section>
				</div>
			</div>
		</div>
	</section>

	<script>
		import { bootExamplesConsole } from "../../lib/examples/controller.ts";
		void bootExamplesConsole().catch((error: unknown) => {
			const message = error instanceof Error ? error.message : String(error);
			const terminal = document.querySelector<HTMLElement>("[data-terminal]");
			const state = document.querySelector<HTMLElement>("[data-deploy-state]");
			const plan = document.querySelector<HTMLElement>("[data-station-plan-line]");
			const yards = document.querySelector<HTMLSelectElement>("[data-yard-select]");
			if (state) state.textContent = "error";
			if (plan) plan.textContent = `Boot failed: ${message}`;
			if (yards && yards.options.length === 0) {
				const option = document.createElement("option");
				option.disabled = true;
				option.textContent = "Yards unavailable — see Live reel / reload";
				yards.replaceChildren(option);
			}
			if (terminal) {
				const line = document.createElement("p");
				line.className = "stderr";
				line.textContent = `Could not start Home Station: ${message}`;
				terminal.replaceChildren(line);
			}
		});
	</script>
</Base>

<style is:global>
	/* Film-strip storyboard console — Rubberhose Operate surface.
	   Seed 116fd7b0 / grounded candidate 3. Keep data-* hooks for controller. */

	.ex-hero {
		padding: clamp(2rem, 5vw, 3.25rem) 0 1.5rem;
		border-bottom: 3px solid var(--ink);
	}

	.ex-hero h1 {
		margin: 0 0 0.65rem;
		font-family: var(--font-display);
		font-size: clamp(2.5rem, 6vw, 3.75rem);
		line-height: 1.05;
		letter-spacing: 0.01em;
	}

	.ex-hero h1 em {
		font-style: normal;
		color: var(--spark);
	}

	.ex-hero p {
		max-width: 38rem;
		margin: 0;
		color: var(--text-mute);
		font-size: 1.05rem;
	}

	.ex-console {
		padding: 1.5rem 0 3.5rem;
	}

	.ex-layout {
		display: grid;
		gap: 1.25rem;
	}

	@media (min-width: 960px) {
		.ex-layout {
			grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.85fr);
			align-items: start;
		}
	}

	.ex-stage {
		position: relative;
		min-height: 28rem;
		padding: 1rem 1.1rem 1.25rem;
		border: 3.5px solid var(--ink);
		border-radius: var(--radius);
		background:
			radial-gradient(circle at 12% 18%, color-mix(in srgb, var(--spark) 12%, transparent), transparent 42%),
			var(--paper, var(--bg));
		box-shadow: 5px 5px 0 var(--ink);
	}

	.ex-stage[data-claimed="true"] {
		box-shadow: 5px 5px 0 var(--go);
	}

	.ex-stage-head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin-bottom: 0.85rem;
		padding-bottom: 0.65rem;
		border-bottom: 2.5px solid var(--ink);
	}

	.ex-stage-head h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.85rem;
		line-height: 1.1;
	}

	.ex-stage-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.55rem;
	}

	.ex-view-tabs {
		display: inline-flex;
		border: 2.5px solid var(--ink);
		border-radius: var(--control-radius);
		overflow: hidden;
		box-shadow: 2px 2px 0 var(--pop-soft);
	}

	.ex-view-tabs button {
		margin: 0;
		padding: 0.4rem 0.75rem;
		border: 0;
		background: var(--cream, var(--bg-inset));
		color: var(--ink);
		font: 700 0.75rem/1.2 var(--font-sans);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		cursor: pointer;
	}

	.ex-view-tabs button[aria-pressed="true"] {
		background: var(--ink);
		color: var(--paper, #fff);
	}

	.ex-stage-body {
		min-height: 18rem;
	}

	.ex-host-tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-bottom: 0.65rem;
	}

	.ex-host-tabs button {
		padding: 0.35rem 0.65rem;
		border: 2px solid var(--ink);
		border-radius: var(--control-radius);
		background: var(--cream, var(--bg-inset));
		font: 0.8rem/1.2 var(--font-sans);
		cursor: pointer;
	}

	.ex-host-tabs button[aria-pressed="true"] {
		background: var(--ink);
		color: var(--paper, #fff);
	}

	.ex-empty {
		display: grid;
		place-content: center;
		gap: 0.35rem;
		min-height: 16rem;
		padding: 1.5rem;
		text-align: center;
	}

	.ex-empty-stamp {
		margin: 0;
		font-family: var(--font-display);
		font-size: 2rem;
		color: var(--faint, var(--text-mute));
	}

	.ex-empty h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.65rem;
	}

	.ex-empty p {
		margin: 0;
		max-width: 22rem;
		color: var(--text-mute);
	}

	.ex-claimed-banner {
		margin: 0 0 0.65rem;
		padding: 0.55rem 0.75rem;
		border: 2.5px solid var(--go);
		border-radius: var(--control-radius);
		background: color-mix(in srgb, var(--go) 12%, var(--paper, #fff));
		font: 700 0.9rem/1.35 var(--font-sans);
	}

	.ex-junction {
		margin: 0.65rem 0 0;
		color: var(--text-mute);
		font: 0.8rem/1.4 var(--font-mono);
	}

	.ex-source-path {
		margin-bottom: 0.5rem;
		color: var(--text-mute);
		font: 0.8rem/1.4 var(--font-mono);
	}

	.source-view pre {
		margin: 0;
		max-height: min(55vh, 28rem);
		overflow: auto;
		padding: 0.85rem 1rem;
		border: 2.5px solid var(--ink);
		border-radius: var(--radius);
		background: var(--code-bg, #f7f7f5);
		box-shadow: 3px 3px 0 var(--pop-soft);
	}

	.source-view code {
		font: 0.82rem/1.5 var(--font-mono);
		white-space: pre;
	}

	iframe[data-host-frame] {
		width: 100%;
		min-height: 22rem;
		border: 2.5px solid var(--ink);
		border-radius: var(--radius);
		background: var(--paper, #fff);
		box-shadow: 3px 3px 0 var(--pop-soft);
	}

	.ex-strip {
		display: grid;
		gap: 1rem;
	}

	.ex-strip[data-phase="pool"] [data-board="ship"],
	.ex-strip[data-phase="pool"] [data-board="live"] {
		opacity: 0.55;
	}

	.ex-strip[data-phase="ship"] [data-board="live"] {
		opacity: 0.55;
	}

	.ex-board {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 1rem 1.05rem 1.1rem;
		border: 3px solid var(--ink);
		border-radius: var(--radius);
		background: var(--paper, var(--bg));
		box-shadow: 4px 4px 0 var(--ink);
	}

	.ex-board[data-locked="true"] {
		background: var(--cream, var(--bg-inset));
	}

	.ex-ship-gate {
		display: grid;
		gap: 0.35rem;
		place-items: center;
		padding: 1.25rem 0.75rem;
		text-align: center;
		border: 2.5px dashed var(--ink);
		border-radius: var(--radius);
		background: var(--cream, var(--bg-inset));
		font: 0.95rem/1.4 var(--font-sans);
	}

	.ex-ship-gate[hidden],
	.ex-ship-body[hidden] {
		display: none !important;
	}

	.ex-ship-body {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.ex-board h2 {
		display: flex;
		align-items: baseline;
		gap: 0.45rem;
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.55rem;
		line-height: 1.1;
	}

	.ex-board-num {
		display: inline-grid;
		place-items: center;
		width: 1.55rem;
		height: 1.55rem;
		border: 2.5px solid var(--ink);
		border-radius: 999px;
		background: var(--spark);
		color: #fff;
		font: 700 0.85rem/1 var(--font-sans);
	}

	.ex-board-lead {
		margin: 0;
		color: var(--text-mute);
		font-size: 0.92rem;
		line-height: 1.45;
	}

	.ex-field {
		display: grid;
		gap: 0.35rem;
		font-size: 0.875rem;
		font-weight: 700;
		color: var(--ink);
	}

	.ex-field select {
		width: 100%;
		min-height: 2.75rem;
		padding: 0.45rem 0.65rem;
		border: 2.5px solid var(--ink);
		border-radius: var(--control-radius);
		background: var(--cream, var(--bg-inset));
		color: var(--text);
		font: 0.95rem/1.4 var(--font-sans);
		box-shadow: 2px 2px 0 var(--pop-soft);
	}

	.ex-field select[multiple] {
		min-height: 9rem;
		padding: 0.35rem;
	}

	.ex-field select[multiple] option {
		padding: 0.35rem 0.45rem;
		border-radius: 0.25rem;
	}

	.ex-policy-fold {
		border: 2px solid var(--border-strong, #c9c8c2);
		border-radius: var(--control-radius);
		padding: 0.35rem 0.55rem;
		background: var(--bg-inset, #f4f4f2);
	}

	.ex-policy-fold summary {
		cursor: pointer;
		font: 700 0.8rem/1.3 var(--font-sans);
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.ex-policy {
		display: grid;
		grid-template-columns: minmax(6.5rem, auto) 1fr;
		gap: 0.25rem 0.65rem;
		margin: 0.55rem 0 0.25rem;
		font: 0.8rem/1.45 var(--font-mono);
	}

	.ex-policy dt {
		color: var(--text-mute);
	}

	.ex-policy dd {
		min-width: 0;
		margin: 0;
		overflow-wrap: anywhere;
		text-align: right;
	}

	.ex-plan {
		margin: 0;
		padding: 0.75rem 0.85rem;
		border: 2.5px dashed var(--ink);
		border-radius: var(--radius);
		background: var(--accent-soft, var(--spark-soft));
		font: 0.85rem/1.45 var(--font-mono);
	}

	.ex-stamp {
		width: 100%;
		min-height: 3.15rem;
		margin-top: auto;
		font-family: var(--font-display);
		font-size: 1.5rem;
		font-weight: 400;
		line-height: 1.3;
	}

	.ex-stamp:disabled {
		cursor: not-allowed;
		opacity: 0.5;
	}

	.ex-board-foot {
		display: grid;
		gap: 0.55rem;
		margin-top: 0.35rem;
		padding-top: 0.75rem;
		border-top: 2px solid var(--border, #e3e2de);
	}

	.ex-foot-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.ex-foot-head h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.15rem;
	}

	.ex-text-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.35rem 0.55rem;
		border: 2px solid var(--ink);
		border-radius: var(--control-radius);
		background: var(--paper, #fff);
		color: var(--ink);
		font: 700 0.75rem/1.2 var(--font-sans);
		letter-spacing: 0.04em;
		text-decoration: none;
		cursor: pointer;
		box-shadow: 1.5px 1.5px 0 var(--pop-soft);
	}

	.ex-text-btn:disabled {
		opacity: 0.45;
		cursor: not-allowed;
	}

	.ex-board-log .ex-log-head {
		display: flex;
		justify-content: space-between;
		gap: 0.5rem;
		font: 700 0.75rem/1.2 var(--font-sans);
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.deploy-terminal {
		max-height: 11rem;
		overflow: auto;
		padding: 0.65rem 0.75rem;
		border: 2.5px solid var(--ink);
		border-radius: var(--radius);
		background: var(--cream, var(--bg-inset));
		font: 0.78rem/1.45 var(--font-mono);
	}

	.deploy-terminal p {
		margin: 0 0 0.35rem;
	}

	.deploy-terminal .command {
		color: var(--ink);
		font-weight: 700;
	}

	.deploy-terminal .success {
		color: var(--go);
	}

	.deploy-terminal .stderr {
		color: var(--spark);
	}

	.deploy-terminal .skip {
		color: var(--text-mute);
	}

	.ex-cast {
		display: grid;
		gap: 0.55rem;
	}

	.ex-live-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.live-claim {
		min-height: 2.25rem;
		padding: 0.35rem 0.75rem;
		font-size: 0.9rem;
	}

	.ex-claimed,
	.ex-placement-line {
		margin: 0;
		color: var(--text-mute);
		font: 0.8rem/1.4 var(--font-mono);
	}

	.ex-mono {
		font-family: var(--font-mono);
		font-size: 0.85em;
	}

	@media (max-width: 720px) {
		.ex-stage {
			min-height: 22rem;
		}

		.source-view pre {
			max-height: 40vh;
		}
	}
</style>
