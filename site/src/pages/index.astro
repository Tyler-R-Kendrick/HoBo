---
import { Code } from "astro:components";
import Base from "../layouts/Base.astro";
import Cloud from "../components/Cloud.astro";
import Mascot from "../components/Mascot.astro";
import { href } from "../lib/url";

const bindleSnippet = `import { bindle } from "@hobo/bindles";

import { app as helloApi } from "./api";
import { app as helloWeb } from "./webapp";

// Pack once — provider-agnostic by construction.
export default bindle("hello-bindle", (b) => {
  const api = b.api(() => helloApi.fetch);
  const web = b.web(() => helloWeb.fetch).dependsOn(api);
  return { api, web };
});`;

const shikiThemes = { light: "github-light", dark: "github-dark" } as const;
---

<Base
	title="HoBo — every app deserves a home. Preferably a cheap one."
	description="HoBo describes your app once, finds it the cheapest home that passes your policies, and keeps it moving with continuous, zero-drama migrations — across any provider, any mix, or your own metal."
>
	<!-- ===================== Hero ===================== -->
	<section class="hero">
		<Cloud size={150} class="hero-cloud c1" />
		<Cloud size={110} class="hero-cloud c2" />
		<Cloud size={90} class="hero-cloud c3" />
		<div class="container">
			<div>
				<p class="hero-eyebrow">
					<span class="sticker">homeward bound</span>
					<span class="sticker meadow">rent goes down, not up</span>
				</p>
				<h1>
					Every app deserves a home.<br />
					<span class="gradient-text">Preferably a cheap one.</span>
				</h1>
				<p class="hero-sub">
					HoBo is the meta-cloud that treats hosting like a hobo treats a
					town: stay while it's good, <strong>move on when the rent goes
					up</strong>. Describe your app once, and continuous migrations keep
					it in the best-value home that passes your policies — on any
					provider, a mix of them, or your own metal.
				</p>
				<div class="hero-ctas">
					<a class="btn btn-primary" href={href("/guide/getting-started/")}
						>Pack your bindle</a
					>
					<a class="btn btn-ghost" href={href("/guide/concepts/")}
						>Learn the lingo</a
					>
				</div>
				<div class="hero-facts">
					<span class="pill"><b>1</b> app description</span>
					<span class="pill"><b>any</b> provider</span>
					<span class="pill"><b>$0</b> loyalty tax</span>
					<span class="pill"><b>0</b> forklift rewrites</span>
				</div>
			</div>
			<div class="terminal-wrap">
				<span class="roof-rider"><Mascot size={72} /></span>
				<div class="terminal">
				<div class="terminal-bar">
					<span class="dots"><i></i><i></i><i></i></span>
					<span class="title">src/bindle.ts</span>
				</div>
				<Code
					code={bindleSnippet}
					lang="ts"
					themes={shikiThemes}
					defaultColor={false}
				/>
				<div class="terminal-run">
					<div><span class="ps1">$</span> hobo up --camp prod</div>
					<div>
						<span class="ev">Planned</span>
						<span class="ev">Provisioning</span>
						<span class="ev">Provisioned</span>
						<span class="ev ok">Deployed ✓</span>
					</div>
					<div class="migrate">
						…three weeks later: cheaper camp found down the line
					</div>
					<div>
						<span class="ev">MigrationPlanned</span>
						<span class="ev">PolicyPassed</span>
						<span class="ev ok">Migrated ✓</span>
						<span class="save">−$212/mo</span>
					</div>
					<div class="dim">
						every move is an event — replayable, auditable, reversible
					</div>
				</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ===================== Route strip ===================== -->
	<div class="route" aria-label="Places an app can call home">
		<span class="stop">aws</span>
		<span class="stop">azure</span>
		<span class="stop here">fly.io <span class="fare">$9/mo — we're here</span></span>
		<span class="stop">gcp</span>
		<span class="stop">cloudflare</span>
		<span class="stop">that server in your garage</span>
	</div>

	<!-- ===================== Problem ===================== -->
	<section class="section">
		<div class="container">
			<div class="section-head">
				<span class="badge">Why HoBo exists</span>
				<h2>Two bad landlords, and the open road</h2>
				<p>
					Modern teams pick between a closed PaaS that owns them and raw IaC
					that consumes them. HoBo's founding grudge:
					<strong>your code shouldn't pay a loyalty tax to its landlord</strong>.
				</p>
			</div>
			<div class="grid grid-3" style="align-items: stretch;">
				<div class="card tradeoff">
					<h3>The company town</h3>
					<p>
						A closed PaaS is easy right up until the rent triples. One
						runtime, one bill, and the exits are decorative.
					</p>
				</div>
				<div class="card tradeoff">
					<h3>The fixer-upper</h3>
					<p>
						Raw cloud + IaC gives you full control — of a second job. Every
						app team slowly becomes a part-time platform team.
					</p>
				</div>
				<div class="card">
					<h3><span class="card-icon">→</span>The HoBo way</h3>
					<p>
						Travel light. Describe intent, not infrastructure, and let
						policy, price, and reliability goals pick the home. Need
						provider-native power? It's one typed
						<code class="term">.with(...)</code> away.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- ===================== Continuous migration ===================== -->
	<section class="section">
		<div class="container">
			<div class="section-head">
				<span class="badge badge-accent">The guiding principle</span>
				<h2>Deployment is not a destination. <span class="squiggle">It's a journey.</span></h2>
				<p>
					Other platforms deploy your app and call it a day. HoBo keeps
					watching the market: when a cheaper home passes your policy gates,
					it plans the move, rehearses it, and rides — with your blessing or
					on full auto.
				</p>
			</div>
			<div class="grid grid-3">
				<div class="card">
					<p class="step-num">01 · PACK</p>
					<h3>Author the Bindle</h3>
					<p>
						Everything your app owns, rolled into one provider-agnostic
						bundle: services, resources, wiring, and inline
						<code>.allow()</code> least privilege. If it's not in the
						bindle, it doesn't ship.
					</p>
				</div>
				<div class="card">
					<p class="step-num">02 · SETTLE</p>
					<h3>Pitch a Camp</h3>
					<p>
						A Camp is where the bindle lives right now: one provider, one
						durable runtime. Pitch one to pin placement — or write none and
						the Dispatcher infers the cheapest camp your policies allow.
					</p>
				</div>
				<div class="card">
					<p class="step-num">03 · RIDE</p>
					<h3>Continuous migration</h3>
					<p>
						Price drops, credits appear, a region gets flaky — HoBo replans
						placement continuously and moves the bindle when it's worth it.
						Same convergence loop as <code class="term">hobo up</code>, so a
						move is never a special event.
					</p>
					<div class="event-chips">
						<code>MigrationPlanned</code>
						<code>Gated</code>
						<code>Migrated</code>
					</div>
				</div>
			</div>
			<p class="section-foot">
				Every hop is an event in an append-only log — replay the journey,
				audit every fare, roll back any move.
				<a href={href("/guide/architecture/")}>How the moving works →</a>
			</p>
		</div>
	</section>

	<div class="rails" role="presentation">
		<span class="rider"><Mascot size={62} puffs /></span>
	</div>

	<!-- ===================== Primitives bento ===================== -->
	<section class="section" style="padding-top: 0;">
		<div class="container">
			<div class="section-head">
				<span class="badge">The vocabulary</span>
				<h2>Four words for traveling light</h2>
				<p>
					HoBo's primitives are named for the life: pack a bindle, pitch a
					camp, work a yard, meet at the junction. One you must write, one
					comes with the campsite, and two are for when your app goes places.
				</p>
			</div>
			<div class="grid grid-3 bento">
				<a class="card span-2" href={href("/primitives/bindles/")}>
					<h3><span class="term">Bindle</span> <span class="sticker">start here</span></h3>
					<p>
						The app, packed: services, resources, wiring, policies, and
						deployment intent — provider-agnostic by construction. The same
						bindle unpacks anywhere, which is exactly what makes it cheap to
						move.
					</p>
					<p class="card-cta">Pack your first bindle →</p>
				</a>
				<a class="card" href={href("/primitives/camps/")}>
					<h3><span class="term">Camp</span> <span class="sticker meadow">then here</span></h3>
					<p>
						Where the bindle lives right now: one provider target plus the
						durable runtime. Pitch one to pin placement — or skip it and
						HoBo infers a camp from the code you've configured.
					</p>
					<p class="card-cta">Pitch a camp (optional) →</p>
				</a>
				<a class="card" href={href("/primitives/yards/")}>
					<h3><span class="term">Yard</span> <span class="sticker sky">advanced</span></h3>
					<p>
						One provider's camps under one roof: cross-camp policy,
						identity, and reconciliation. Self-hostable — the Yard is
						itself a bindle.
					</p>
					<p class="card-cta">Run a yard →</p>
				</a>
				<a class="card" href={href("/primitives/junctions/")}>
					<h3><span class="term">Junction</span> <span class="sticker sky">advanced</span></h3>
					<p>
						Where yards meet: cross-cloud federation for hybrid and
						multi-cloud — peer yards, no shared mutable state.
					</p>
					<p class="card-cta">Wire a junction →</p>
				</a>
				<div class="card">
					<h3>Replayable event log</h3>
					<p>
						Every deploy, migration, and token grant is an appended event.
						Time travel isn't a feature, it's the data model.
					</p>
				</div>
				<div class="card span-2">
					<h3>WIT/WASM membrane</h3>
					<p>
						Ports are WIT interfaces; apps are wasm components (with an OCI
						fallback); providers are capability providers. That thin, typed
						membrane is what makes moving homes cheap — any Component-Model
						language rides the same rails.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- ===================== Agent-native ===================== -->
	<section class="section">
		<div class="container">
			<div class="section-head">
				<span class="badge">AI-native</span>
				<h2>Built for humans, and the agents that work for them</h2>
				<p>
					Every capability is reachable via SDK, CLI, <strong>and</strong> MCP.
					Agents aren't a chat box bolted on — they're principals with
					their own scoped, short-lived credentials.
				</p>
			</div>
			<div class="grid grid-2">
				<div class="grid" style="gap: 1rem;">
					<div class="card">
						<h3>Agents as principals</h3>
						<p>
							Agents self-provision exactly the credentials a task needs
							through a machine-readable capability standard — and every
							token issued is an auditable event like everything else.
						</p>
					</div>
					<div class="card">
						<h3>The Crew: a built-in operator workforce</h3>
						<p>
							SRE, endpoint-monitor, GitOps, and platform-engineer operator
							agents ship with the platform — HoBo ships the operators, not
							just the APIs they'd call.
						</p>
					</div>
					<div class="card">
						<h3>AI-generated providers, conformance-certified</h3>
						<p>
							Missing an adapter for your favorite discount host? The
							generation pipeline writes it; the port's contract suite
							certifies it. More homes on the map, cheaper moves for
							everyone.
						</p>
					</div>
				</div>
				<div class="card" style="display:flex; flex-direction:column; justify-content:center; gap: 0.75rem;">
					<h3>Reading this as an agent?</h3>
					<p>
						Welcome, fellow traveler. This whole site is written to be as
						useful to you as to the humans you work for: stable headings,
						copy-pasteable snippets, canonical CLI verbs.
					</p>
					<p>
						Start with the machine-readable briefing at
						<a href={href("/llms.txt")}><code>llms.txt</code></a>, then the
						<a href={href("/agents/")}>agent docs</a> for the MCP surface
						and how to earn credentials.
					</p>
					<p class="card-cta">
						<a href={href("/agents/")}>Read the agent docs →</a>
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- ===================== Landscape ===================== -->
	<section class="section">
		<div class="container">
			<div class="section-head">
				<span class="badge">The landscape</span>
				<h2>Other roofs over your head</h2>
				<p>
					Cloud-agnostic options are IaC-flavored, Kubernetes-bound, or not
					AI-native. AI-native options are single-runtime and locked in.
					Nobody else keeps looking for a cheaper home after move-in day.
				</p>
			</div>
			<div class="table-wrap">
				<table class="compare">
					<thead>
						<tr>
							<th>Product</th>
							<th>Category</th>
							<th>Cloud-agnostic</th>
							<th>Runtime model</th>
							<th>AI-native</th>
							<th>Self-host</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<th>Lakebed</th>
							<td>Agent-native PaaS</td>
							<td class="no">✗ own runtime</td>
							<td>sync RPC</td>
							<td>agent-readable contracts</td>
							<td class="no">✗</td>
						</tr>
						<tr>
							<th>Vercel + Workflow SDK</th>
							<td>PaaS + durable execution</td>
							<td class="no">partial</td>
							<td>durable workflows/steps</td>
							<td>DurableAgent</td>
							<td class="no">runtime only</td>
						</tr>
						<tr>
							<th>Nitric</th>
							<td>Infra-from-code framework</td>
							<td class="yes">✓</td>
							<td>functions/resources</td>
							<td class="no">✗</td>
							<td class="yes">✓</td>
						</tr>
						<tr>
							<th>SST (v3 "Ion")</th>
							<td>IfC framework (Pulumi/TF)</td>
							<td class="no">◐ AWS-centric</td>
							<td>serverless + containers</td>
							<td class="no">✗</td>
							<td class="yes">✓ OSS core</td>
						</tr>
						<tr>
							<th>Crossplane</th>
							<td>K8s control plane</td>
							<td class="yes">✓</td>
							<td>reconcilers (CRDs)</td>
							<td class="no">✗</td>
							<td class="yes">✓ (k8s)</td>
						</tr>
						<tr>
							<th>wasmCloud</th>
							<td>Wasm runtime (HoBo's default host)</td>
							<td class="yes">✓</td>
							<td>components + providers</td>
							<td class="no">✗</td>
							<td class="yes">✓</td>
						</tr>
						<tr class="hobo-row">
							<th>HoBo</th>
							<td>AI-native meta-cloud</td>
							<td class="yes">✓ ports &amp; adapters</td>
							<td>wasm components + actors + durable workflows + sagas</td>
							<td class="yes">agents as principals · generation pipeline · MCP</td>
							<td class="yes">✓ the Yard is a Bindle</td>
						</tr>
					</tbody>
				</table>
			</div>
			<p class="section-foot">
				And the HoBo-only column: <strong>continuous migration</strong> —
				placement is re-decided for as long as your app lives, not once at
				deploy time.
			</p>
		</div>
	</section>

	<!-- ===================== CTA ===================== -->
	<section class="cta-band">
		<div class="container">
			<div class="postcard">
				<div class="postcard-bo"><Mascot size={92} flip puffs /></div>
				<h2 class="cta-inner-title">Ready to hit the rails?</h2>
				<p style="margin: 0 auto 1.5rem; max-width: 36rem; color: var(--text-mute);">
					Pack a bindle — that's the only must — and let your app find its
					way home. Pitch a camp if you're picky about the spot. Yards and
					junctions can wait until it starts collecting passport stamps.
				</p>
				<div class="hero-ctas" style="justify-content: center; margin-bottom: 0;">
					<a class="btn btn-primary" href={href("/guide/getting-started/")}
						>Get started</a
					>
					<a class="btn btn-ghost" href={href("/primitives/bindles/")}
						>Meet the primitives</a
					>
				</div>
			</div>
		</div>
	</section>
</Base>

<style>
	.cta-inner-title {
		margin: 0 0 0.65rem;
		font-family: var(--font-display);
		font-size: clamp(1.5rem, 3vw, 2.1rem);
		letter-spacing: 0;
		font-weight: 800;
	}

	.postcard-bo {
		position: absolute;
		left: clamp(0.5rem, 3vw, 2.5rem);
		bottom: 0.35rem;
	}

	@media (max-width: 820px) {
		.postcard-bo {
			display: none;
		}
	}
</style>
