{
  "consumer": {
    "name": "AlertmanagerRoutingContractConsumer"
  },
  "provider": {
    "name": "AlertmanagerRoutingContractBoundary"
  },
  "interactions": [
    {
      "description": "Alertmanager Routing Contract boundary returns its recorded contract evidence",
      "request": {
        "method": "GET",
        "path": "/alertmanager-routing-contract/contract"
      },
      "response": {
        "status": 200,
        "body": {
          "ok": true,
          "schema": "hobo.draft.alertmanager_routing_contract/v1"
        }
      }
    }
  ],
  "metadata": {
    "pactSpecification": {
      "version": "3.0.0"
    }
  }
}
