{
  "consumer": { "name": "hobo-code-session-orchestration-proof" },
  "provider": { "name": "SessionControlPlane" },
  "interactions": [
    {
      "description": "detach preserves a running resident session",
      "request": { "method": "POST", "path": "/code/sessions/session-1/detach" },
      "response": {
        "status": 200,
        "body": { "session": { "lifecycleState": "SESSION_LIFECYCLE_STATE_RUNNING" }, "attachedClientIds": [] }
      }
    }
  ],
  "metadata": { "pactSpecification": { "version": "3.0.0" } }
}
