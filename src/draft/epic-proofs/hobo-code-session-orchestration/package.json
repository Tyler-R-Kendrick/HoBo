{
  "name": "@hobo/draft-hobo-code-session-orchestration",
  "private": true,
  "type": "module",
  "scripts": {
    "draft:prepare": "pnpm --filter @hobo/code build",
    "pretest": "pnpm run draft:prepare",
    "test": "vitest run --root .",
    "test:behavior": "node --import tsx ../../../../node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.yaml",
    "simulate": "node --import tsx simulation/run-simulation.ts"
  },
  "dependencies": {
    "@hobo/code": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^4.1.9"
  }
}
