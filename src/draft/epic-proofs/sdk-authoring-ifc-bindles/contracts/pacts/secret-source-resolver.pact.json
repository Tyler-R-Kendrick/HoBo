{
  "consumer": { "name": "SdkAuthoringReferenceApp" },
  "provider": { "name": "SecretSourceResolver" },
  "interactions": [
    {
      "description": "resolve config refs without returning plaintext values",
      "providerStates": [{ "name": "secret source refs are registered" }],
      "request": { "method": "POST", "path": "/config/resolve", "body": { "keys": ["DB", "STRIPE", "LOG_LEVEL"] } },
      "response": { "status": 200, "body": { "refsOnly": true, "plaintextSecrets": false, "devSourceProductionEligible": false } }
    }
  ],
  "metadata": { "pactSpecification": { "version": "3.0.0" } }
}
