{
  "consumer": { "name": "IdentityReferenceApp" },
  "provider": { "name": "SecretProviderPort" },
  "metadata": { "pactSpecification": { "version": "3.0.0" }, "epic": "identity-auth-secrets-cross-app-access-xaa" },
  "interactions": [
    {
      "description": "returns a redacted secret handle after scoped token authorization",
      "providerStates": [{ "name": "database-url secret exists as reference only" }],
      "request": {
        "method": "POST",
        "path": "/secrets/read",
        "headers": { "content-type": "application/json" },
        "body": { "secretRef": "secretref://tenant-a/orders/database-url", "tokenRef": "tokenref://provider/aws/secrets/read/database-url" }
      },
      "response": {
        "status": 200,
        "headers": { "content-type": "application/json" },
        "body": { "secretRef": "secretref://tenant-a/orders/database-url", "valueRef": "memory://redacted/orders/database-url" }
      }
    }
  ]
}
