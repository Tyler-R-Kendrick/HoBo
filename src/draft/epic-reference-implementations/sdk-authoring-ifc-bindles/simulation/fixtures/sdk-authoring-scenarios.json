{
  "personas": [
    "App developer",
    "Coding agent",
    "Platform engineer",
    "SDK author"
  ],
  "bddScenarios": [
    "Declare a portable Bindle and prove it before deploy",
    "Unsafe authoring choices are surfaced before deploy",
    "Hobo Code and non-TypeScript idiom layers lower to the same contract"
  ],
  "resources": [
    {
      "name": "sync-api",
      "kind": "api",
      "manifestType": "component.v1",
      "portRef": "wasi:http/incoming-handler@0.2.0",
      "usedVerbs": [
        "route:get",
        "route:post"
      ],
      "bind": [
        "profile-cache",
        "orders",
        "files",
        "asana",
        "auth"
      ]
    },
    {
      "name": "profile-cache",
      "kind": "kv",
      "manifestType": "kv.v1",
      "portRef": "wasi:keyvalue/store@0.2.0",
      "usedVerbs": [
        "get",
        "set"
      ]
    },
    {
      "name": "orders",
      "kind": "queue",
      "manifestType": "queue.v1",
      "portRef": "hobo:queue/queue@0.1.0",
      "usedVerbs": [
        "enqueue"
      ],
      "annotations": [
        "RAW_DRIVER_PORTABILITY_DEBT"
      ]
    },
    {
      "name": "files",
      "kind": "bucket",
      "manifestType": "bucket.v1",
      "portRef": "wasi:blobstore/blobstore@0.2.0",
      "usedVerbs": [
        "read",
        "write"
      ]
    },
    {
      "name": "asana",
      "kind": "connector",
      "manifestType": "connector.v1",
      "portRef": "hobo:xaa/client@0.1.0",
      "usedVerbs": [
        "tasks:write"
      ]
    },
    {
      "name": "auth",
      "kind": "auth",
      "manifestType": "auth.v1",
      "portRef": "hobo:auth/consumer@0.1.0",
      "usedVerbs": [
        "verify",
        "session"
      ]
    }
  ],
  "bindEdges": [
    {
      "from": "sync-api",
      "to": "profile-cache",
      "import": "ctx.bindings.profileCache"
    },
    {
      "from": "sync-api",
      "to": "orders",
      "import": "ctx.bindings.orders"
    },
    {
      "from": "sync-api",
      "to": "files",
      "import": "ctx.bindings.files"
    },
    {
      "from": "sync-api",
      "to": "asana",
      "import": "ctx.connectors.asana"
    },
    {
      "from": "sync-api",
      "to": "auth",
      "import": "ctx.user"
    }
  ],
  "handlers": [
    {
      "resource": "sync-api",
      "route": "POST /tickets",
      "export": "wasi:http/incoming-handler"
    },
    {
      "resource": "orders",
      "trigger": "queue.worker",
      "export": "hobo:runtime/workflow@0.1.0"
    }
  ],
  "xaaTargets": [
    {
      "name": "asana",
      "audience": "urn:asana:app",
      "operation": "tasks.create",
      "inferredScopes": [
        "tasks:write"
      ]
    }
  ],
  "configRefs": {
    "DB": {
      "source": "fromBinding",
      "target": "profile-cache"
    },
    "STRIPE": {
      "source": "secretRef",
      "ref": "stripe/api-key"
    },
    "LOG_LEVEL": {
      "source": "env",
      "defaultType": "string"
    }
  },
  "guardrailInputs": {
    "unobservedResource": "dead-letter-bucket",
    "narrowedBelowUsage": {
      "resource": "profile-cache",
      "required": [
        "get",
        "set"
      ],
      "granted": [
        "get"
      ]
    },
    "xaaScopeWidening": {
      "target": "asana",
      "requested": [
        "tasks:read",
        "tasks:write"
      ],
      "inferred": [
        "tasks:write"
      ]
    }
  },
  "topology": {
    "bindle": "support-sync",
    "camp": "local-dev",
    "yard": "developer-yard",
    "junction": "none"
  },
  "auth": {
    "providers": [
      "oidc",
      "customJwt",
      "builtin-dev"
    ]
  },
  "hoboCode": {
    "sourceName": "support-sync.hobo"
  },
  "generatedFiles": [
    ".hobo/generated/bindings.d.ts",
    ".hobo/generated/hooks.d.ts",
    ".hobo/generated/api-tree.d.ts",
    "src/_generated/workflows.d.ts",
    "src/_generated/mcp-parity.json"
  ],
  "nonTs": {
    "extractedSurfaceDigest": "sha256:extracted-hobo-sdk-001",
    "idiomTranslations": [
      "builder chains are idiom-only",
      "collection facts are ordered records",
      "errors map through WIT result semantics"
    ]
  }
}
