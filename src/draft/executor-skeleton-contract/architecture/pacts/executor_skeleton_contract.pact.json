{
  "consumer": {
    "name": "ExecutorSkeletonContractConsumer"
  },
  "provider": {
    "name": "ExecutorSkeletonContractBoundary"
  },
  "interactions": [
    {
      "description": "Executor Skeleton Contract boundary returns its recorded contract evidence",
      "request": {
        "method": "GET",
        "path": "/executor-skeleton-contract/contract"
      },
      "response": {
        "status": 200,
        "body": {
          "ok": true,
          "schema": "hobo.draft.executor_skeleton_contract/v1"
        }
      }
    }
  ],
  "metadata": {
    "pactSpecification": {
      "version": "3.0.0"
    }
  }
}
