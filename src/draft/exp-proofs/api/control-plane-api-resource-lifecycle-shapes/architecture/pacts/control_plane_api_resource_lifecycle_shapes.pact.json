          "operations": [
            {
              "id": "plan",
              "humanName": "Build a DeploymentPlan without mutation",
              "cliCommand": "hobo plan --camp preview --json",
              "apiEndpoint": "/control-plane/plan",
              "mcpTool": "hobo_plan",
              "requestShape": [
                "manifestRef",
                "campRef",
                "objective",
                "requestedBy",
                "proofMode"
              ],
              "responseShape": [
                "DeploymentPlan",
                "GatekeeperDecision",
                "PlanWarning[]",
                "status",
                "proofMode",
                "fixtureId",
                "correlationId",
                "redactionClass",
                "warnings",
                "refusal"
              ],
              "domainTerms": [
                "DeploymentPlan",
                "ResourcePlan",
                "Gatekeeper",
                "match.Decided"
              ],
              "sharedResultEnvelope": true,
              "fixtureId": "fixture.plan.preview.success"
            },
            {
              "id": "apply-up",
              "humanName": "Apply an accepted plan into a Deployment Set Delta",
              "cliCommand": "hobo up --camp preview --json",
              "apiEndpoint": "/control-plane/apply",
              "mcpTool": "hobo_up",
              "requestShape": [
                "deploymentPlanId",
                "approvalRef",
                "campRef",
                "expectedSetId",
                "dryRun"
