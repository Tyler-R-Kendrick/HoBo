                "ExternalResource[]",
                "migrationPreview",
                "status",
                "proofMode",
                "fixtureId",
                "correlationId",
                "redactionClass",
                "warnings",
                "refusal"
              ],
              "domainTerms": [
                "resource.Adopted",
                "authoritative-external",
                "echo driver",
                "migration.*"
              ],
              "sharedResultEnvelope": true,
              "fixtureId": "fixture.import.terraform.adopted"
            },
            {
