              "domainTerms": [
                "migration.Planned",
                "migration.PhaseApplied",
                "expand",
                "backfill",
                "contract"
              ],
              "sharedResultEnvelope": true,
              "fixtureId": "fixture.migrate.expand-backfill-contract"
