                "status",
                "proofMode",
                "fixtureId",
                "correlationId",
                "redactionClass",
                "warnings",
                "refusal"
              ],
              "domainTerms": [
                "Deployment Set",
                "Delta",
                "ResourceActor",
                "deployment.Planned"
              ],
              "sharedResultEnvelope": true,
              "fixtureId": "fixture.apply.preview.accepted"
            },
            {
              "id": "inspect-run",
              "humanName": "Read run, deploy, and topology projections",
              "cliCommand": "hobo inspect run --last --json",
              "apiEndpoint": "/control-plane/inspect/run",
              "mcpTool": "hobo_inspect_run",
              "requestShape": [
                "runId",
                "campRef",
                "projectionSeq",
                "freshnessBound",
                "redactionClass"
              ],
              "responseShape": [
                "RunProjection",
