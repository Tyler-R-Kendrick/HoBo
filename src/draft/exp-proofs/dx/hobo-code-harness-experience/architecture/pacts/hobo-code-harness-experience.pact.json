{
	"consumer": {
		"name": "@hobo/draft-hobo-code-harness-experience"
	},
	"provider": {
		"name": "@hobo/code"
	},
	"interactions": [
		{
			"description": "experience run returns clean isolation + template + visual + evidence",
			"request": {
				"method": "POST",
				"path": "/exp/hobo-code-harness/run"
			},
			"response": {
				"status": 200,
				"body": {
					"isolationClean": true,
					"templateOk": true,
					"visualOk": true,
					"evidenceOk": true,
					"orphans": []
				}
			}
		}
	],
	"metadata": {
		"pactSpecification": {
			"version": "3.0.0"
		}
	}
}
