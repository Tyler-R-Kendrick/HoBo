{
  "consumer": {
    "name": "HoboCoreContractConsumer"
  },
  "provider": {
    "name": "HoboCoreContractBoundary"
  },
  "interactions": [
    {
      "description": "Hobo Core Contract boundary returns its recorded contract evidence",
      "request": {
        "method": "GET",
        "path": "/hobo-core-contract/contract"
      },
      "response": {
        "status": 200,
        "body": {
          "ok": true,
          "schema": "hobo.draft.hobo_core_contract/v1"
        }
      }
    }
  ],
  "metadata": {
    "pactSpecification": {
      "version": "3.0.0"
    }
  }
}
