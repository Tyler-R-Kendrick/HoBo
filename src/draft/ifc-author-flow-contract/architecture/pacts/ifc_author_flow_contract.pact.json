      },
      "response": {
        "status": 200,
        "body": {
          "ok": true,
          "schema": "hobo.draft.ifc_author_flow_contract/v1"
        }
      }
    }
  ],
  "metadata": {
    "pactSpecification": {
      "version": "3.0.0"
    }
  }
}
