{
  "consumer": {
    "name": "IfcAuthorFlowContractConsumer"
  },
  "provider": {
    "name": "IfcAuthorFlowContractBoundary"
  },
  "interactions": [
    {
      "description": "Ifc Author Flow Contract boundary returns its recorded contract evidence",
      "request": {
