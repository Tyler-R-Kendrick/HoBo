{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hobo.dev/schema/policy-audit-events.v1.schema.json",
  "title": "HoBo Policy Audit Events",
  "type": "object",
  "required": [
    "id",
    "type",
    "schemaVersion",
    "orgId",
    "tenant",
    "streamId",
    "seq",
    "time",
    "actor",
    "correlationId",
    "causationId",
    "retention",
    "data"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "policy.Decided",
        "policy.ViolationDetected",
        "policy.WaiverRequested",
        "policy.WaiverApproved",
        "policy.ObligationCreated",
        "policy.ObligationSatisfied",
        "policy.ObligationEscalated"
      ]
    },
    "schemaVersion": {
      "const": "hobo.policy-audit-events/v1"
    },
    "orgId": {
      "type": "string",
      "minLength": 1
    },
    "tenant": {
      "type": "string",
      "minLength": 1
    },
    "streamId": {
      "type": "string",
      "minLength": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "object"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "causationId": {
      "type": "string",
      "minLength": 1
    },
    "retention": {
      "type": "object",
      "required": [
        "class",
        "neverCompact",
        "streamPolicy"
      ],
      "properties": {
        "class": {
          "const": "security-audit"
        },
        "neverCompact": {
          "const": true
        },
        "streamPolicy": {
          "const": "retain-org-policy-audit-stream"
        }
      }
    },
    "data": {
      "type": "object",
      "required": [
        "decisionId",
        "packVersion",
        "packDigest",
        "policyIds"
      ],
      "properties": {
        "decisionId": {
          "type": "string",
          "minLength": 1
        },
        "effect": {
          "type": "string",
          "enum": [
            "allow",
            "allow-degraded",
            "deny",
            "warn",
            "mutate",
            "require-approval"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "violationId": {
          "type": "string",
          "minLength": 1
        },
        "waiverId": {
          "type": "string",
          "minLength": 1
        },
        "approvedBy": {
          "type": "string",
          "minLength": 1
        },
        "obligationId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "packVersion": {
          "type": "string",
          "minLength": 1
        },
        "packDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "policyIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "required": [
        "prevHash",
        "contentHash"
      ],
      "properties": {
        "prevHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "policy.Decided"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "decisionId",
              "effect",
              "reason",
              "packVersion",
              "packDigest",
              "policyIds"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "policy.ViolationDetected"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "decisionId",
              "violationId",
              "reason",
              "packVersion",
              "packDigest",
              "policyIds"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "policy.WaiverRequested"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "decisionId",
              "waiverId",
              "reason",
              "packVersion",
              "packDigest",
              "policyIds"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "policy.WaiverApproved"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "decisionId",
              "waiverId",
              "approvedBy",
              "packVersion",
              "packDigest",
              "policyIds"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "policy.ObligationCreated"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "decisionId",
              "obligationId",
              "kind",
              "status",
              "packVersion",
              "packDigest",
              "policyIds"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "policy.ObligationSatisfied"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "decisionId",
              "obligationId",
              "kind",
              "status",
              "packVersion",
              "packDigest",
              "policyIds"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "policy.ObligationEscalated"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "decisionId",
              "obligationId",
              "kind",
              "status",
              "reason",
              "packVersion",
              "packDigest",
              "policyIds"
            ]
          }
        }
      }
    }
  ]
}
