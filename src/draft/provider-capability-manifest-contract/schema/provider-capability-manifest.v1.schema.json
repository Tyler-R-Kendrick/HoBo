{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hobo.dev/provider-capability-manifest.v1.schema.json",
  "title": "HoBo Provider Capability Manifest",
  "type": "object",
  "required": ["schema", "provider", "publishedAt", "regions", "capabilities", "auth", "cost"],
  "properties": {
    "schema": {
      "const": "hobo.capability-manifest/v1"
    },
    "provider": {
      "type": "object",
      "required": ["id", "kind", "package", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "package": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "publishedAt": { "type": "string", "minLength": 1 },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["port", "interface", "version", "stability", "features", "regions"],
        "properties": {
          "port": { "type": "string", "minLength": 1 },
          "interface": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "stability": {
            "enum": ["stable", "preview", "experimental", "deprecated"]
          },
          "features": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "regions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "auth": { "type": "object" },
    "cost": { "type": "object" }
  }
}
