{
  "consumer": {
    "name": "ResourceactorFsmContractConsumer"
  },
  "provider": {
    "name": "ResourceactorFsmContractBoundary"
  },
  "interactions": [
    {
      "description": "Resourceactor Fsm Contract boundary returns its recorded contract evidence",
      "request": {
        "method": "GET",
        "path": "/resourceactor-fsm-contract/contract"
      },
      "response": {
        "status": 200,
        "body": {
          "ok": true,
          "schema": "hobo.draft.resourceactor_fsm_contract/v1"
        }
      }
    }
  ],
  "metadata": {
    "pactSpecification": {
      "version": "3.0.0"
    }
  }
}
