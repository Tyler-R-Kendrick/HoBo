{
  "consumer": {
    "name": "SloAsCodeContractConsumer"
  },
  "provider": {
    "name": "SloAsCodeContractBoundary"
  },
  "interactions": [
    {
      "description": "Slo As Code Contract boundary returns its recorded contract evidence",
      "request": {
        "method": "GET",
        "path": "/slo-as-code-contract/contract"
      },
      "response": {
        "status": 200,
        "body": {
          "ok": true,
          "schema": "hobo.draft.slo_as_code_contract/v1"
        }
      }
    }
  ],
  "metadata": {
    "pactSpecification": {
      "version": "3.0.0"
    }
  }
}
