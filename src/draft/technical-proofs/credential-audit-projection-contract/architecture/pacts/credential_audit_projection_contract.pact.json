{
  "consumer": {
    "name": "CredentialAuditProjectionContractConsumer"
  },
  "provider": {
    "name": "CredentialAuditProjectionContractBoundary"
  },
  "interactions": [
    {
      "description": "Credential Audit Projection Contract boundary returns its recorded contract evidence",
      "request": {
        "method": "GET",
        "path": "/credential-audit-projection-contract/contract"
      },
      "response": {
        "status": 200,
        "body": {
          "ok": true,
          "schema": "hobo.draft.credential_audit_projection_contract/v1"
        }
      }
    },
    {
      "description": "Gateway query returns a grant timeline for security review",
      "request": {
        "method": "GET",
        "path": "/credential-audit",
        "query": {
          "grantId": "grant-cf-deploy"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "ok": true,
          "surface": "gateway",
          "grant": {
            "grantId": "grant-cf-deploy",
            "revoked": true
          }
        }
      }
    },
    {
      "description": "MCP inspect_credential_audit returns brokered deploy chains",
      "request": {
        "method": "POST",
        "path": "/mcp/tools/inspect_credential_audit",
        "body": {
          "runId": "run-hello-bindle"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "ok": true,
          "surface": "mcp",
          "tool": "inspect_credential_audit"
        }
      }
    }
  ],
  "metadata": {
    "pactSpecification": {
      "version": "3.0.0"
    }
  }
}
