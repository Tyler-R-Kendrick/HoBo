{
  "name": "@hobo-draft/componentize",
  "version": "0.1.0",
  "private": true,
  "type": "module",
	"description": "Draft POC for HOBO-584 / S0-07: deterministic TS service to wasm component and OCI artifact via jco + componentize-js.",
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest run test/",
		"test:contract:consumer": "node --import tsx --test contracts/consumer/*.test.ts",
		"test:contract:provider": "node --import tsx --test contracts/provider/*.test.ts"
	},
  "dependencies": {
    "@bytecodealliance/componentize-js": "0.21.0",
    "@bytecodealliance/jco": "1.24.3"
  },
  "devDependencies": {
    "@bytecodealliance/preview2-shim": "0.17.4",
    "vitest": "4.1.9"
  }
}
