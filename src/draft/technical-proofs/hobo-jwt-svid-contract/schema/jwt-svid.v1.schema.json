{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hobo.dev/schemas/identity/jwt-svid.v1.json",
  "title": "HoBo JWT-SVID v1 claim set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "iss",
    "sub",
    "aud",
    "exp",
    "nbf",
    "iat",
    "tenant",
    "parentPrincipal",
    "codeVersion",
    "scope"
  ],
  "properties": {
    "iss": {
      "type": "string",
      "format": "uri",
      "description": "Stable Yard Identity issuer URL."
    },
    "sub": {
      "type": "string",
      "pattern": "^spiffe://[^/]+/[^/]+/(agent/[^/]+|[^/]+/[^/]+)$"
    },
    "aud": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      ]
    },
    "exp": { "type": "integer", "minimum": 0 },
    "nbf": { "type": "integer", "minimum": 0 },
    "iat": { "type": "integer", "minimum": 0 },
    "tenant": { "$ref": "#/$defs/segment" },
    "parentPrincipal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "enum": ["user", "agent", "service", "workload"]
        },
        "id": { "$ref": "#/$defs/segment" },
        "delegatedBy": { "$ref": "#/$defs/segment" }
      }
    },
    "codeVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest"],
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        }
      }
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scopedGrant" }
    }
  },
  "$defs": {
    "segment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "scopedGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "resource", "verbs"],
      "properties": {
        "port": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][A-Za-z0-9:-]*/[A-Za-z0-9._-]+$"
        },
        "resource": { "$ref": "#/$defs/segment" },
        "verbs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "not": {
              "enum": ["*", "admin", "manage"]
            }
          }
        }
      }
    }
  }
}
