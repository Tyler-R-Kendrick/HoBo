{
  "consumer": {
    "name": "HoboManifestContractConsumer"
  },
  "provider": {
    "name": "HoboManifestContractBoundary"
  },
  "interactions": [
    {
      "description": "Hobo Manifest Contract boundary returns its recorded contract evidence",
      "request": {
        "method": "GET",
        "path": "/hobo-manifest-contract/contract"
      },
      "response": {
        "status": 200,
        "body": {
          "ok": true,
          "schema": "hobo.draft.hobo_manifest_contract/v1"
        }
      }
    }
  ],
  "metadata": {
    "pactSpecification": {
      "version": "3.0.0"
    }
  }
}
