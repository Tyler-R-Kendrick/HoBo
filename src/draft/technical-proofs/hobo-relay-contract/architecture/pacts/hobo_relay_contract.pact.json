{
  "consumer": {
    "name": "HoboRelayContractConsumer"
  },
  "provider": {
    "name": "HoboRelayContractBoundary"
  },
  "interactions": [
    {
      "description": "Hobo Relay Contract boundary returns its recorded contract evidence",
      "request": {
        "method": "GET",
        "path": "/hobo-relay-contract/contract"
      },
      "response": {
        "status": 200,
        "body": {
          "ok": true,
          "schema": "hobo.draft.hobo_relay_contract/v1"
        }
      }
    }
  ],
  "metadata": {
    "pactSpecification": {
      "version": "3.0.0"
    }
  }
}
