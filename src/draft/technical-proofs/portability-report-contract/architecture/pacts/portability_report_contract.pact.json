{
  "consumer": {
    "name": "PortabilityReportContractConsumer"
  },
  "provider": {
    "name": "PortabilityReportContractBoundary"
  },
  "interactions": [
    {
      "description": "Portability Report Contract boundary returns its recorded contract evidence",
      "request": {
        "method": "GET",
        "path": "/portability-report-contract/contract"
      },
      "response": {
        "status": 200,
        "body": {
          "ok": true,
          "schema": "hobo.draft.portability_report_contract/v1"
        }
      }
    }
  ],
  "metadata": {
    "pactSpecification": {
      "version": "3.0.0"
    }
  }
}
