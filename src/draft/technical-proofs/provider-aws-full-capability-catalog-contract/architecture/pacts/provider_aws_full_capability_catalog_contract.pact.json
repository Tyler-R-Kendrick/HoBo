{
  "consumer": {
    "name": "ProviderAwsFullCatalogContractConsumer"
  },
  "provider": {
    "name": "ProviderAwsFullCatalogContractBoundary"
  },
  "interactions": [
    {
      "description": "Provider Aws Full Catalog Contract boundary returns its recorded contract evidence",
      "request": {
        "method": "GET",
        "path": "/provider-aws-full-capability-catalog-contract/contract"
      },
      "response": {
        "status": 200,
        "body": {
          "ok": true,
          "schema": "hobo.draft.provider_aws_full_capability_catalog_contract/v1",
          "catalogPorts": [
            "web/service",
            "kv",
            "bucket",
            "queue",
            "topic",
            "sql",
            "secret"
          ]
        }
      }
    }
  ],
  "metadata": {
    "pactSpecification": {
      "version": "3.0.0"
    }
  }
}
