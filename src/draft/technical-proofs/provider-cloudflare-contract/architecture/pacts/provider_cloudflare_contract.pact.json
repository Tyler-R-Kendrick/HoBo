{
  "consumer": {
    "name": "ProviderCloudflareContractConsumer"
  },
  "provider": {
    "name": "ProviderCloudflareContractBoundary"
  },
  "interactions": [
    {
      "description": "Provider Cloudflare Contract boundary returns its recorded contract evidence",
      "request": {
        "method": "GET",
        "path": "/provider-cloudflare-contract/contract"
      },
      "response": {
        "status": 200,
        "body": {
          "ok": true,
          "schema": "hobo.draft.provider_cloudflare_contract/v1"
        }
      }
    }
  ],
  "metadata": {
    "pactSpecification": {
      "version": "3.0.0"
    }
  }
}
