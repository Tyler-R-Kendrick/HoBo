{
  "schema": "hobo.manifest/v1",
  "resources": {
    "db": {
      "type": "data.v1",
      "port": "hobo:data",
      "paradigm": "relational",
      "connectionString": "{db.connectionString}"
    },
    "api": {
      "type": "component.v1",
      "runtime": "wasm",
      "exports": [
        "wasi:http/incoming-handler"
      ],
      "links": [
        {
          "import": "hobo:data",
          "to": "db"
        }
      ],
      "env": {
        "ConnectionStrings__db": "{db.connectionString}"
      },
      "bindings": {
        "db": {
          "port": "hobo:data",
          "resource": "db",
          "clientType": "DataClient"
        }
      },
      "image": "oci://registry.example.com/hello-api@sha256:demo"
    },
    "worker": {
      "type": "component.v1",
      "runtime": "wasm",
      "exports": [
        "wasi:http/incoming-handler"
      ],
      "links": [
        {
          "import": "hobo:data",
          "to": "db"
        }
      ],
      "env": {
        "LOG_LEVEL": "debug",
        "ConnectionStrings__db": "{db.connectionString}"
      },
      "bindings": {
        "db": {
          "port": "hobo:data",
          "resource": "db",
          "clientType": "DataClient"
        }
      },
      "image": "ghcr.io/acme/hello-worker:1",
      "build": {
        "provider": "hobo:build",
        "source": "ghcr.io/acme/hello-worker:1",
        "defaultArtifact": "wasm-on-oci"
      },
      "endpoints": {
        "http": {
          "scheme": "http",
          "port": 8080,
          "targetPort": 8080,
          "external": false,
          "protocol": "tcp"
        }
      }
    }
  }
}
