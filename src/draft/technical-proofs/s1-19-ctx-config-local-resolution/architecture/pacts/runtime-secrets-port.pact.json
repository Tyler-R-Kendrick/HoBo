{
  "consumer": {
    "name": "@hobo/runtime"
  },
  "provider": {
    "name": "SecretsPort"
  },
  "interactions": [
    {
      "description": "runtime resolves secret-ref via SecretsPort.get",
      "request": {
        "method": "GET",
        "path": "/secrets/hello/api-key",
        "headers": {
          "X-Hobo-Camp": "local"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "redacted": "[secret:redacted]",
          "source": "dev",
          "camp": "local",
          "productionDeployable": false
        }
      }
    },
    {
      "description": "unresolvable secret-ref returns SecretUnavailableError",
      "request": {
        "method": "GET",
        "path": "/secrets/missing/ref"
      },
      "response": {
        "status": 404,
        "body": {
          "error": "SecretUnavailableError",
          "reason": "secret not found in dev ladder"
        }
      }
    }
  ],
  "metadata": {
    "pactSpecification": {
      "version": "3.0.0"
    }
  }
}
