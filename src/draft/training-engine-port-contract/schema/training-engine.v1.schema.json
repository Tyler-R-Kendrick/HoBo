{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hobo.dev/training-engine.v1.schema.json",
  "title": "HoBo training-engine port contract",
  "type": "object",
  "required": ["schema", "request", "candidate"],
  "properties": {
    "schema": { "const": "hobo.training-engine/v1" },
    "request": {
      "type": "object",
      "required": ["schema", "requestId", "generatedRegion", "trajectories", "rubric", "contract"],
      "properties": {
        "schema": { "const": "hobo.training.optimize-request/v1" },
        "requestId": { "type": "string", "minLength": 1 },
        "generatedRegion": { "$ref": "#/$defs/generatedRegion" },
        "trajectories": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/trajectory" }
        },
        "rubric": {
          "type": "object",
          "required": ["id", "objective"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "objective": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "contract": {
          "type": "object",
          "required": ["ref", "method", "allowedRegionId"],
          "properties": {
            "ref": { "type": "string", "minLength": 1 },
            "method": { "type": "string", "minLength": 1 },
            "allowedRegionId": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "candidate": { "$ref": "#/$defs/candidatePatch" }
  },
  "$defs": {
    "generatedRegion": {
      "type": "object",
      "required": ["regionId", "artifactRef", "startOffset", "endOffset", "owner"],
      "properties": {
        "regionId": { "type": "string", "minLength": 1 },
        "artifactRef": { "type": "string", "minLength": 1 },
        "startOffset": { "type": "integer", "minimum": 0 },
        "endOffset": { "type": "integer", "minimum": 1 },
        "owner": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "trajectory": {
      "type": "object",
      "required": ["schema", "id", "traceparent", "run", "subject", "spans", "payloads", "reward"],
      "properties": {
        "schema": { "const": "hobo.training.trajectory/v1" },
        "id": { "type": "string", "minLength": 1 },
        "traceparent": { "type": "string", "pattern": "^00-[a-f0-9]{32}-[a-f0-9]{16}-[a-f0-9]{2}$" },
        "run": {
          "type": "object",
          "required": ["id", "tenantId", "bindle", "agent"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "tenantId": { "type": "string", "minLength": 1 },
            "bindle": { "type": "string", "minLength": 1 },
            "agent": {
              "type": "object",
              "required": ["id", "principalRef"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "principalRef": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "subject": {
          "type": "object",
          "required": ["method", "contractRef", "generatedRegion"],
          "properties": {
            "method": { "type": "string", "minLength": 1 },
            "contractRef": { "type": "string", "minLength": 1 },
            "generatedRegion": { "$ref": "#/$defs/generatedRegion" }
          },
          "additionalProperties": false
        },
        "spans": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name", "attributes"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "parentId": { "type": ["string", "null"] },
              "name": { "type": "string", "minLength": 1 },
              "startTime": { "type": "string", "minLength": 1 },
              "endTime": { "type": "string", "minLength": 1 },
              "attributes": {
                "type": "object",
                "required": ["openinference.span.kind"],
                "properties": {
                  "openinference.span.kind": {
                    "enum": ["LLM", "CHAIN", "TOOL", "RETRIEVER", "RERANKER", "EMBEDDING", "AGENT", "GUARDRAIL", "EVALUATOR", "PROMPT"]
                  }
                },
                "additionalProperties": true
              },
              "inputs": { "type": "object" },
              "outputs": { "type": "object" }
            },
            "additionalProperties": false
          }
        },
        "payloads": { "type": "object" },
        "reward": {
          "type": "object",
          "required": ["source", "rubricRef", "score"],
          "properties": {
            "source": { "type": "string", "minLength": 1 },
            "rubricRef": { "type": "string", "minLength": 1 },
            "eventId": { "type": "string" },
            "score": { "type": "number", "minimum": 0, "maximum": 1 },
            "observedAt": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "candidatePatch": {
      "type": "object",
      "required": ["schema", "id", "engineId", "region", "edits", "provenance"],
      "properties": {
        "schema": { "const": "hobo.training.candidate-patch/v1" },
        "id": { "type": "string", "minLength": 1 },
        "engineId": { "type": "string", "minLength": 1 },
        "region": { "$ref": "#/$defs/generatedRegion" },
        "edits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["startOffset", "endOffset", "replacement"],
            "properties": {
              "startOffset": { "type": "integer", "minimum": 0 },
              "endOffset": { "type": "integer", "minimum": 0 },
              "replacement": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "provenance": {
          "type": "object",
          "required": ["trajectoryHashes", "rubricRef", "contractRef"],
          "properties": {
            "trajectoryHashes": {
              "type": "array",
              "items": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
            },
            "rubricRef": { "type": "string", "minLength": 1 },
            "contractRef": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
