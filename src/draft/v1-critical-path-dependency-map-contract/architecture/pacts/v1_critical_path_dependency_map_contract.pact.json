{
  "consumer": {
    "name": "V1ReleaseProgramConsumer"
  },
  "provider": {
    "name": "CriticalPathDependencyMapContractBoundary"
  },
  "interactions": [
    {
      "description": "Release program boundary returns accepted M0 critical path dependency map",
      "request": {
        "method": "GET",
        "path": "/v1-critical-path-dependencies/contract"
      },
      "response": {
        "status": 200,
        "body": {
          "ok": true,
          "schema": "hobo.draft.v1_critical_path_dependency_map_contract/v1",
          "launchGates": ["private-beta", "release-candidate", "ga"]
        }
      }
    }
  ],
  "metadata": {
    "pactSpecification": {
      "version": "3.0.0"
    }
  }
}
