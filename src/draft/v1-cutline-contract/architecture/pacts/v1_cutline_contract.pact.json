{
  "consumer": {
    "name": "V1CutlineContractConsumer"
  },
  "provider": {
    "name": "V1CutlineContractBoundary"
  },
  "interactions": [
    {
      "description": "V1 Cutline Contract boundary returns its recorded contract evidence",
      "request": {
        "method": "GET",
        "path": "/v1-cutline-contract/contract"
      },
      "response": {
        "status": 200,
        "body": {
          "ok": true,
          "schema": "hobo.draft.v1_cutline_contract/v1"
        }
      }
    },
    {
      "description": "V1 Cutline Contract boundary returns M1 dogfood alpha evidence",
      "request": {
        "method": "GET",
        "path": "/v1-cutline-contract/dogfood-alpha"
      },
      "response": {
        "status": 200,
        "body": {
          "ok": true,
          "schema": "hobo.draft.v1_cutline_contract.m1_dogfood_alpha/v1",
          "issue": "HOBO-454",
          "phase": "M1",
          "milestoneGate": "M1 Dogfood/alpha proof"
        }
      }
    }
  ],
  "metadata": {
    "pactSpecification": {
      "version": "3.0.0"
    }
  }
}
